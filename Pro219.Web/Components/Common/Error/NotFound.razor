@page "/not-found"
@layout PublicLayout

<div class="flex min-h-screen items-center justify-center bg-white">
    <div class="text-center">
    <div class="mb-6">
        <svg
        class="mx-auto h-28 w-28 text-blue-400"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
        xmlns="http://www.w3.org/2000/svg"
        >
        <path
            strokeLinecap="round"
            strokeLinejoin="round"
            strokeWidth={1.5}
            d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z"
        />
        </svg>
    </div>

    <div class="mb-4 text-8xl font-bold text-red-500">404</div>
    <h2 class="mb-4 text-2xl font-semibold text-gray-700">Page not found</h2>
    <p class="mb-8 text-gray-600">The page you are looking for does not exist.</p>

        @if(_isShowHomeButton)
        {
            <MudButton Href="@_navigationRouter"  Class="mt-2" Variant="Variant.Filled" Color="Color.Primary">Home</MudButton>
        }
    </div>
</div>

@code {
    private GetMeResponseDTO _currentUserInfo = null;
    string _token = string.Empty;
    bool _isShowHomeButton = false;
    string _navigationRouter = RouterConst.Admin.Home;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if(firstRender)
        {
            _token = await localStorage.GetItemAsStringAsync(Constant.TokenNameLocalStorage);
            var expired = await localStorage.GetItemAsStringAsync(Constant.TokenExpiredLocalStorage);

            if(!string.IsNullOrEmpty(_token))
            {
                if (!string.IsNullOrEmpty(expired))
                {
                    if (DateTime.TryParse(expired.Trim('"'), out DateTime expirationTime))
                    {
                        if (expirationTime <= DateTime.Now)
                        {
                            await ClearLocalStorageAndNavigate(RouterConst.User.Login);
                            return;
                        }
                    }
                }

                GetMeResponseDTO getMe = null;
                try
                {
                    getMe = await _authService.AccessCheck(_token.Trim('"'));
                }
                catch (Exception ex) when (ex is UnauthorizedAccessException || ex is HttpRequestException)
                {
                    await ClearLocalStorageAndNavigate(RouterConst.User.Login);
                    return;
                }
                catch (Exception)
                {
                    await ClearLocalStorageAndNavigate(RouterConst.User.Login);
                    return;
                }

                if (getMe != null && getMe.IsExpired)
                {
                    await ClearLocalStorageAndNavigate(RouterConst.User.Login);
                    return;
                }
                if (getMe != null && getMe.Role == Constant.Role.Customer)
                {
                    _navigationRouter = RouterConst.User.Home;
                } else
                {
                    _navigationRouter = RouterConst.Admin.Home;
                }
            }
            else
            {
                _navigationRouter = RouterConst.User.Home;
            }
            _isShowHomeButton = true;
            StateHasChanged();
        }
    }

    public async Task ClearLocalStorageAndNavigate(string route)
    {
        await localStorage.RemoveItemAsync(Constant.TokenNameLocalStorage);
        await localStorage.RemoveItemAsync(Constant.TokenExpiredLocalStorage);
        await localStorage.RemoveItemAsync(Constant.UserInfoLocalStorage);
        await localStorage.RemoveItemAsync(Constant.AuthCartIdLocalStorage);
        await _cartStateService.LoadCartDetailsAsync(forceReload: true);
        _currentUserInfo = null;
        navigation.NavigateTo(route);
    }
}