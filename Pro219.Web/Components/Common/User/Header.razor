<style>
    .customer-menu div div {
        padding: 0 !important;
    }

    .customer-menu button:hover {
        background-color: transparent !important;
    }
    
    .mud-menu-item:hover .mud-typography {
        color: black !important;
        padding: 0 8px !important;
    }

    .mud-menu-item:hover .mud-typography span {
        color: black !important;
        padding: 0 8px !important;
    }

    .mud-typography {
        color: #666666 !important;
        font-size: 14px !important;
        font-weight: 500 !important;
    }

    .mud-typography > span {
        color: #666666 !important;
        font-size: 14px !important;
        font-weight: 500 !important;
        padding: 0 8px;
    }
</style>

<header class="fixed left-0 right-0 top-0 z-50 hidden h-20 bg-white px-10 py-2.5 shadow-lg lg:flex">
    <nav class="flex h-full w-full items-center justify-center gap-4">
        <div class="max-w-32 flex-shrink-0">
             <a href="@RouterConst.User.Home">
                <img src="/Assets/Icons/logo.svg" alt="logo" />
             </a>
        </div>

        <div class="flex w-full items-center justify-start gap-2">
            <MudButton Class="!font-medium !text-[#666666] hover:!text-black" OnClick="@(() => navigation.NavigateTo(RouterConst.User.Home))">Trang Chủ</MudButton>
            <MudButton>
                <MudMenu Variant="Variant.Text"
                         Color="Color.Inherit" Label="DANH MỤC" Class="customer-menu !font-medium !text-[#666666] hover:!text-black" ListClass="customer-menu !min-w-[15rem] rounded-lg bg-white !p-2 !shadow-xl">
                    @if (_lstCategories.Any())
                    {
                        @RenderMenuItems(_lstCategories)
                    }
                    else
                    {
                        <MudMenuItem Disabled="true">Đang tải danh mục...</MudMenuItem>
                    }
                </MudMenu>
            </MudButton>
            <MudButton Class="!font-medium !text-[#666666] hover:!text-black" OnClick="@(() => navigation.NavigateTo($"{RouterConst.User.SearchAll}?page={Constant.Pagination.DefaultPage}"))">Tất Cả Sản Phẩm</MudButton>
            <MudButton Class="!font-medium !text-[#666666] hover:!text-black" OnClick="@(() => navigation.NavigateTo(RouterConst.User.SearchOrder))">Tra cứu đơn hàng</MudButton>
            @if (!string.IsNullOrEmpty(_token))
            {
                <MudButton Class="!font-medium !text-[#666666] hover:!text-black" OnClick="@(() => navigation.NavigateTo(RouterConst.User.CouponNow))">Mã giảm giá</MudButton>
            }
        </div>

        <div class="max-w-[calc((100%-5rem)/2)] flex w-full items-center justify-end gap-3">
            <div class="flex items-center">
                <input placeholder="Tìm kiếm sản phẩm" class="!h-10 !w-56 rounded-e-none rounded-l-lg border-y border-l border-gray-300 px-2 outline-0" @bind-value="_searchValue" @bind-value:event="oninput" @onkeydown="@(e => { if (e.Key == "Enter") HandleSearch(); })" />
                <MudIcon Icon="@Icons.Material.Filled.Search" Size="@Size.Large" Class="!h-10 cursor-pointer rounded-r-lg border-y border-r border-gray-300 pr-2" @onclick="HandleSearch" />
            </div>
                
            <div class="group relative">
                @if (UserInfo != null)
                {
                    <MudAvatar Size="@Size.Medium" Class="cursor-pointer !bg-black !text-white" @onclick="HandleShowMenuChild">@UserInfo.FullName.Split(' ', StringSplitOptions.RemoveEmptyEntries)[^1][0].ToString().ToUpper()</MudAvatar>

                    if(_isShowMenuChild)
                    {
                        <div class="absolute -right-[4.75rem] -top-[1.5rem] h-screen w-screen cursor-pointer bg-transparent" @onclick="HandleShowMenuChild"></div>
                        <ul class="absolute right-0 top-[120%] border border-slate-200 bg-white p-2 shadow-lg">
                            <li>
                                <a href="@RouterConst.User.Profile" @onclick="@(() => handleRedirect())" class="block w-full whitespace-nowrap px-1.5 py-2 text-sm font-medium text-[#666666] hover:text-black">Thông tin tài khoản</a>
                            </li>
                            <li>
                                <a href="@RouterConst.User.Orders" @onclick="@(() => handleRedirect())" class="block w-full whitespace-nowrap px-1.5 py-2 text-sm font-medium text-[#666666] hover:text-black">Đơn hàng</a>
                            </li>
                            <li>
                                <a href="#" @onclick="@(() => handleRedirect())" class="block w-full whitespace-nowrap px-1.5 py-2 text-sm font-medium text-[#666666] hover:text-black">Yêu Thích</a>
                            </li>
                            <MudDivider />
                            <li>
                                <button @onclick="Logout" class="flex justify-start whitespace-nowrap px-1.5 py-2 text-sm font-medium text-[#666666] hover:text-black">Đăng Xuất</button>
                            </li>
                        </ul>
                    }
                } else
                {
                    <a href="@RouterConst.User.Login">
                        <MudIcon Icon="@Icons.Material.Filled.Person" Size="@Size.Medium" />
                    </a>
                }
            </div>

            <MudBadge Content="@_cartStateService.CartDetails.TotalItemCount" Color="Color.Error" Overlap="true" Bordered="true">
                <MudIcon @onclick="OnOpenCart" Icon="@Icons.Material.Filled.ShoppingCart" Class="cursor-pointer" />
        </MudBadge>
        </div>
    </nav>
</header>

<header class="fixed left-0 right-0 top-0 z-50 flex h-16 w-full items-center justify-between bg-white px-4 py-2 shadow-lg lg:hidden">
    
    <div class="flex items-center gap-2">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@ToggleDrawer" />
    </div>

    <div class="h-10 w-10 flex-shrink-0">
        <a href="@RouterConst.User.Home">
            <img src="/Assets/Icons/logo-mb.svg" alt="logo" class="h-full w-full object-contain" />
        </a>
    </div>

    <div class="flex items-center justify-end gap-3">
        <div class="group relative">
            @if (UserInfo != null)
            {
                <MudAvatar Size="@Size.Small" Class="cursor-pointer !bg-black !text-white" @onclick="HandleShowMenuChild">@UserInfo.FullName.Split(' ', StringSplitOptions.RemoveEmptyEntries)[^1][0].ToString().ToUpper()</MudAvatar>
            }
            else
            {
                <a href="@RouterConst.User.Login">
                    <MudIcon Icon="@Icons.Material.Filled.Person" Size="@Size.Medium" />
                </a>
            }
        </div>

        <MudBadge Content="@_cartStateService.CartDetails.TotalItemCount" Color="Color.Error" Overlap="true" Bordered="true">
            <MudIcon @onclick="OnOpenCart" Icon="@Icons.Material.Filled.ShoppingCart" Class="cursor-pointer" />
        </MudBadge>
    </div>
</header>

<MudDrawer @bind-Open="@_drawerOpen" Elevation="10" Variant="DrawerVariant.Temporary" Anchor="Anchor.Left" Width="375px">
    <MudDrawerHeader Class="!items-center !justify-between">
        <h1 class="text-lg">Menu</h1>
        <MudIconButton Icon="@Icons.Material.Filled.Close" Color="Color.Inherit" Edge="Edge.End" OnClick="@ToggleDrawer" />
    </MudDrawerHeader>
    <MudNavMenu>
        @* Mục Tìm kiếm (Đặt ở trên cùng) *@
        <div class="p-4">
            <MudTextField @bind-Value="_searchValue" Placeholder="Tìm kiếm sản phẩm" OnAdornmentClick="HandleSearch" OnKeyDown="@(e => { if (e.Key == "Enter") HandleSearch(); })" Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Search" Immediate="true" />
        </div>

        <MudDivider />

        <MudNavLink Href="#" OnClick="@(() => _isCategoryMenuOpen = !_isCategoryMenuOpen)" Match="NavLinkMatch.All">
            <div class="flex w-full items-center justify-between">
                <MudText Typo="Typo.subtitle1">DANH MỤC</MudText>
            </div>
        </MudNavLink>

        <div class="max-h-[calc(100lvh-177px)] w-full overflow-y-auto">
            <MudCollapse Expanded="@_isCategoryMenuOpen">
                <MudList T="string" Class="ml-4">
                    @if (_lstCategories.Any())
                    {
                        @RenderDrawerItems(_lstCategories)
                    }
                    else
                    {
                        <MudListItem Disabled="true">Đang tải danh mục...</MudListItem>
                    }
                </MudList>
            </MudCollapse>
        </div>

        <MudNavLink Href=@($"{RouterConst.User.SearchAll}?page={Constant.Pagination.DefaultPage}") Class="mt-2" Match="NavLinkMatch.All">
            <div class="flex w-full items-center justify-between">
                <MudText Typo="Typo.subtitle1" Class="!uppercase">Tất cả sản phẩm</MudText>
            </div>
        </MudNavLink>

        <MudNavLink Href="#" Class="mt-2" Match="NavLinkMatch.All">
            <div class="flex w-full items-center justify-between">
                <MudText Typo="Typo.subtitle1" Class="!uppercase">Tra cứu đơn hàng</MudText>
            </div>
        </MudNavLink>

        <MudNavLink Href="@RouterConst.User.CouponNow" Class="mt-2" Match="NavLinkMatch.All">
            <div class="flex w-full items-center justify-between">
                <MudText Typo="Typo.subtitle1" Class="!uppercase">Mã giảm giá</MudText>
            </div>
        </MudNavLink>
    </MudNavMenu>
</MudDrawer>

@code {
    [CascadingParameter(Name = Constant.CascadingNameParams.UserInfo)]
    public GetMeResponseDTO UserInfo { get; set; }

    [Parameter]
    public EventCallback OnLoggedOut { get; set; }

    [Parameter]
    public EventCallback OnOpenCart { get; set; }

    [Parameter]
    public bool FirstLogin { get; set; }

    List<CategoryDTO> _lstCategories = new List<CategoryDTO>();

    private string _searchValue = "";
    private int _countCart = 99;
    private string _token = string.Empty;
    private bool _isShowMenuChild = false;
    private bool _drawerOpen = false; // Trạng thái mở/đóng Drawer
    private bool _isCategoryMenuOpen = true; // Trạng thái mở/đóng menu Danh mục trong Drawer

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if(firstRender)
        {
            _token = await localStorage.GetItemAsStringAsync(Constant.TokenNameLocalStorage);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var allCategories = await _categoryService.GetAllParentAndChild();

        if (allCategories.Data != null)
        {
            _lstCategories = allCategories.Data;
        } 

        await _cartStateService.LoadCartDetailsAsync();

        _cartStateService.OnCountChange += StateHasChanged;
    }

    public void Dispose()
    {
        _cartStateService.OnCountChange -= StateHasChanged;
    }

    private void HandleShowMenuChild()
    {
        if (FirstLogin) return;

        _isShowMenuChild = !_isShowMenuChild;
        StateHasChanged();
    }

    // ... (Các biến khác) ...

    private void ToggleDrawer()
    {
        _drawerOpen = !_drawerOpen;
        StateHasChanged();
    }

    private void NavigateAndCloseDrawer(int categoryId)
    {
        _drawerOpen = false;
        navigation.NavigateTo($"{RouterConst.User.SearchByCategoryId.Replace(":categoryId", categoryId.ToString())}?page={Constant.Pagination.DefaultPage}");
    }

    private void HandleSearch()
    {
        var term = _searchValue.Trim();

        if (string.IsNullOrEmpty(term))
        {
            return;
        }

        _drawerOpen = false;
        var queryParams = new Dictionary<string, string?>
    {
        { "k", term }, 
        { "page", Constant.Pagination.DefaultPage.ToString() }
    };

        string basePath = RouterConst.User.SearchByKeyword;

        string newUrl = QueryHelpers.AddQueryString(basePath, queryParams!);

        navigation.NavigateTo(newUrl, forceLoad: false);
    }

    async Task Logout()
    {
        _isShowMenuChild = false;

        await OnLoggedOut.InvokeAsync();
    }

    public void handleRedirect(string? path = null)
    {
        if(!string.IsNullOrEmpty(path))
        {
            navigation.NavigateTo(path);
        }
        _isShowMenuChild = false;
    }

    public RenderFragment<List<CategoryDTO>> RenderMenuItems => categories => (__builder) =>
    {
        foreach (var category in categories)
        {
            if (category.SubCategory?.Any() == true)
            {
                <MudMenu AnchorOrigin="Origin.TopRight" TransformOrigin="Origin.TopLeft" ListClass="customer-menu !min-w-[15rem] !rounded-lg !bg-white !p-2 !shadow-xl">

                    <ActivatorContent>
                        <MudMenuItem Disabled="true" OnClick="@(() => NavigateAndCloseDrawer(category.Id))">
                            <span>@category.Name</span>
                            <MudIcon Icon="@Icons.Material.Filled.KeyboardArrowRight" Class="ml-auto" />
                        </MudMenuItem>
                    </ActivatorContent>

                    <ChildContent>
                        @RenderMenuItems(category.SubCategory)
                    </ChildContent>
                </MudMenu>
            }
            else
            {
                <MudMenuItem OnClick="@(() => NavigateAndCloseDrawer(category.Id))">
                    @category.Name
                </MudMenuItem>
            }
        }
    };

    private Dictionary<int, bool> _categoryExpansionState = new Dictionary<int, bool>();

    private void ToggleCategoryExpansion(int categoryId)
    {
        if (_categoryExpansionState.ContainsKey(categoryId))
        {
            _categoryExpansionState[categoryId] = !_categoryExpansionState[categoryId];
        }
        else
        {
            _categoryExpansionState[categoryId] = true;
        }
        
        StateHasChanged();
    }
    
    private bool IsCategoryExpanded(int categoryId)
    {
        return _categoryExpansionState.GetValueOrDefault(categoryId, false);
    }

    public RenderFragment<List<CategoryDTO>> RenderDrawerItems => categories => (__builder) =>
    {
        foreach (var category in categories)
        {
            if (category.SubCategory?.Any() == true)
            {
                var isExpanded = IsCategoryExpanded(category.Id);

                <MudListItem T="string" OnClick="@(() => ToggleCategoryExpansion(category.Id))">
                    <div class="flex w-full items-center justify-between">
                        <MudText Typo="Typo.subtitle2" Class="!font-semibold">@category.Name</MudText>
                        <MudIcon Icon="@(isExpanded ? Icons.Material.Filled.KeyboardArrowUp : Icons.Material.Filled.KeyboardArrowDown)" Size="Size.Small" />
                    </div>
                </MudListItem>

                <MudListItem T="string" OnClick="@(() => NavigateAndCloseDrawer(category.Id))" Class="ml-4 !pt-0 !pb-0 !mt-[-4px]">
                    <MudText Typo="Typo.body2" Class="!text-sm italic text-blue-600 hover:text-black">Xem tất cả @category.Name</MudText>
                </MudListItem>
            
                <MudCollapse Expanded="@isExpanded">
                    <MudList T="string" Class="ml-4">
                        @RenderDrawerItems(category.SubCategory)
                    </MudList>
                </MudCollapse>
            }
            else
            {
                <MudListItem T="string" OnClick="() => NavigateAndCloseDrawer(category.Id)">
                    <MudText Typo="Typo.body2">@category.Name</MudText>
                </MudListItem>
            }
        }
    };
}