<MudDrawer @bind-Open="@_drawerService.IsOpen" Width="350px" Class="px-2" Height="100lvh" Anchor="Anchor.End" Elevation="1" Variant="@DrawerVariant.Temporary">
    <MudDrawerHeader Class="!items-center !justify-between">
        <h1 class="text-lg">Giỏ hàng</h1>
        <MudIconButton Icon="@Icons.Material.Filled.Close" Color="Color.Inherit" Edge="Edge.End" OnClick="@_drawerService.CloseDrawer" />
    </MudDrawerHeader>
    
    <div>
        <MudDivider Class="!my-4" />

        @if (_cartStateService.CartDetails.CartItems.Any())
        {
            <div class="max-h-[calc(100lvh-15.9375rem)] flex flex-col gap-2 overflow-y-auto">
                @foreach (var item in _cartStateService.CartDetails.CartItems)
                {
                        <div class="flex items-center gap-2">
                            <div class="h-full w-full max-w-[6.25rem] flex-shrink-0">
                                <a>
                                    <img src="@item.ImageUrl" alt="product" />
                                </a>
                            </div>

                            <div class="flex flex-col">
                                <p class="whitespace-pre-wrap text-sm">@item.productName - @item.ColorName - @item.SizeName</p>
                                <span class="whitespace-pre-wrap text-sm font-medium">@item.UnitPrice?.ToString("C0", vietnameseCulture) x @item.Quantity</span>
                                <button class="w-fit p-2 text-xs text-slate-500 hover:text-red-500" @onclick="@(() => Delete(item.Id, item.VariantId))">Xóa</button>
                            </div>
                        </div>
                }
            </div>
        } else
        {
            <div class="p-4 text-center text-gray-500">Giỏ hàng trống.</div>
        }
        <MudDivider Class="!my-4 border-2 !border-black" />
        <div class="flex justify-between gap-2">
            <span class="flex-shrink-0 text-sm font-bold uppercase">Tổng tiền tạm tính:</span>
            <span class="whitespace-pre-wrap text-sm font-medium">@(_cartStateService.CartDetails.TemporaryTotal.ToString("C0", vietnameseCulture))</span>
        </div>

        <button class="my-4 w-full bg-black py-3 text-base text-white shadow" disabled="@(_cartStateService.CartDetails.TotalItemCount == 0)" @onclick="@(() => HandleRedirect(false))">Tiến Hành Đặt Hàng</button>

        <button @onclick="@(() => HandleRedirect(true))" class="mx-auto flex w-fit items-center text-sm">Xem Chi tiết Giỏ Hàng <MudIcon Class="ml-2" Icon="@Icons.Material.Filled.ArrowForward" Size="Size.Medium" /></button>
    </div>
</MudDrawer>


@code {
    private string _token = "";
    CultureInfo vietnameseCulture = new CultureInfo("vi-VN");

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        _token = await localStorage.GetItemAsStringAsync(Constant.TokenNameLocalStorage);
    }

    protected override void OnInitialized()
    {
        _drawerService.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        _drawerService.OnChange -= StateHasChanged;
    }

    void HandleRedirect(bool isToCart)
    {
        _drawerService.CloseDrawer();
        if (isToCart)
        {
            navigation.NavigateTo(RouterConst.User.CartDetail);
        } else
        {
            if (string.IsNullOrEmpty(_token))
            {
                navigation.NavigateTo(RouterConst.User.GusestCheckoutDetail);
            }
            else
            {
                navigation.NavigateTo(RouterConst.User.CheckoutDetail);
            }
        }
    }

    private async Task Delete(int id, int variantId)
    {
        if (string.IsNullOrEmpty(_token))
        {
            var cartItemLocal = await localStorage.GetItemAsStringAsync(Constant.CartItemKey);

            if (string.IsNullOrEmpty(cartItemLocal)) return;

            var deserializedData = JsonSerializer.Deserialize<List<AddCartModel>>(cartItemLocal);

            if (deserializedData == null || deserializedData.Count() == 0) return;

            var obj = deserializedData.FirstOrDefault(x => x.VariantId == variantId);
            if (obj != null)
            {
                await localStorage.RemoveItemAsync(Constant.CartItemKey);
                deserializedData.Remove(obj);
                if (deserializedData.Count() > 0)
                {   
                    await localStorage.SetItemAsStringAsync(Constant.CartItemKey, JsonSerializer.Serialize(deserializedData));
                }

                _snackbar.Add("Xóa thành công", Severity.Success);
                await _cartStateService.LoadCartDetailsAsync();
                StateHasChanged();
            }
        } else
        {
            var result = await _cartItemService.Delete(id, _token);

            if (result)
            {
                _snackbar.Add("Xóa thành công", Severity.Success);
                await _cartStateService.LoadCartDetailsAsync();
                StateHasChanged();
            } else
            {
                _snackbar.Add("Đã có lỗi xảy ra", Severity.Error);
            }
        }
    }
}
