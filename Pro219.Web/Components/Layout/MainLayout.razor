@inherits LayoutComponentBase
@using Pro219.Web.Components.Common.User

@* Required *@
<MudThemeProvider />
<MudPopoverProvider />

@* Needed for dialogs *@
<MudDialogProvider />

@* Needed for snackbars *@
<MudSnackbarProvider />

<PageTitle>@Constant.PageTitleUser.Replace("-", "")</PageTitle>

@if (_isLoading)
{
    <LoadingUser />
} else
{   
    <CascadingValue Value="_currentUserInfo" Name="@Constant.CascadingNameParams.UserInfo">
        <MudLayout Class="md:px-0 lg:px-0 lg:pt-20 sm:pt-16 md:pt-16">
            <Header OnLoggedOut="HandleLogout" OnOpenCart="HandleOpenCart" FirstLogin="_firstLogin" />

            <main class="lg:min-h-[calc(100lvh-26.625rem)] sm:px-3">
                @Body
            </main>

            <Footer />

            <CartDrawer />
        </MudLayout>
    </CascadingValue>

    <MudScrollToTop Class="!right-[-3rem] !bottom-16 !rotate-90 !bg-transparent !shadow-none">
        <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.ArrowBack" Class="!bg-transparent !shadow-none">Về đầu trang</MudButton>
    </MudScrollToTop>

    <div id="blazor-error-ui">
        An unhandled error has occurred.
        <a href="" class="reload">Reload</a>
        <a class="dismiss">🗙</a>
    </div>
}

@code {
    private GetMeResponseDTO _currentUserInfo = null;
    private bool _isLoading = true;
    private bool _firstLogin = false;

    private async Task PerformAuthCheckAndNavigate(bool isInitialLoad)
    {
        var token = await localStorage.GetItemAsStringAsync(Constant.TokenNameLocalStorage);
        var expired = await localStorage.GetItemAsStringAsync(Constant.TokenExpiredLocalStorage);
        var expiredCartTempUser = await localStorage.GetItemAsStringAsync(Constant.ExpiredCartTempUser);
        var FirstLogin = await localStorage.GetItemAsStringAsync(Constant.UserFirstLoginLocalStorage);
        var cartItemGuest = await localStorage.GetItemAsStringAsync(Constant.CartItemKey);

        if (!string.IsNullOrEmpty(FirstLogin))
        {
            _firstLogin = bool.Parse(FirstLogin);
            if (_firstLogin == true && !navigation.ToBaseRelativePath(navigation.Uri).Equals(RouterConst.User.ChangePassword.Replace("/", "")))
            {
                navigation.NavigateTo(RouterConst.User.ChangePassword, true);
                _isLoading = false;
                return;
            }
        }

        if (!string.IsNullOrEmpty(token))
        {
            if (!string.IsNullOrEmpty(expired))
            {
                if (DateTime.TryParse(expired.Trim('"'), out DateTime expirationTime))
                {
                    if (expirationTime <= DateTime.Now)
                    {
                        await ClearLocalStorageAndNavigate(RouterConst.User.Login);
                        return;
                    }
                }
            }

            GetMeResponseDTO getMe = null;
            try
            {
                getMe = await _authService.AccessCheck(token.Trim('"'));
            }
            catch (Exception ex) when (ex is UnauthorizedAccessException || ex is HttpRequestException)
            {
                await ClearLocalStorageAndNavigate(RouterConst.User.Login);
                return;
            }
            catch (Exception)
            {
                await ClearLocalStorageAndNavigate(RouterConst.User.Login);
                return;
            }

            if (getMe != null && getMe.IsExpired)
            {
                await ClearLocalStorageAndNavigate(RouterConst.User.Login);
                return;
            }

            if (getMe != null && getMe.Role != Constant.Role.Customer)
            {
                navigation.NavigateTo(RouterConst.AccessDenied, true);
                _isLoading = false;
                return;
            }

            if (getMe != null)
            {
                var currentUrl = "/" + navigation.ToBaseRelativePath(navigation.Uri);
                var forbiddenPages = new[] { RouterConst.User.Login, RouterConst.User.SignUp, RouterConst.User.ForgotPassword };

                if (forbiddenPages.Contains(currentUrl))
                {
                    navigation.NavigateTo(RouterConst.User.Home, true);
                    _isLoading = false;
                    return;
                }

                var userCart = await _cartService.GetByCustomerId(getMe.Id);

                if (userCart.IsSuccess && userCart.Data != null)
                {

                    await localStorage.SetItemAsStringAsync(Constant.AuthCartIdLocalStorage, userCart.Data.Id.ToString());
                }

                var userInfoJson = JsonSerializer.Serialize(getMe);
                await localStorage.SetItemAsStringAsync(Constant.UserInfoLocalStorage, userInfoJson);
                _currentUserInfo = getMe;

                if(!string.IsNullOrEmpty(cartItemGuest))
                {
                    var deserializedData = JsonSerializer.Deserialize<List<AddCartModel>>(cartItemGuest);
                    if (deserializedData != null)
                    {
                        var resCartItem = await _cartService.MergeCart(deserializedData, token);
                        await localStorage.RemoveItemAsync(Constant.CartItemKey);
                        await localStorage.RemoveItemAsync(Constant.ExpiredCartTempUser);
                    }
                }
                await _cartStateService.LoadCartDetailsAsync();
                StateHasChanged();
            }
        } else
        {
            if (!string.IsNullOrEmpty(expiredCartTempUser))
            {
                if (DateTime.TryParse(expiredCartTempUser.Trim('"'), out DateTime expirationTime))
                {
                    if (expirationTime <= DateTime.Now)
                    {
                        await localStorage.RemoveItemAsync(Constant.ExpiredCartTempUser);
                        await localStorage.RemoveItemAsync(Constant.CartItemKey);
                        await _cartStateService.LoadCartDetailsAsync();
                    }
                }
            }
            _currentUserInfo = null;
            _firstLogin = false;
            StateHasChanged();
        }

        if (isInitialLoad)
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            navigation.LocationChanged += HandleLocationChanged;
            await PerformAuthCheckAndNavigate(isInitialLoad: true);
        }
    }

    protected override void OnInitialized()
    {
        _drawerService.OnChange += StateHasChanged;
    }

    private async void HandleLocationChanged(object sender, LocationChangedEventArgs e)
    {
        await PerformAuthCheckAndNavigate(isInitialLoad: false);
    }

    public void Dispose()
    {
        navigation.LocationChanged -= HandleLocationChanged;
    }

    private async Task HandleLogout()
    {
        await localStorage.RemoveItemAsync(Constant.TokenNameLocalStorage);
        await localStorage.RemoveItemAsync(Constant.TokenExpiredLocalStorage);
        await localStorage.RemoveItemAsync(Constant.UserInfoLocalStorage);
        await localStorage.RemoveItemAsync(Constant.AuthCartIdLocalStorage);

        _currentUserInfo = null;

        navigation.NavigateTo(RouterConst.User.Login, forceLoad: true);

        _isLoading = false;
        StateHasChanged();
    }

    public async void HandleOpenCart()
    {
        await _cartStateService.LoadCartDetailsAsync(forceReload: true);
        _drawerService.OpenDrawer();
    }

    public async Task ClearLocalStorageAndNavigate(string route)
    {
        await localStorage.RemoveItemAsync(Constant.TokenNameLocalStorage);
        await localStorage.RemoveItemAsync(Constant.TokenExpiredLocalStorage);
        await localStorage.RemoveItemAsync(Constant.UserInfoLocalStorage);
        await localStorage.RemoveItemAsync(Constant.AuthCartIdLocalStorage);
        await _cartStateService.LoadCartDetailsAsync(forceReload: true);
        _currentUserInfo = null;
        _isLoading = false;
        navigation.NavigateTo(route);
    }
}
