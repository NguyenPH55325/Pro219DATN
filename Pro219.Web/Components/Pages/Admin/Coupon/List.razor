@page "/admin/coupons"
@layout AdminLayout

<div class="p-6">
    <MudBreadcrumbs Class="!p-0 !text-sm" Items="_items" Separator=">"></MudBreadcrumbs>

    <div class="flex items-center justify-between">
        <h1 class="leading-[3rem] h-12 text-3xl font-bold text-admin-default">Danh mã giảm giá</h1>
        <a href="@RouterConst.Admin.CreateCoupon" class="leading-[1.5rem] h-10 rounded-lg bg-admin-default px-6 py-2 text-white">Tạo mới</a>
    </div>

    <div class="my-6 rounded-xl border border-slate-200 bg-white p-8 shadow-sm">
         <div class="grid w-full grid-cols-3 gap-x-6 gap-y-4">
            <div>
                <MudTextField T="string" Placeholder="Tìm kiếm" Adornment="Adornment.Start" Value="@_searchValue"
                                AdornmentIcon="@Icons.Material.Filled.Search" Variant="Variant.Outlined" IconSize="Size.Medium" Class="mt-0" ValueChanged="onChangeSearch" Immediate=true></MudTextField>
            </div>
            <div>
                <MudSelect T="string" Variant="Variant.Outlined" Placeholder="Loại giảm giá" Value="@_searchDiscountTpe" ValueChanged="OnChangeDiscountType">
                    <MudSelectItem T="string" Value="@("all")">Tất cả</MudSelectItem>
                    <MudSelectItem T="string" Value="@(Constant.DiscountTypePercent)">Phần trăm</MudSelectItem>
                    <MudSelectItem T="string" Value="@(Constant.DiscountTypeFixed)">Cố định</MudSelectItem>
                </MudSelect>
            </div>
            <div>
                <MudSelect T="byte" Variant="Variant.Outlined" Placeholder="Loại áp dụng" Value="@_searchDiscountAmountType" ValueChanged="OnChangeDiscountAmountType">
                    <MudSelectItem T="byte" Value="0">Tất cả</MudSelectItem>
                    <MudSelectItem T="byte" Value="1">Hóa đơn</MudSelectItem>
                    <MudSelectItem T="byte" Value="2">Phí vận chuyển</MudSelectItem>
                </MudSelect>
            </div>
            <div>
                <MudDatePicker Variant="Variant.Outlined" Placeholder="Ngày bắt đầu" Date="@_startDate" DateChanged="OnChangeStartDate" MaxDate="@_maxStartDate" />
            </div>
            <div>
                <MudDatePicker Variant="Variant.Outlined" Placeholder="Ngày bắt đầu" Date="@_endDate" DateChanged="OnChangeEndDate" MinDate="@_minEndDate" />
            </div>
            <div class="flex items-center gap-2">
                <MudButton Variant="Variant.Outlined" OnClick="OnSearch" Class="h-14 w-full"><MudIcon Icon="@Icons.Material.Filled.Search" Class="mr-2" /> Tìm kiếm</MudButton>
                <MudButton Variant="Variant.Outlined" OnClick="OnReset" Class="h-14 w-full"><MudIcon Icon="@Icons.Material.Filled.Filter" Class="mr-2" /> Đặt lại</MudButton>
            </div>
        </div>
    </div>

    <div class="w-full rounded-xl border border-slate-200 bg-white p-8 shadow-sm">
        <MudTable Bordered Items="@_discountCodes" CellClass="min-w-60" Loading="@_loading" Dense="true" Hover="true" Virtualize="true" FixedHeader="true" HorizontalScrollbar="true">
            <HeaderContent>
                <MudTh class="whitespace-nowrap"><MudTableSortLabel SortLabel="Code" T="DAL.Models.DiscountCode">Mã</MudTableSortLabel></MudTh>
                <MudTh class="whitespace-nowrap"><MudTableSortLabel SortLabel="DiscountType" T="DAL.Models.DiscountCode">Loại Giảm Giá</MudTableSortLabel></MudTh>
                <MudTh class="whitespace-nowrap"><MudTableSortLabel SortLabel="Value" T="DAL.Models.DiscountCode">Giá Trị</MudTableSortLabel></MudTh>
                <MudTh class="whitespace-nowrap"><MudTableSortLabel SortLabel="Giá trị tối thiểu áp dụng" T="DAL.Models.DiscountCode">Giá trị tối thiểu áp dụng</MudTableSortLabel></MudTh>
                <MudTh class="whitespace-nowrap"><MudTableSortLabel SortLabel="Giá trị giảm tối đa" T="DAL.Models.DiscountCode">Giá trị giảm tối đa</MudTableSortLabel></MudTh>
                <MudTh class="whitespace-nowrap"><MudTableSortLabel SortLabel="Số lần sử dụng tối đa" T="DAL.Models.DiscountCode">Số mã được phát hành</MudTableSortLabel></MudTh>
                <MudTh class="whitespace-nowrap"><MudTableSortLabel SortLabel="Số mã được phát hành" T="DAL.Models.DiscountCode">Đã sử dụng</MudTableSortLabel></MudTh>
                <MudTh class="whitespace-nowrap"><MudTableSortLabel SortLabel="StartDate" T="DAL.Models.DiscountCode">Ngày Bắt Đầu</MudTableSortLabel></MudTh>
                <MudTh class="whitespace-nowrap"><MudTableSortLabel SortLabel="EndDate" T="DAL.Models.DiscountCode">Ngày Kết Thúc</MudTableSortLabel></MudTh>
                <MudTh class="whitespace-nowrap"><MudTableSortLabel SortLabel="Trạng thái" T="DAL.Models.DiscountCode">Trạng thái</MudTableSortLabel></MudTh>
                <MudTh class="whitespace-nowrap">Thao tác</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Code">@context.Code</MudTd>
                <MudTd DataLabel="DiscountType">@(context.Status == 1 ? "Phần trăm (%)" : "Giá cố định")</MudTd>
                <MudTd DataLabel="Value">@(FormatDiscountValue(context))</MudTd>
                <MudTd DataLabel="MinOrderValue">@(context.MinOrderValue?.ToString("C0", vietnameseCulture) ?? "0")</MudTd>
                <MudTd DataLabel="MaxDiscountAmount">@(context.MaxDiscountAmount?.ToString("C0", vietnameseCulture) ?? "0")</MudTd>
                <MudTd DataLabel="MaxUsage">@context.MaxUsage</MudTd>
                <MudTd DataLabel="UsageCount">@context.UsageCount / @context.MaxUsage</MudTd>
                <MudTd DataLabel="EndDate">@context.StartDate.ToString("dd/MM/yyyy HH:mm")</MudTd>
                <MudTd DataLabel="EndDate">@context.EndDate.ToString("dd/MM/yyyy HH:mm")</MudTd>
                <MudTd DataLabel="Trạng thái">@(context.StartDate > DateTime.Now ? "Chưa phát hành" : (context.StartDate <= DateTime.Now && context.EndDate >= DateTime.Now) ? "Đang diễn ra" : "Đã hết hạn")</MudTd>
                <MudTd DataLabel="Thao tác">
                    @{
                        bool isActiveNow = IsCouponActiveNow(context);
                    }

                    <MudIconButton Icon="@Icons.Material.Filled.BorderColor"
                                   aria-label="update"
                                   Href=@($"{RouterConst.Admin.EditCoupon.Replace(":id", context.DiscountId.ToString())}")
                                   Disabled="@isActiveNow"></MudIconButton>

                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                   aria-label="delete"
                                   OnClick="@(() => OpenDialogDelete(context.DiscountId))"
                                   Disabled="@isActiveNow"></MudIconButton>
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText>Không có dữ liệu.</MudText>
            </NoRecordsContent>
            <LoadingContent>
                <div class="flex w-full flex-col gap-3">
                    @{
                        for (var i = 0; i < 5; i++)
                        {
                            <div class="flex items-center justify-between gap-2">
                                <MudSkeleton Width="100%" Height="3rem" />
                                <MudSkeleton Width="100%" Height="3rem" />
                                <MudSkeleton Width="100%" Height="3rem" />
                                <MudSkeleton Width="100%" Height="3rem" />
                                <MudSkeleton Width="100%" Height="3rem" />
                                <MudSkeleton Width="100%" Height="3rem" />
                                <MudSkeleton Width="100%" Height="3rem" />
                                <MudSkeleton Width="100%" Height="3rem" />
                                <MudSkeleton Width="100%" Height="3rem" />
                            </div>
                        }
                    }
                </div>
            </LoadingContent>
            <PagerContent>
                <MudTablePager />
            </PagerContent>
        </MudTable>
    </div>
</div>

@code {
    private List<DAL.Models.DiscountCode> _discountCodes = [];
    private readonly DialogOptions _maxWidth = new() { MaxWidth = MaxWidth.Large, FullWidth = true };

    private string _searchValue = string.Empty;
    private string _searchDiscountTpe = "all";
    private byte _searchDiscountAmountType = 0;
    private DateTime? _startDate = DateTime.Now.AddYears(-1);
    private DateTime? _endDate = DateTime.Now.AddYears(1);
    private DateTime? _maxStartDate = DateTime.Now.AddYears(1);
    private DateTime? _minEndDate = DateTime.Now.AddYears(-1);
    private bool _loading = true;
    CultureInfo vietnameseCulture = new CultureInfo("vi-VN");

    private List<BreadcrumbItem> _items =
    [
        new("Trang Chủ", href: RouterConst.Admin.Home),
    new("Mã Giảm Giá", href: "#", disabled: true),
    ];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await LoadData();
        }
        catch (Exception e)
        {
            _loading = false;
        }
        finally
        {
            _loading = false;
        }
    }

    async Task LoadData()
    {
        var res = await _couponService.GetAll(_searchValue, _searchDiscountTpe, _searchDiscountAmountType, _startDate, _endDate);
        var data = res.Data;
        if (res.IsSuccess && data.Count() > 0)
        {
            _discountCodes = data;
        }else if(res.IsSuccess && data.Count() == 0)
        {
            _discountCodes = [];
        }
        else if (res.IsSuccess == false && res.StatusCode == "NotFound")
        {
            _snackbar.Add("Không tìm thấy hóa đơn này.", Severity.Error);
            navigation.NavigateTo(RouterConst.NotFound);
        }
        else
        {
            _snackbar.Add("Đã có lỗi xảy ra. Vui lòng báo cho quản trị viên.", Severity.Error);
            navigation.NavigateTo(RouterConst.Admin.Home);
        }
        StateHasChanged();
    }

    private async Task onChangeSearch(string value)
    {
        _searchValue = value.Trim();
    }

    private async Task OnSearch()
    {
        await LoadData();
    }

    private async Task OnReset()
    {
        _searchValue = string.Empty;
        _searchDiscountTpe = "all";
        _searchDiscountAmountType = 0;
        _startDate = DateTime.Now.AddYears(-1);
        _endDate = DateTime.Now;
        _maxStartDate = DateTime.Now;
        _minEndDate = DateTime.Now.AddYears(-1);
        await LoadData();
    }

    private void OnChangeDiscountType(string value)
    {
        _searchDiscountTpe = value;
    }

    private void OnChangeDiscountAmountType(byte value)
    {
        _searchDiscountAmountType = value;
    }

    private void OnChangeStartDate(DateTime? value)
    {
        _startDate = value;
        _minEndDate = value;
    }

    private void OnChangeEndDate(DateTime? value)
    {
        _endDate = value;
        _maxStartDate = value;
    }

    async Task OpenDialogDelete(int id)
    {
        var deleteParaeters = new DialogParameters<Admin.Coupon.ConfirmDeleteDialog>
        {
            {x => x.id, id}
        };

        var dialog = await _dialogService.ShowAsync<Admin.Coupon.ConfirmDeleteDialog>("Options Dialog", deleteParaeters, _maxWidth);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            await LoadData();
            StateHasChanged();
        }
    }

    private bool IsCouponActiveNow(DAL.Models.DiscountCode discount)
    {
        var now = DateTime.Now;

        return discount.IsActive && (now >= discount.StartDate);
    }

    private string FormatDiscountValue(DAL.Models.DiscountCode discount)
    {
        if (discount.DiscountType == Constant.DiscountTypePercent)
        {
            return $"{discount.Value.ToString("F0")}%";
        }
        else if (discount.DiscountType == Constant.DiscountTypeFixed)
        {
            return $"{discount.Value.ToString("C0", vietnameseCulture)}";
        }
        return discount.Value.ToString();
    }
}