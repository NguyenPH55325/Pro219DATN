@page "/admin/coupons/{id:int}/edit"
@layout AdminLayout

<div class="p-6">
    <MudBreadcrumbs Class="!p-0 !text-sm" Items="_items" Separator=">"></MudBreadcrumbs>

    <h1 class="leading-[3rem] h-12 text-3xl font-bold text-admin-default">Sửa mã giám giá</h1>

    <div class="mx-auto mt-6 w-full rounded-lg bg-white p-8 shadow-sm">
        <EditForm Model="_model" OnValidSubmit="OnSubmit" class="mx-auto flex w-full flex-col gap-4">
            <DataAnnotationsValidator />

            <div class="mx-auto flex w-full max-w-[64.5rem] gap-6 rounded-lg bg-slate-100 px-6 py-4">
                <span Class="w-44 flex-shrink-0 pt-4 text-base font-medium text-gray-900">Mã</span>
                <MudTextField @bind-Value="@_model.Code" For="@(() => _model.Code)" Placeholder="MUAHE20" Variant="Variant.Outlined" FullWidth Style="background-color: white" />
            </div>

            <div class="mx-auto flex w-full max-w-[64.5rem] gap-6 rounded-lg bg-slate-100 px-6 py-4">
                <span Class="w-44 flex-shrink-0 pt-4 text-base font-medium text-gray-900">Loại</span>

                <MudRadioGroup Value="@_discountType" ValueChanged="@((int value) => OnDiscoutTypeChange(value))">
                    <MudRadio Value="1" Color="Color.Primary">Phần Trăm</MudRadio>
                    <MudRadio Value="0" Color="Color.Primary">Giá Cố Định</MudRadio>
                </MudRadioGroup>
            </div>

            <div class="mx-auto flex w-full max-w-[64.5rem] gap-6 rounded-lg bg-slate-100 px-6 py-4">
                <span Class="w-44 flex-shrink-0 pt-4 text-base font-medium text-gray-900">Giá trị (@(_discountType == 1 ? "%" : "VND"))</span>
                <MudNumericField @bind-Value="@_model.Value" For="@(() => _model.Value)" Format="F0" Step="@(_discountType == 1 ? 10 : 1000)" Adornment="Adornment.End"
                                 AdornmentText="@(_discountType == 1 ? "%" : "đ")" HideSpinButtons="true" Placeholder="@(_discountType == 1 ? "10" : "179000")" Variant="Variant.Outlined" Style="background-color: white" FullWidth />
            </div>

            <div class="mx-auto flex w-full max-w-[64.5rem] gap-6 rounded-lg bg-slate-100 px-6 py-4">
                <span Class="w-44 flex-shrink-0 pt-4 text-base font-medium text-gray-900">Giá tối thiểu áp dụng</span>
                <MudNumericField @bind-Value="@_model.MinOrderValue" For="@(() => _model.MinOrderValue)" Step="1000" Format="F0" Adornment="Adornment.End"
                                 AdornmentText="₫" HideSpinButtons="true" Placeholder="179000" Variant="Variant.Outlined" Style="background-color: white" FullWidth />
            </div>

            <div class="mx-auto flex w-full max-w-[64.5rem] gap-6 rounded-lg bg-slate-100 px-6 py-4">
                <span Class="w-44 flex-shrink-0 pt-4 text-base font-medium text-gray-900">Giá giảm tối đa</span>
                <MudNumericField @bind-Value="@_model.MaxDiscountAmount" Disabled="@_isDisableMaxValue" For="@(() => _model.MaxDiscountAmount)" Step="1000" Format="F0" Adornment="Adornment.End"
                                 AdornmentText="₫" HideSpinButtons="true" Placeholder="179000" Variant="Variant.Outlined" Style="background-color: white" FullWidth />
            </div>

            <div class="mx-auto flex w-full max-w-[64.5rem] gap-6 rounded-lg bg-slate-100 px-6 py-4">
                <span Class="w-44 flex-shrink-0 pt-4 text-base font-medium text-gray-900">Số mã được phát hành</span>
                <MudNumericField @bind-Value="@_model.MaxUsage" For="@(() => _model.MaxUsage)" HideSpinButtons="true" Placeholder="1" Variant="Variant.Outlined" Style="background-color: white" FullWidth />
            </div>

            <div class="mx-auto flex w-full max-w-[64.5rem] gap-6 rounded-lg bg-slate-100 px-6 py-4">
                <span Class="w-44 flex-shrink-0 pt-4 text-base font-medium text-gray-900">Thời gian diễn ra</span>
                <div class="flex flex-1 gap-4">
                    <div class="flex flex-1 gap-4">
                        <MudDatePicker Date="@_startDateOnly"
                                       DateChanged="OnStartDateChanged"
                                       For="@(() => _model.StartDate)"
                                       Label="Ngày Bắt Đầu"
                                       Variant="Variant.Outlined"
                                       Style="background-color: white" />

                        <MudTimePicker Time="@_startTime"
                                       TimeChanged="OnStartTimeChanged"
                                       Label="Giờ Bắt Đầu"
                                       Variant="Variant.Outlined"
                                       Style="background-color: white" />
                    </div>

                    <div class="flex flex-1 gap-4">
                        <MudDatePicker Date="@_endDateOnly"
                                       DateChanged="OnEndDateChanged"
                                       For="@(() => _model.EndDate)"
                                       Label="Ngày Kết Thúc"
                                       Variant="Variant.Outlined"
                                       Style="background-color: white" />

                        <MudTimePicker Time="@_endTime"
                                       TimeChanged="OnEndTimeChanged"
                                       Label="Giờ Kết Thúc"
                                       Variant="Variant.Outlined"
                                       Style="background-color: white" />
                    </div>
                </div>
            </div>

            <div class="mx-auto flex w-full max-w-[64.5rem] gap-6 rounded-lg bg-slate-100 px-6 py-4">
                <span Class="w-44 flex-shrink-0 pt-4 text-base font-medium text-gray-900">Tái sử dụng</span>
                <MudCheckBox T="bool" @bind-Checked="@_model.IsReusable" Color="Color.Primary" Label="Cho phép tái sử dụng"></MudCheckBox>
            </div>

            @*<div class="mx-auto flex w-full max-w-[64.5rem] gap-6 rounded-lg bg-slate-100 px-6 py-4">
                <span Class="w-44 flex-shrink-0 pt-4 text-base font-medium text-gray-900">Dành cho</span>

                <MudRadioGroup @bind-Value="@_TypeDiscountCode" For="@(() => _TypeDiscountCode)">
                    <MudRadio Value="1" Color="Color.Primary">Hóa đơn</MudRadio>
                    <MudRadio Value="2" Color="Color.Primary">Phí vận chuyển</MudRadio>
                </MudRadioGroup>
            </div>*@

            @*<div class="mx-auto flex w-full max-w-[64.5rem] gap-6 rounded-lg bg-slate-100 px-6 py-4">
                <span Class="w-44 flex-shrink-0 pt-4 text-base font-medium text-gray-900">Trạng thái</span>

                <MudRadioGroup @bind-Value="@_isActive" For="@(() => _isActive)">
                    <MudRadio Value="1" Color="Color.Primary">Hoạt động</MudRadio>
                    <MudRadio Value="0" Color="Color.Primary">Ngừng Hoạt động</MudRadio>
                </MudRadioGroup>
            </div>*@

            <div class="flex items-center justify-center gap-4">
                <MudButton Href="@RouterConst.Admin.Coupon" Color="Color.Surface" Variant="Variant.Filled" ButtonType="ButtonType.Button" Class="w-fit px-10">Quay lại</MudButton>
                <MudButton Color="Color.Primary" Variant="Variant.Filled" ButtonType="ButtonType.Submit" Disabled="@_isSubmitting" Class="w-fit px-10">Sửa</MudButton>
            </div>
        </EditForm>
    </div>
</div>

@code {
    [Parameter]
    public int id { get; set; }

    private DiscountCodeModel _model = new DiscountCodeModel();
    private int _isActive = -1;
    private int _discountType = -1;
    private int _TypeDiscountCode = -1;
    private DateTime? _startDateOnly;
    private DateTime? _endDateOnly;
    private TimeSpan? _startTime;
    private TimeSpan? _endTime;
    private string _token = "";
    private bool _isDisableMaxValue = false;
    private bool _isSubmitting = false;

    private List<BreadcrumbItem> _items =
    [
        new("Trang Chủ", href: RouterConst.Admin.Home),
    new("Mã Giảm Giá", href: RouterConst.Admin.Coupon),
    new("Sửa Mã Giảm Giá", href: "#", disabled: true),
    ];

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _token = await localStorage.GetItemAsStringAsync(Constant.TokenNameLocalStorage);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var discountCode = await _couponService.GetById(id);

        if (discountCode.IsSuccess && discountCode.Data != null)
        {
            var data = discountCode.Data;

            _model = data;

            if (data.Status == 1)
            {
                _discountType = 1;
                _isDisableMaxValue = false;
            }
            else if (data.Status == 2)
            {
                _discountType = 0;
                _isDisableMaxValue = true;
            }

            _isActive = data.IsActive ? 1 : 0;

            _TypeDiscountCode = (int)data.Type;

            if (data.StartDate.HasValue)
            {
                _startTime = data.StartDate.Value.TimeOfDay;
                _startDateOnly = data.StartDate.Value.Date;
            }

            if (data.EndDate.HasValue)
            {
                _endTime = data.EndDate.Value.TimeOfDay;
                _endDateOnly = data.EndDate.Value.Date;
            }
        }
    }

    private void OnStartDateChanged(DateTime? date)
    {
        _startDateOnly = date?.Date;
        UpdateStartDateTime();
    }

    private void OnStartTimeChanged(TimeSpan? time)
    {
        _startTime = time;
        UpdateStartDateTime();
    }

    private void OnEndDateChanged(DateTime? date)
    {
        _endDateOnly = date?.Date;
        UpdateEndDateTime();
    }

    private void OnEndTimeChanged(TimeSpan? time)
    {
        _endTime = time;
        UpdateEndDateTime();
    }

    private void UpdateStartDateTime()
    {
        if (_startDateOnly.HasValue && _startTime.HasValue)
        {
            _model.StartDate = _startDateOnly.Value.Date.Add(_startTime.Value);
        }
        else if (_startDateOnly.HasValue)
        {
            _model.StartDate = _startDateOnly.Value.Date;
        }
    }

    private void UpdateEndDateTime()
    {
        if (_endDateOnly.HasValue && _endTime.HasValue)
        {
            _model.EndDate = _endDateOnly.Value.Date.Add(_endTime.Value);
        }
        else if (_endDateOnly.HasValue)
        {
            _model.EndDate = _endDateOnly.Value.Date;
        }
    }

    private void UpdateDateTime()
    {
        UpdateStartDateTime();
        UpdateEndDateTime();
    }

    void OnDiscoutTypeChange(int type)
    {
        _discountType = type;

        _isDisableMaxValue = _discountType == 1 ? false : true;
        if (_discountType == 2) _model.MaxDiscountAmount = null;

        StateHasChanged();
    }

    async Task OnSubmit()
    {
        if (_isSubmitting) return;
        if (_isActive == -1)
        {
            _snackbar.Add("Vui lòng chọn trạng thái", Severity.Error);
            return;
        }
        if (_discountType == -1)
        {
            _snackbar.Add("Vui lòng chọn loại mã giảm giá", Severity.Error);
            return;
        }
        if (_TypeDiscountCode == -1)
        {
            _snackbar.Add("Vui lòng chọn loại áp dụng", Severity.Error);
            return;
        }

        if (!_model.StartDate.HasValue || !_model.EndDate.HasValue)
        {
            _snackbar.Add("Vui lòng chọn ngày, giờ bắt đầu và kết thúc", Severity.Error);
            return;
        }

        if (_model.StartDate.HasValue && _model.EndDate.HasValue)
        {
            if (_model.StartDate.Value >= _model.EndDate.Value)
            {
                _snackbar.Add("Ngày và giờ bắt đầu phải nhỏ hơn ngày kết thúc.", Severity.Warning);
                return;
            }
        }

        if (_model.StartDate.HasValue && _model.StartDate.Value <= DateTime.Now)
        {
            _snackbar.Add("Ngày và giờ bắt đầu phải lớn hơn thời điểm hiện tại.", Severity.Warning);
            return;
        }

        if (_model.EndDate.HasValue && _model.EndDate.Value <= DateTime.Now)
        {
            _snackbar.Add("Ngày và giờ kết thúc phải lớn hơn thời điểm hiện tại.", Severity.Warning);
            return;
        }

        try
        {
            _isSubmitting = true;
            _model.IsActive = true;
            _model.Status = _discountType == 1 ? (byte)1 : (byte)2;
            var result = await _couponService.Update(_model, _token);

            if (result.IsSuccess)
            {
                _snackbar.Add("Sửa thành công", Severity.Success);
                navigation.NavigateTo(RouterConst.Admin.Coupon);
            }
            else
            {
                _snackbar.Add("Sửa thất bại", Severity.Warning);
            }
        }
        catch(Exception ex) {}
        finally
        {
            _isSubmitting = false;
        }
    }
}