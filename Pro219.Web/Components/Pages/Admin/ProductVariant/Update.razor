@page "/admin/product-variants/{productVariantId:int}/edit"
@layout AdminLayout

<div class="p-6">
    <MudBreadcrumbs Class="!p-0 !text-sm" Items="_items" Separator=">"></MudBreadcrumbs>

    <h1 class="leading-[3rem] h-12 text-3xl font-bold text-admin-default">Sửa sản phẩm</h1>

    <div class="mx-auto mt-6 w-full rounded-lg bg-white p-8 shadow-sm">
        <EditForm Model="_model" OnValidSubmit="OnSubmit" class="mx-auto flex w-full flex-col gap-4">
            <DataAnnotationsValidator />

            <div class="mx-auto flex w-full max-w-[64.5rem] gap-6 rounded-lg bg-slate-100 px-6 py-4">
                <span Class="w-44 flex-shrink-0 pt-4 text-base font-medium text-gray-900">Mã sản phẩm</span>
                <MudTextField Disabled @bind-Value="@_model.SKU" For="@(() => _model.SKU)" Placeholder="NKE-TSH-RED-M" Variant="Variant.Outlined" FullWidth Style="background-color: white" />
            </div>

            <div class="mx-auto flex w-full max-w-[64.5rem] gap-6 rounded-lg bg-slate-100 px-6 py-4">
                <span Class="w-44 flex-shrink-0 pt-4 text-base font-medium text-gray-900">Giá</span>
                <MudNumericField @bind-Value="@_model.Price" For="@(() => _model.Price)" Placeholder="179000" Min="0" Adornment="Adornment.End"
                                 AdornmentText="₫" HideSpinButtons="true" Variant="Variant.Outlined" Style="background-color: white" FullWidth />
            </div>

            <div class="mx-auto flex w-full max-w-[64.5rem] gap-6 rounded-lg bg-slate-100 px-6 py-4">
                <span Class="w-44 flex-shrink-0 pt-4 text-base font-medium text-gray-900">Màu sắc</span>
                <MudSelect T="int" @bind-Value="@_model.ColorId" For="@(() => _model.ColorId)" Placeholder="Áo polo" Variant="Variant.Outlined" Style="background-color: white" FullWidth>
                    <MudSelectItem Value="0">Vui lòng chọn</MudSelectItem>
                    @foreach (var item in _colors)
                    {
                        <MudSelectItem Value="@item.Id">@item.Name</MudSelectItem>
                    }
                </MudSelect>
            </div>

            <div class="mx-auto flex w-full max-w-[64.5rem] gap-6 rounded-lg bg-slate-100 px-6 py-4">
                <span Class="w-44 flex-shrink-0 pt-4 text-base font-medium text-gray-900">Kích cỡ</span>
                <MudSelect T="int" @bind-Value="@_model.SizeId" For="@(() => _model.SizeId)" Placeholder="Nike" Variant="Variant.Outlined" Style="background-color: white" FullWidth>
                    <MudSelectItem Value="0">Vui lòng chọn</MudSelectItem>
                    @foreach (var item in _sizes)
                    {
                        <MudSelectItem Value="@item.Id">@item.Name</MudSelectItem>
                    }
                </MudSelect>
            </div>

            <div class="mx-auto flex w-full max-w-[64.5rem] gap-6 rounded-lg bg-slate-100 px-6 py-4">
                <span Class="w-44 flex-shrink-0 pt-4 text-base font-medium text-gray-900">Số lượng</span>
                <MudNumericField @bind-Value="@_model.StockQuantity" For="@(() => _model.StockQuantity)" Min="0" HideSpinButtons="true" Placeholder="100" Variant="Variant.Outlined" Style="background-color: white" FullWidth />
            </div>

            <div class="mx-auto flex w-full max-w-[64.5rem] gap-6 rounded-lg bg-slate-100 px-6 py-4">
                <span Class="w-44 flex-shrink-0 pt-2 text-base font-medium text-gray-900">Ảnh</span>
                <div class="flex flex-col gap-4">
                    <MudFileUpload T="IBrowserFile" FilesChanged="UploadFiles">
                        <ActivatorContent>
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       ButtonType="ButtonType.Button"
                                       StartIcon="@Icons.Material.Filled.CloudUpload"
                                       Disabled="@((_images.Count + _newImages.Count) >= 5)">
                                Thêm Ảnh (@(_images.Count + _newImages.Count)/5)
                            </MudButton>
                        </ActivatorContent>
                    </MudFileUpload>

                    @if (_images.Any() || _newImages.Any())
                    {
                        <div class="flex gap-4">
                            @foreach (var item in _images)
                            {
                                <div class="center; relative flex h-fit max-w-40 items-center justify-center overflow-hidden rounded-lg border-2 border-gray-300">
                                    <MudImage Src="@item.ImageUrl" Alt="Ảnh đã lưu" ObjectFit="ObjectFit.Cover" Class="h-full w-full" />
                                    <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="@(() => HandleRemoveExistingImage(item))"
                                                   Class="absolute top-1 right-1 text-white !p-0" />
                                </div>
                            }
                            @foreach (var item in _newImages)
                            {
                                <div class="center; relative flex h-fit max-w-40 items-center justify-center overflow-hidden rounded-lg border-2 border-gray-300">
                                    <MudImage Src="@item.Url" Alt="@item.File.Name" ObjectFit="ObjectFit.Cover" Class="h-full w-full" />
                                    <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="@(() => HandleRemoveNewImage(item.File))"
                                                   Class="absolute top-1 right-1 text-white !p-0" />
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>

            <div class="mx-auto flex w-full max-w-[64.5rem] gap-6 rounded-lg bg-slate-100 px-6 py-4">
                <span Class="w-44 flex-shrink-0 pt-4 text-base font-medium text-gray-900">Trạng thái</span>

                <MudRadioGroup @bind-Value="@_isActive" For="@(() => _isActive)">
                    <MudRadio Value="1" Color="Color.Primary">Hoạt động</MudRadio>
                    <MudRadio Value="0" Color="Color.Primary">Ngừng Hoạt động</MudRadio>
                </MudRadioGroup>
            </div>

            <div class="flex items-center justify-center gap-4">
                <MudButton OnClick="@(() => navigation.NavigateTo(RouterConst.Admin.ProductVariant))" Color="Color.Surface" Variant="Variant.Filled" ButtonType="ButtonType.Button" Class="w-fit px-10">Quay lại</MudButton>
                <MudButton Color="Color.Primary" Variant="Variant.Filled" ButtonType="ButtonType.Submit" Disabled="@_isSubmitting" Class="w-fit px-10">Tạo</MudButton>
            </div>
        </EditForm>
    </div>
</div>

@code {
    [Parameter]
    public int productVariantId { get; set; }

    [Inject]
    public IWebHostEnvironment WebHostEnvironment { get; set; }

    ProductVariantModel _model = new ProductVariantModel(); 
    List<DAL.Models.Size> _sizes = new List<DAL.Models.Size>();
    List<DAL.Models.Color> _colors = new List<DAL.Models.Color>();

    List<DAL.Models.ProductImage> _images = new List<DAL.Models.ProductImage>();
    IList<ImageFileDTO> _newImages = new List<ImageFileDTO>();
    List<DAL.Models.ProductImage> _imagesToDelete = new List<DAL.Models.ProductImage>();

    private string _token = "";
    private bool _isLoading = true;
    private int _isActive = 1;
    private int MaxAllowedSize = 1024 * 1024 * 5;
    private bool _isSubmitting = false;

    private List<BreadcrumbItem> _items =>
    [
        new("Trang Chủ", href: RouterConst.Admin.Home),
    new("Sản Phẩm Chi Tiết", href: RouterConst.Admin.ProductVariant),
    new("Chỉnh Sửa Sản Phẩm", href: "#", disabled: true),
    ];

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _token = await localStorage.GetItemAsStringAsync(Constant.TokenNameLocalStorage);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        _isLoading = true;

        var resProductVariant = await _productVariantService.GetById(productVariantId);
        var resSize = await _sizeService.GetAll(null);
        var resColor = await _colorService.GetAll(null);

        var dataProductVariant = resProductVariant.Data;
        var dataSize = resSize.Data;
        var dataColor = resColor.Data;

        if (resSize.IsSuccess && dataSize != null)
        {
            _sizes = dataSize;
        }

        if (resColor.IsSuccess && dataColor != null)
        {
            _colors = dataColor;
        }

        if (resProductVariant.IsSuccess && dataProductVariant != null)
        {
            var data = dataProductVariant;

            _model.Id = data.Id;
            _model.SKU = data.SKU;
            _model.ProductId = data.ProductId;
            _model.Price = data.Price;
            _model.ColorId = data.ColorId ?? -1;
            _model.SizeId = data.SizeId ?? -1;
            _model.Status = data.Status;
            _model.StockQuantity = data.StockQuantity;
            _model.IsActive = data.IsActive;
            _isActive = data.IsActive == null ? -1 : data.IsActive == true ? 1 : 0;

            var resImages = await _productImageService.GetAllByProductVariantId(productVariantId);
            if (resImages.IsSuccess && resImages.Data != null)
            {
                _images = resImages.Data;
            }
        }
        else
        {
            _snackbar.Add("Không tìm thấy sản phẩm này", Severity.Error);
            navigation.NavigateTo(RouterConst.Admin.Product);
            return;
        }

        _isLoading = false;
        StateHasChanged();
    }

    private async Task UploadFiles(IBrowserFile file)
    {
        if (_images.Count + _newImages.Count >= 5)
        {
            _snackbar.Add("Chỉ được phép thêm tối đa 5 ảnh", Severity.Warning);
            return;
        }

        if (file.Size > MaxAllowedSize)
        {
            _snackbar.Add("Ảnh không được quá 5mb", Severity.Warning);
            return;
        }

        var url = await Task.Run(async () =>
        {
            using var stream = file.OpenReadStream(MaxAllowedSize);
            using var memoryStream = new MemoryStream();
            await stream.CopyToAsync(memoryStream);

            var base64String = Convert.ToBase64String(memoryStream.ToArray());
            return $"data:{file.ContentType};base64,{base64String}";
        });

        _newImages.Add(new ImageFileDTO { File = file, Url = url });
        StateHasChanged();
    }

    private void HandleRemoveExistingImage(DAL.Models.ProductImage image)
    {
        _images.Remove(image);
        _imagesToDelete.Add(image);
        StateHasChanged();
    }

    private void HandleRemoveNewImage(IBrowserFile file)
    {
        var itemToRemove = _newImages.FirstOrDefault(i => i.File == file);
        if (itemToRemove != null)
        {
            _newImages.Remove(itemToRemove);
            StateHasChanged();
            _snackbar.Add($"Đã xóa ảnh mới: {file.Name}", Severity.Info);
        }
    }

    async Task OnSubmit()
    {
        if (_isSubmitting) return;
        if (_images.Count + _newImages.Count <= 0)
        {
            _snackbar.Add("Vui lòng thêm ít nhất 1 ảnh", Severity.Warning);
            return;
        }

        try
        {
            _isSubmitting = true;

            var result = await _productVariantService.Update(_model, _token);

            if (result.IsSuccess)
            {
                try
                {
                    var productVariantId = _model.Id;
                    var contentRootPath = WebHostEnvironment.WebRootPath;
                    var productImagesPath = Path.Combine(contentRootPath, "Uploads", "Images", "ProductVariants", productVariantId.ToString());

                    if (_imagesToDelete.Any())
                    {
                        var resultDelete = await _productImageService.DeleteAny(_imagesToDelete.Select(i => i.Id).ToList(), _token);

                        foreach (var image in _imagesToDelete)
                        {
                            var fullPath = Path.Combine(contentRootPath, image.ImageUrl.TrimStart('/'));
                            if (File.Exists(fullPath))
                            {
                                File.Delete(fullPath);
                            }
                        }
                        _imagesToDelete.Clear();
                    }

                    if (_newImages.Any())
                    {
                        if (!Directory.Exists(productImagesPath))
                        {
                            Directory.CreateDirectory(productImagesPath);
                        }

                        List<DAL.Models.ProductImage> imagesToCreate = new List<DAL.Models.ProductImage>();

                        foreach (var image in _newImages)
                        {
                            var fileName = Path.GetFileName(image.File.Name);
                            var filePath = Path.Combine(productImagesPath, fileName);

                            await using Stream fileStream = image.File.OpenReadStream(MaxAllowedSize);
                            await using FileStream fs = File.Create(filePath);
                            await fileStream.CopyToAsync(fs);

                            DAL.Models.ProductImage productImage = new DAL.Models.ProductImage
                                {
                                    ProductVariantId = productVariantId,
                                    ProductId = _model.ProductId,
                                    ImageUrl = "/Uploads/Images/ProductVariants/" + productVariantId.ToString() + "/" + fileName,
                                    IsMain = true,
                                    Status = 1,
                                };
                            imagesToCreate.Add(productImage);
                        }

                        if (imagesToCreate.Any())
                        {
                            await _productImageService.CreateAny(imagesToCreate);
                        }

                        _newImages.Clear();
                    }

                    var resImagesAfterUpdate = await _productImageService.GetAllByProductVariantId(productVariantId);
                    if (resImagesAfterUpdate.IsSuccess && resImagesAfterUpdate.Data != null)
                    {
                        _images = resImagesAfterUpdate.Data;
                    }

                    _snackbar.Add("Cập nhật sản phẩm chi tiết thành công", Severity.Success);
                    navigation.NavigateTo(RouterConst.Admin.ProductDetail.Replace(":id", _model.ProductId.ToString()));
                }
                catch (Exception ex)
                {
                    _snackbar.Add($"Cập nhật sản phẩm thành công, nhưng lỗi xử lý ảnh: {ex.Message}", Severity.Warning);
                }
            }
        }
        catch(Exception ex) {}
        finally
        {
            _isSubmitting = false;
        }
    }
}