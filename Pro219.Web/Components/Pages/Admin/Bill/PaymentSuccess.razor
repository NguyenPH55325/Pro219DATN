@page "/admin/order/payment-success"
@layout AdminLayout

<section class="flex h-screen w-full items-center justify-center">
    <div class="flex w-full flex-col items-center justify-center gap-4 p-6 text-center">
        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Class="!text-4xl" />
        <h2 class="text-2xl font-bold text-green-600">Chuyển khoản thành công!</h2>
        <p class="text-base"><span class="font-bold">Mã đơn hàng:</span> @_orderCodeSuccess</p>
        <div class="flex justify-center gap-3">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => navigation.NavigateTo(RouterConst.Admin.SaleCounter))">Bán tại quầy</MudButton>
            <MudButton Variant="Variant.Outlined" OnClick="@(() => navigation.NavigateTo(RouterConst.Admin.BillDetail.Replace(":id", _orderIdSuccess.ToString())))">Xem đơn hàng</MudButton>
        </div>
    </div>
</section>

@code {
    [SupplyParameterFromQuery(Name = "order-id")]
    public int _orderId { get; set; } = 0;

    private int _orderIdSuccess = -1;
    private string _orderCodeSuccess = string.Empty;
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
        _loading = false;
        StateHasChanged();
    }

    async Task LoadData()
    {
        if (_orderId > 0)
        {
            _orderIdSuccess = _orderId;
            var result = await _orderService.PaymentSuccess(_orderId, true);
            if (result.IsSuccess)
            {
                _orderCodeSuccess = result.Data.OrderCode;
            }
        }
    }
}
