@page "/admin/orders/{id:int}/detail"
@layout AdminLayout

<div class="p-6">
    <MudBreadcrumbs Class="!p-0 !text-sm" Items="_items" Separator=">"></MudBreadcrumbs>

    <div class="mb-2 flex items-center justify-between gap-4">
            <div class="flex flex-col">
            <div class="flex items-center gap-4">
                <h1 class="leading-[3rem] h-12 text-3xl font-bold text-admin-default">Chi tiết đơn hàng</h1>
                    <span class="@GetOrderStatusClass(_orderDetail?.Status) rounded-full px-3 py-1 text-sm font-medium text-white">
                        @GetOrderStatusMessage(_orderDetail?.Status)
                    </span>
                </div>
                <span class="text-sm font-medium text-slate-500">Ngày đặt hàng: @_orderDetail?.OrderDate.ToString("dd/MM/yyyy HH:mm:ss")</span>
            </div>

            <div class="flex items-center gap-4">
                @if(_orderDetail != null && _orderDetail.Status == 0 && _orderDetail.IsPOS == true) {
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => ChangePaymentToCash(_orderDetail.OrderId))">Chuyển đổi thanh toán thành tiền mặt</MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="@(() => navigation.NavigateTo(_orderDetail.PaymentLink))">Thanh toán</MudButton>
                }
                @if (_orderDetail != null && ShouldShowButtons())
                {
                    @if (_orderDetail.Status == Constant.OrderStatus.StatusPending)
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => HandleStatusUpdate(Constant.OrderStatus.StatusPending))">Xác nhận</MudButton>
                    }
                    else if (_orderDetail.Status == Constant.OrderStatus.StatusConfirm)
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => HandleStatusUpdate(Constant.OrderStatus.StatusConfirm))">Giao cho đơn vị vận chuyển</MudButton>
                    }
                    else if (_orderDetail.Status == Constant.OrderStatus.StatusShipping)
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="@(() => HandleStatusUpdate(Constant.OrderStatus.StatusShipping, "success"))" Class="mr-2">Giao thành công</MudButton>
                        <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="@(() => HandleStatusUpdate(Constant.OrderStatus.StatusShipping, "failed"))">Giao thất bại</MudButton>
                    }
                    else if (_orderDetail.Status == Constant.OrderStatus.StatusShippingDone)
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="@(() => HandleStatusUpdate(Constant.OrderStatus.StatusShippingDone))">Hoàn thành</MudButton>
                    }
                }
            </div>
        </div>


    <div class="mt-6 space-y-6 rounded-[8px] bg-white p-8 shadow-[0_4px_12px_0_rgba(13,10,44,0.06)]">
        <h2 class="mb-4 text-xl font-medium">Thông tin đơn hàng</h2>
        <div class="mx-auto flex max-w-[1032px] flex-col gap-4">
            <div class="flex w-full flex-col gap-2 rounded-lg bg-slate-100 p-4">
                <div class="flex gap-5 bg-white px-4 py-4">
                    <label class="w-[11rem] flex-shrink-0 whitespace-pre-wrap text-base font-normal text-slate-600">Mã hóa đơn</label>
                    <div class="my-[1px] block self-stretch border-r border-slate-400" />
                    <span class="w-full whitespace-pre-wrap break-words text-base font-bold text-slate-900 sm:max-w-[calc(100%-201px)]">@_orderDetail?.OrderCode  <MudIcon Class="ml-1.5 cursor-pointer" Icon="@Icons.Material.Filled.ContentCopy" @onclick="@(() => CopyToClipboard(_orderDetail.OrderCode))" /></span>
                </div>
                <div class="flex gap-5 bg-white px-4 py-4">
                    <label class="w-[11rem] flex-shrink-0 whitespace-pre-wrap text-base font-normal text-slate-600">Địa chỉ nhận hàng</label>
                    <div class="my-[1px] block self-stretch border-r border-slate-400" />
                    <div class="text-sm">
                        @{
                            @if (_orderDetail != null)
                            {
                                if (_orderDetail.Address != null) 
                                {
                                    <p class="text-sm font-medium">@_orderDetail.Address?.Name <span>@((!string.IsNullOrEmpty(_orderDetail.Address?.Phone) ? " - " : ""))@_orderDetail.Address?.Phone</span></p>
                                    <p class="text-sm font-medium">
                                        @_orderDetail.Address.OtherInfo@((!string.IsNullOrEmpty(_orderDetail.Address.OtherInfo) && (!string.IsNullOrEmpty(_orderDetail.Address.Street) || !string.IsNullOrEmpty(_orderDetail.Address.District) || !string.IsNullOrEmpty(_orderDetail.Address.City)) ? ", " : ""))
                                        @_orderDetail.Address.Street@((!string.IsNullOrEmpty(_orderDetail.Address.Street) && (!string.IsNullOrEmpty(_orderDetail.Address.District) || !string.IsNullOrEmpty(_orderDetail.Address.City)) ? ", " : ""))
                                        @_orderDetail.Address.District@((!string.IsNullOrEmpty(_orderDetail.Address.District) && !string.IsNullOrEmpty(_orderDetail.Address.City) ? ", " : ""))
                                        @_orderDetail.Address.City
                                    </p>
                                } else 
                                {
                                    <span class="text-sm">@(_orderDetail.CustomerId == -1 && _orderDetail.IsPOS == true ? "Khách vãng lai mua tại quầy" : "")</span>
                                }
                            } else
                            {
                            }
                        }
                    </div>
                </div>
                <div class="flex gap-5 bg-white px-4 py-4">
                    <label class="w-[11rem] flex-shrink-0 whitespace-pre-wrap text-base font-normal text-slate-600">Phương thức thanh toán</label>
                    <div class="my-[1px] block self-stretch border-r border-slate-400" />
                    <span class="w-full whitespace-pre-wrap break-words text-base font-normal text-slate-900 sm:max-w-[calc(100%-201px)]">@(_orderDetail?.PaymentMethodId == Constant.PaymentMethod.CashBack ? "Tiền mặt" : "Chuyển khoản")</span>
                </div>
                <div class="flex gap-5 bg-white px-4 py-4">
                    <label class="w-[11rem] flex-shrink-0 whitespace-pre-wrap text-base font-normal text-slate-600">Khách Mua hàng</label>
                    <div class="my-[1px] block self-stretch border-r border-slate-400" />
                    <span class="w-full whitespace-pre-wrap break-words text-base font-normal text-slate-900 sm:max-w-[calc(100%-201px)]">@(_orderDetail?.CustomerId == -1 ? "Khách vãng lai" : "Khách Có tài khoản")</span>
                </div>
                <div class="flex gap-5 bg-white px-4 py-4">
                    <label class="w-[11rem] flex-shrink-0 whitespace-pre-wrap text-base font-normal text-slate-600">Mua hàng</label>
                    <div class="my-[1px] block self-stretch border-r border-slate-400" />
                    <span class="w-full whitespace-pre-wrap break-words text-base font-normal text-slate-900 sm:max-w-[calc(100%-201px)]">@(_orderDetail?.IsPOS == true ? "Tại quầy" : "Online")</span>
                </div>
                <div class="flex gap-5 bg-white px-4 py-4">
                    <label class="w-[11rem] flex-shrink-0 whitespace-pre-wrap text-base font-normal text-slate-600">Trạng thái thanh toán</label>
                    <div class="my-[1px] block self-stretch border-r border-slate-400" />
                    <span class="w-full whitespace-pre-wrap break-words text-base font-normal text-slate-900 sm:max-w-[calc(100%-201px)]">@_orderDetail?.PaymentStatus</span>
                </div>
                <div class="flex gap-5 bg-white px-4 py-4">
                    <label class="w-[11rem] flex-shrink-0 whitespace-pre-wrap text-base font-normal text-slate-600">Ghi chú</label>
                    <div class="my-[1px] block self-stretch border-r border-slate-400" />
                    <span class="w-full whitespace-pre-wrap break-words text-base font-normal text-slate-900 sm:max-w-[calc(100%-201px)]">@_orderDetail?.Note</span>
                </div>
            </div>
        </div>

        <MudDivider Class="my-6" />

        <h2 class="mb-4 text-xl font-medium">Thông tin sản phẩm đã mua</h2>
        @if (_orderDetail != null && _orderDetail.Items.Any())
        {
            <MudTable Bordered Elevation="0" CustomHeader HeaderClass="!py-6" ContainerClass="border border-solid border-slate-300" Items="@_orderDetail.Items" Loading="@_loading" Class="w-full" Dense="true" Hover="true" Virtualize="true" FixedHeader="true" HorizontalScrollbar="true">
                <HeaderContent>
                    <MudTh hidden><MudTableSortLabel SortLabel="OrderItemId" T="string" hidden>OrderItemId</MudTableSortLabel></MudTh>
                    <MudTh><MudTableSortLabel SortLabel="Ảnh" T="string">Ảnh</MudTableSortLabel></MudTh>
                    <MudTh><MudTableSortLabel SortLabel="Sản phẩm" T="string">Sản phẩm</MudTableSortLabel></MudTh>
                    <MudTh><MudTableSortLabel SortLabel="Số lượng" T="string">Số lượng</MudTableSortLabel></MudTh>
                    <MudTh><MudTableSortLabel SortLabel="Đơn giá" T="string">Đơn giá</MudTableSortLabel></MudTh>
                    <MudTh><MudTableSortLabel SortLabel="Thành tiền" T="string">Thành tiền</MudTableSortLabel></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="OrderItemId" hidden>@context.OrderItemId</MudTd>
                        <MudTd DataLabel="Ảnh">
                            @{
                                var productImage = _productImages.FirstOrDefault(i => i.ProductVariantId == context.ProductVariantId);
                                if (productImage != null)
                                {
                                    <MudImage Src="@productImage.ImageUrl" Width="100" />
                                }
                                else
                                {
                                    <MudImage Src="/Assets/Images/default-image.png" Width="100" />
                                }
                            }
                        </MudTd>
                        <MudTd DataLabel="Sản phẩm">
                            @context.ProductName @(context.Color != null ? $"- {context.Color}" : "") @(context.Size != null ? $"- {context.Size}" : "")
                        </MudTd>
                        <MudTd DataLabel="Số lượng">@context.Quantity</MudTd>
                        <MudTd DataLabel="Đơn giá">@context.UnitPrice.ToString("C", vietnameseCulture)</MudTd>
                        <MudTd DataLabel="Thành tiền">@((context.Quantity * context.UnitPrice).ToString("C", vietnameseCulture))</MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudText>Không có dữ liệu.</MudText>
                </NoRecordsContent>
                <LoadingContent>
                    <div class="flex w-full flex-col gap-3">
                        @{
                            for (var i = 0; i < Constant.DefaultSkeletons; i++)
                            {
                                <div class="flex items-center justify-between gap-2">
                                    <MudSkeleton Width="100%" Height="3rem" />
                                    <MudSkeleton Width="100%" Height="3rem" />
                                    <MudSkeleton Width="100%" Height="3rem" />
                                    <MudSkeleton Width="100%" Height="3rem" />
                                    <MudSkeleton Width="100%" Height="3rem" />
                                </div>
                            }
                        }
                    </div>
                </LoadingContent>
                <PagerContent>
                    <MudTablePager hidden HidePageNumber HidePagination HideRowsPerPage />
                </PagerContent>
            </MudTable>
        }
        else
        {
            <p>Không có đơn hàng nào.</p>
        }

        <div class="mt-6 flex justify-between gap-2 sm:flex-col">
            <div class="flex flex-col gap-2">
                <span class="w-full max-w-[200px] flex-shrink-0 text-sm font-bold">Lịch sử đơn hàng:</span>
                <span class="whitespace-pre-wrap text-sm">@GetHistoryOrder(_orderDetail?.StatusHistory)</span>
            </div>

            <div class="flex flex-col gap-4">
                <div class="flex w-[25rem] items-center gap-4 sm:w-full">
                    <span class="w-full max-w-[170px] flex-shrink-0 text-sm font-bold">Tổng tiền sản phẩm:</span>
                    <span class="max-w-[calc(100%-186px)] w-full whitespace-pre-wrap text-right text-sm">@_orderDetail?.TotalAmount.ToString("C", vietnameseCulture)</span>
                </div>
                <div class="flex w-[25rem] items-center gap-4 sm:w-full">
                    <span class="w-full max-w-[170px] flex-shrink-0 text-sm font-bold">Phí giao hàng:</span>
                    <span class="max-w-[calc(100%-186px)] w-full whitespace-pre-wrap text-right text-sm">@_orderDetail?.ShippingFee.ToString("C", vietnameseCulture)</span>
                </div>
                <div class="flex w-[25rem] items-center gap-4 sm:w-full">
                    <span class="w-full max-w-[170px] flex-shrink-0 text-sm font-bold">Giảm giá:</span>
                    <span class="max-w-[calc(100%-186px)] w-full whitespace-pre-wrap text-right text-sm">@_orderDetail?.DiscountAmount.ToString("C", vietnameseCulture)</span>
                </div>
                <div class="flex w-[25rem] items-center gap-4 sm:w-full">
                    <span class="w-full max-w-[170px] flex-shrink-0 text-sm font-bold">Tổng tiền thanh toán:</span>
                    <span class="max-w-[calc(100%-186px)] w-full whitespace-pre-wrap text-right text-sm">@_orderDetail?.FinalAmount.ToString("C", vietnameseCulture)</span>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public int id { get; set; }

    private DTOs.OrderDetailDTO _orderDetail = null;
    private List<DAL.Models.ProductImage> _productImages = [];
    private bool _loading = true;
    CultureInfo vietnameseCulture = new CultureInfo("vi-VN");

    private List<BreadcrumbItem> _items =
    [
        new("Trang Chủ", href: RouterConst.Admin.Home),
    new("Hóa Đơn", href: RouterConst.Admin.Bill),
    new("Hóa Đơn Chi Tiết", href: "#", disabled: true),
    ];

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
        _loading = false;
        StateHasChanged();
    }

    async Task LoadData()
    {
        var resOrderDetail = await _orderService.GetOrderDetailById(id);
        if (resOrderDetail.IsSuccess && resOrderDetail.Data != null)
        {
            _orderDetail = resOrderDetail.Data;
        }
        var resProductImages = await _productImageService.GetAll();
        if (resProductImages.IsSuccess && resProductImages.Data.Count() > 0)
        {
            _productImages = resProductImages.Data;
        }
    }

    private bool ShouldShowButtons()
    {
        if (_orderDetail == null || !_orderDetail.Status.HasValue)
            return false;

        var status = _orderDetail.Status.Value;
        return status == Constant.OrderStatus.StatusPending ||
               status == Constant.OrderStatus.StatusConfirm ||
               status == Constant.OrderStatus.StatusShipping ||
               status == Constant.OrderStatus.StatusShippingDone;
    }

    private async Task HandleStatusUpdate(byte currentStatus, string? action = null)
    {
        if (_orderDetail == null) return;

        byte newStatus;
        string successMessage;
        Severity severity = Severity.Success;

        switch (currentStatus)
        {
            case Constant.OrderStatus.StatusPending:
                newStatus = Constant.OrderStatus.StatusConfirm;
                successMessage = "Đã xác nhận đơn hàng thành công";
                break;

            case Constant.OrderStatus.StatusConfirm:
                newStatus = Constant.OrderStatus.StatusShipping;
                successMessage = "Đã giao đơn hàng cho đơn vị vận chuyển";
                break;

            case Constant.OrderStatus.StatusShipping:
                if (action == "success")
                {
                    newStatus = Constant.OrderStatus.StatusShippingDone;
                    successMessage = "Đã cập nhật trạng thái giao hàng thành công";
                }
                else if (action == "failed")
                {
                    newStatus = Constant.OrderStatus.StatusShippingFailed;
                    successMessage = "Đã cập nhật trạng thái giao hàng thất bại";
                    severity = Severity.Warning;
                }
                else
                {
                    return;
                }
                break;

            case Constant.OrderStatus.StatusShippingDone:
                newStatus = Constant.OrderStatus.StatusDone;
                successMessage = "Đã hoàn thành đơn hàng";
                break;

            default:
                return;
        }

        try
        {
            var newOrderUpdate = new OrderUpdateSatusModel();
            var token = await localStorage.GetItemAsStringAsync(Constant.TokenNameLocalStorage);
            newOrderUpdate.OrderId = _orderDetail.OrderId;
            newOrderUpdate.Status = newStatus;
            newOrderUpdate.PaymentStatus = _orderDetail.PaymentStatus;
            var orderMess = Constant.OrderStatusArray.FirstOrDefault(o => o.id == newStatus);
            newOrderUpdate.OrderStatus = orderMess != null ? orderMess.label : "Không xác định";

            if (_orderDetail.PaymentMethodId == Constant.PaymentMethod.CashBack 
                && currentStatus == Constant.OrderStatus.StatusShipping) {
                newOrderUpdate.PaymentStatus = "Đã thanh toán";
            }

            var result = await _orderService.UpdateStatus(newOrderUpdate, token ?? "");

            if (result.IsSuccess)
            {
                _snackbar.Add(successMessage, severity);
                await LoadData();
                StateHasChanged();
            }
            else
            {
                _snackbar.Add(result.ErrorMessage ?? "Có lỗi xảy ra khi cập nhật trạng thái", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            _snackbar.Add($"Lỗi: {ex.Message}", Severity.Error);
        }
    }

    string GetHistoryOrder(List<StatusHistoryEntry> histories)
    {
        if (histories == null || histories.Count == 0) return "";

        var result = "";

        foreach (var i in histories)
        {
            result += i.OrderStatus.ToString() + " vào lúc: " + i.DateTime.ToString();
            result += "\n";
        }
        return result;
    }

    private string GetOrderStatusMessage(byte? status)
    {
        if (!status.HasValue)
            return "Không xác định";

        var statusItem = Constant.OrderStatusArray.FirstOrDefault(s => s.id == status.Value);
        return statusItem?.label ?? "Không xác định";
    }

    private string GetOrderStatusClass(byte? status) =>
        status switch
        {
            Constant.OrderStatus.StatusNoCheckout => "bg-gray-200",
            Constant.OrderStatus.StatusPending => "bg-gray-400",
            Constant.OrderStatus.StatusConfirm => "bg-blue-500",
            Constant.OrderStatus.StatusCanceledByUser => "bg-red-500",
            Constant.OrderStatus.StatusShipping => "bg-gray-700",
            Constant.OrderStatus.StatusShippingDone => "bg-green-500",
            Constant.OrderStatus.StatusShippingFailed => "bg-red-500",
            Constant.OrderStatus.StatusDone => "bg-green-500",
            _ => "bg-gray-400"
        };

    private async Task CopyToClipboard(string code)
    {
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", code);
    }

    async Task ChangePaymentToCash(int orderId)
    {
        if (orderId <= 0) return;

        var result = await _orderService.ChangePaymentToCash(orderId);

        if (result.IsSuccess)
        {
            _snackbar.Add("Chuyển đổi thành công", Severity.Success);
            await LoadData();
        }
        else
        {
            if (result.ErrorMessage != null || result.ErrorMessage != "")
            {
                _snackbar.Add(result.ErrorMessage, Severity.Warning);
            }
            else
            {
                _snackbar.Add("CHuyển đổi thất bại. Vui lòng thử lại.", Severity.Warning);
            }
        }
    }
}
