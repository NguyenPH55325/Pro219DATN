@page "/admin/order/payment-cancelled"
@layout AdminLayout

<section class="flex h-screen w-full items-center justify-center">
    <div class="flex w-full flex-col items-center justify-center gap-4 p-6 text-center">
        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Class="!text-4xl" />
        <h2 class="text-2xl font-bold text-red-600">Thanh toán đã bị hủy!</h2>
        <div class="flex justify-center gap-3">
            <MudButton Variant="Variant.Outlined" Color="Color.Dark" OnClick="@(() => navigation.NavigateTo(RouterConst.Admin.Bill))">Danh sách hóa đơn</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Dark" OnClick="@(() => navigation.NavigateTo(RouterConst.Admin.SaleCounter))">Bán tại quầy</MudButton>
        </div>
    </div>
</section>

@code {
    [SupplyParameterFromQuery(Name = "order-id")]
    public int _orderId { get; set; } = 0;
    private int _parsedCartId = -1;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if(firstRender)
        {
            await LoadData();
        }
    }

    async Task LoadData()
    {
        var cartId = await localStorage.GetItemAsStringAsync(Constant.AuthCartIdLocalStorage) ?? string.Empty;
        var token = await localStorage.GetItemAsStringAsync(Constant.TokenNameLocalStorage) ?? string.Empty;
        if (_orderId > 0)
        {
            var result = await _orderService.PaymentCanceled(_orderId, true);

            if (int.TryParse(cartId, out _parsedCartId))
            {
                var result2 = await _cartItemService.GetAllCartItemWithDetailByCartId(_parsedCartId);

                if (result2.IsSuccess && result2.Data.Count() > 0 && !string.IsNullOrEmpty(token))
                {
                    foreach (var item in result2.Data)
                    {
                        await _cartItemService.Delete(item.Id, token);
                    }
                    await _cartStateService.LoadCartDetailsAsync();
                    StateHasChanged();
                }
            }
        }
    }
}
