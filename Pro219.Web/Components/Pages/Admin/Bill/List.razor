@page "/admin/orders"
@layout AdminLayout

<div class="p-6">
    <MudBreadcrumbs Class="!p-0 !text-sm" Items="_items" Separator=">"></MudBreadcrumbs>

    <div class="flex items-center justify-between">
        <h1 class="leading-[3rem] h-12 text-3xl font-bold text-admin-default">Danh sách hóa đơn</h1>
    </div>

    <div class="my-6 rounded-xl border border-slate-200 bg-white p-8 shadow-sm">
        <div class="grid w-full grid-cols-3 gap-x-6 gap-y-4">
            <div>
                <MudTextField T="string" Placeholder="Tìm kiếm" Adornment="Adornment.Start" Value="@_searchValue"
                              AdornmentIcon="@Icons.Material.Filled.Search" Variant="Variant.Outlined" IconSize="Size.Medium" Class="mt-0" ValueChanged="onChangeSearch" Immediate=true></MudTextField>
            </div>
            <div class="flex items-center gap-2">
                <MudButton Variant="Variant.Outlined" OnClick="OnSearch" Class="h-14 w-full"><MudIcon Icon="@Icons.Material.Filled.Search" Class="mr-2" /> Tìm kiếm</MudButton>
                <MudButton Variant="Variant.Outlined" OnClick="OnReset" Class="h-14 w-full"><MudIcon Icon="@Icons.Material.Filled.Filter" Class="mr-2" /> Đặt lại</MudButton>
            </div>
        </div>
    </div>

    <div class="mt-6 w-full rounded-xl border border-slate-200 bg-white p-8 shadow-sm">
        <MudTable Bordered Items="@_orders" Loading="@_loading" Dense="true" Hover="true" Virtualize="true" FixedHeader="true" HorizontalScrollbar="true" Height="calc(100lvh - 20.5rem)">
            <HeaderContent>
                <MudTh hidden><MudTableSortLabel SortLabel="OrderId" T="string" hidden>OrderId</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="Mã hóa đơn" T="string">Mã hóa đơn</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="Ngày đặt hàng" T="string">Ngày đặt hàng</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="Địa chỉ nhận hàng" T="string">Địa chỉ nhận hàng</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="Phương thức thanh toán" T="string">Phương thức thanh toán</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="Trạng thái thanh toán" T="string">Trạng thái thanh toán</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="Trạng thái hóa đơn" T="string">Trạng thái hóa đơn</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="Chi tiết" T="string">Chi tiết</MudTableSortLabel></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="OrderId" hidden>@context.OrderId</MudTd>
                <MudTd DataLabel="Mã hóa đơn">@context.OrderCode</MudTd>
                <MudTd DataLabel="Địa chỉ nhận hàng">@context.OrderDate.ToString("dd/MM/yyyy HH:mm:ss")</MudTd>
                <MudTd DataLabel="Ngày đặt hàng">
                    @{
                        var address = _addresses.FirstOrDefault(a => a.Id == context.ShippingAddressId);

                        if (address != null)
                        {
                            <div>
                                <p class="text-sm font-medium">@address?.FullName <span class="text-slate-500">@((!string.IsNullOrEmpty(address?.Phone) ? " - " : ""))@address?.Phone</span></p>
                                <p class="text-sm font-medium">
                                    @address?.OtherInfo@((!string.IsNullOrEmpty(address?.OtherInfo) && (!string.IsNullOrEmpty(address?.StreetName) || !string.IsNullOrEmpty(address?.DistrictName) || !string.IsNullOrEmpty(address?.CityName)) ? ", " : ""))
                                    @address?.StreetName@((!string.IsNullOrEmpty(address?.StreetName) && (!string.IsNullOrEmpty(address?.DistrictName) || !string.IsNullOrEmpty(address?.CityName)) ? ", " : ""))
                                    @address?.DistrictName@((!string.IsNullOrEmpty(address?.DistrictName) && !string.IsNullOrEmpty(address?.CityName) ? ", " : ""))
                                    @address?.CityName
                                </p>
                            </div>
                        }
                    }
                </MudTd>
                <MudTd DataLabel="Phương thức thanh toán">@(context.PaymentMethodId == Constant.PaymentMethod.CashBack ? "Tiền mặt" : "Chuyển khoản")</MudTd>
                <MudTd DataLabel="Trạng thái thanh toán">@context.PaymentStatus</MudTd>
                <MudTd DataLabel="Trạng thái hóa đơn">
                    <MudBadge Variant="Variant.Filled" Color="@(GetOrderStatusColor(context.Status))" Content="@context.OrderStatus" />
                </MudTd>
                <MudTd DataLabel="Trạng thái hóa đơn">
                    <MudIconButton OnClick=@(() => navigation.NavigateTo(RouterConst.Admin.BillDetail.Replace(":id", context.OrderId.ToString()))) Icon="@Icons.Material.Filled.Menu" />
                    <MudIconButton OnClick=@(() => DowloadPDF(context.OrderId)) Icon="@Icons.Material.Filled.Download" Disabled="@(context.Status != Constant.OrderStatus.StatusDone)" />
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText>Không có dữ liệu.</MudText>
            </NoRecordsContent>
            <LoadingContent>
                <div class="flex w-full flex-col gap-3">
                    @{
                        for (var i = 0; i < Constant.DefaultSkeletons; i++)
                        {
                            <div class="flex items-center justify-between gap-2">
                                <MudSkeleton Width="100%" Height="3rem" />
                                <MudSkeleton Width="100%" Height="3rem" />
                                <MudSkeleton Width="100%" Height="3rem" />
                                <MudSkeleton Width="100%" Height="3rem" />
                                <MudSkeleton Width="100%" Height="3rem" />
                                <MudSkeleton Width="100%" Height="3rem" />
                            </div>
                        }
                    }
                </div>
            </LoadingContent>
            <PagerContent>
                <MudTablePager />
            </PagerContent>
        </MudTable>
    </div>
</div>

@code {
    private List<DAL.Models.Order> _orders = [];
    private List<DAL.Models.Address> _addresses = [];

    private string _searchValue = string.Empty;
    private bool _loading = true;

    private List<BreadcrumbItem> _items =
    [
        new("Trang Chủ", href: RouterConst.Admin.Home),
        new("Hóa Đơn", href: "#", disabled: true),
    ];

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
        _loading = false;
        StateHasChanged();
    }

    private async Task LoadData()
    {
        var resOrder = await _orderService.GetAll(_searchValue);
        var resAsddress = await _addressService.GetAll();

        if(resOrder.IsSuccess && resOrder.Data.Count() > 0)
        {
            _orders = resOrder.Data;
        }

        if (resAsddress.IsSuccess && resAsddress.Data.Count() > 0)
        {
            _addresses = resAsddress.Data;
        }
    }

    private async Task onChangeSearch(string value)
    {
        _searchValue = value;
    }

    private async Task OnSearch()
    {
        await LoadData();
    }

    private async Task OnReset()
    {
        _searchValue = string.Empty;
        await LoadData();
    }

    private async Task DowloadPDF(int id)
    {
        _loading = true;

        var result = await _orderService.GetInvoicePdf(id);

        if (result.IsSuccess)
        {
            var base64 = Convert.ToBase64String(result.Data);
            var orderCode = _orders.FirstOrDefault(o => o.OrderId == id)?.OrderCode ?? id.ToString();

            await JS.InvokeVoidAsync("downloadFile", "application/pdf", base64, $"hoadon_{orderCode}.pdf");

            _snackbar.Add("Tải hóa đơn thành công!", Severity.Success);
        }
        else
        {
            _snackbar.Add($"Lỗi: {result.ErrorMessage}", Severity.Error);
        }

        _loading = false;
        StateHasChanged();
    }

    private Color GetOrderStatusColor(byte? Status) =>
    Status switch
    {
        Constant.OrderStatus.StatusPending => Color.Dark,
        Constant.OrderStatus.StatusConfirm => Color.Info,
        Constant.OrderStatus.StatusCanceledByUser => Color.Error,
        Constant.OrderStatus.StatusShipping => Color.Primary,
        Constant.OrderStatus.StatusShippingDone => Color.Tertiary,
        Constant.OrderStatus.StatusShippingFailed => Color.Error,
        Constant.OrderStatus.StatusDone => Color.Success,
        _ => Color.Dark
    };
}