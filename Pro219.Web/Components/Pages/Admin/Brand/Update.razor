@page "/admin/brands/edit/{id:int}"
@layout AdminLayout

<div class="p-6">
    <MudBreadcrumbs Class="!p-0 !text-sm" Items="_items" Separator=">"></MudBreadcrumbs>

    <h1 class="leading-[3rem] h-12 text-3xl font-bold text-admin-default">Sửa thương hiệu</h1>

    <div class="mx-auto mt-6 w-full rounded-lg bg-white p-8 shadow-sm">
        <EditForm Model="_model" OnValidSubmit="OnSubmit" class="mx-auto flex w-full flex-col gap-4">
            <DataAnnotationsValidator />

            <div class="mx-auto flex w-full max-w-[64.5rem] gap-6 rounded-lg bg-slate-100 px-6 py-4">
                <span Class="w-44 flex-shrink-0 pt-4 text-base font-medium text-gray-900">Tên</span>
                <MudTextField @bind-Value="@_model.Name" For="@(() => _model.Name)" Placeholder="Krik" Variant="Variant.Outlined" FullWidth Style="background-color: white" />
            </div>

            <div class="mx-auto flex w-full max-w-[64.5rem] gap-6 rounded-lg bg-slate-100 px-6 py-4">
                <span Class="w-44 flex-shrink-0 pt-4 text-base font-medium text-gray-900">Mô tả</span>
                <MudTextField @bind-Value="@_model.Description" For="@(() => _model.Description)" Placeholder="mô tả thương hiệu" Variant="Variant.Outlined" Style="background-color: white" FullWidth />
            </div>

            <div class="mx-auto flex w-full max-w-[64.5rem] gap-6 rounded-lg bg-slate-100 px-6 py-4">
                <span Class="w-44 flex-shrink-0 pt-4 text-base font-medium text-gray-900">Trạng thái</span>

                <MudRadioGroup @bind-Value="@_isActive" For="@(() => _isActive)">
                    <MudRadio Value="1" Color="Color.Primary">Hoạt động</MudRadio>
                    <MudRadio Value="0" Color="Color.Primary">Ngừng Hoạt động</MudRadio>
                </MudRadioGroup>
            </div>

            <div class="flex items-center justify-center gap-4">
                <MudButton Href="@RouterConst.Admin.Brand" Color="Color.Surface" Variant="Variant.Filled" ButtonType="ButtonType.Button" Class="w-fit px-10">Quay lại</MudButton>
                <MudButton Color="Color.Primary" Variant="Variant.Filled" ButtonType="ButtonType.Submit" Disabled="@_isSubmitting" Class="w-fit px-10">Sửa</MudButton>
            </div>
        </EditForm>
    </div>
</div>

@code {
    [Parameter]
    public int id { get; set; }

    BrandModel _model = new BrandModel();
    private int _isActive;
    private bool _isSubmitting = false;
    private string _token = string.Empty;

    private List<BreadcrumbItem> _items =
    [
        new("Trang Chủ", href: RouterConst.Admin.Home),
    new("Thương Hiệu", href: RouterConst.Admin.Brand),
    new("Sửa Thương Hiệu", href: "#", disabled: true),
    ];

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _token = await localStorage.GetItemAsStringAsync(Constant.TokenNameLocalStorage);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var size = await _brandService.GetById(id);
        var data = size.Data;
        if (data != null)
        {
            _model.Id = data.Id;
            _model.Name = data.Name;
            _model.Description = data.Description;
            _model.Status = data.Status;
            _isActive = data.Status != null ? (int)data.Status : -1;
        }
    }

    async Task OnSubmit()
    {
        if (_isSubmitting) return;
        if(_isActive == -1)
        {
            _snackbar.Add("Vui lòng chọn trạng thái (Hoạt động/Ngừng Hoạt động)", Severity.Error);
            return;
        }
        try
        {
            _isSubmitting = true;
            _model.Status = (byte)_isActive;
            _model.Name = _model.Name.Trim();
            _model.Description = _model.Description.Trim();
            var result = await _brandService.Edit(_model, _token);

            if (result.IsSuccess)
            {
                _snackbar.Add("Sửa thành công", Severity.Success);
                navigation.NavigateTo(RouterConst.Admin.Brand);
            }
            else
            {
                _snackbar.Add("Sửa thất bại", Severity.Warning);
            }
        } catch(Exception ex) {}
        finally
        {
            _isSubmitting = false;
        }
    }
}