@page "/admin/sizes"
@layout AdminLayout

<div class="p-6">
    <MudBreadcrumbs Class="!p-0 !text-sm" Items="_items" Separator=">"></MudBreadcrumbs>

    <div class="flex items-center justify-between">
        <h1 class="leading-[3rem] h-12 text-3xl font-bold text-admin-default">Danh kích thước</h1>
        <a href="@RouterConst.Admin.CreateSize" class="leading-[1.5rem] h-10 rounded-lg bg-admin-default px-6 py-2 text-white">Tạo mới</a>
    </div>

    <div class="my-6 rounded-xl border border-slate-200 bg-white p-8 shadow-sm">
        <div class="grid w-full grid-cols-3 gap-x-6 gap-y-4">
            <div>
                <MudTextField T="string" Placeholder="Tìm kiếm" Adornment="Adornment.Start" Value="@_searchValue"
                              AdornmentIcon="@Icons.Material.Filled.Search" Variant="Variant.Outlined" IconSize="Size.Medium" Class="mt-0" ValueChanged="onChangeSearch" Immediate=true></MudTextField>
            </div>
        </div>
        <div>
            <MudButton Variant="Variant.Outlined" OnClick="OnReset" Class="h-14 w-full"><MudIcon Icon="@Icons.Material.Filled.Filter" /> Đặt lại bộ lọc</MudButton>
        </div>
    </div>

    <div class="w-full rounded-xl border border-slate-200 bg-white p-8 shadow-sm">
        <MudTable Bordered Items="@_lstSize" Loading="@_loading" Dense="true" Hover="true" Virtualize="true" FixedHeader="true" HorizontalScrollbar="true" Height="calc(100lvh - 20.5rem)">
            <HeaderContent>
                <MudTh hidden><MudTableSortLabel SortLabel="Id câu hỏi" T="string" hidden>STT</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="Tên" T="string">Tên</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="Trạng thái" T="string">Trạng thái</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="Thao tác" T="string">Thao tác</MudTableSortLabel></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Id đáp án" hidden>@context.Id</MudTd>
                <MudTd DataLabel="Tên">@context.Name</MudTd>
                <MudTd DataLabel="Trạng thái">@(context?.Status == Convert.ToByte(Constant.StatusDefault.Active) ? "Hoạt Động" : "Không Hoạt Động")</MudTd>
                <MudTd DataLabel="Thao tác">
                    <MudIconButton Icon="@Icons.Material.Filled.BorderColor" aria-label="update" Href="@($"{RouterConst.Admin.EditSize}/{context.Id}")"></MudIconButton>
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" aria-label="delete" OnClick="@(() => OpenDialogDelete(context.Id))"></MudIconButton>
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText>Không có dữ liệu.</MudText>
            </NoRecordsContent>
            <LoadingContent>
                <div class="flex w-full flex-col gap-3">
                    @{
                        for(var i = 0; i < 5; i++)
                        { 
                            <div class="flex items-center justify-between gap-2">
                                <MudSkeleton Width="100%" Height="3rem" />
                                <MudSkeleton Width="100%" Height="3rem" />
                                <MudSkeleton Width="100%" Height="3rem" />
                            </div>
                        }
                    }
                </div>
            </LoadingContent>
            <PagerContent>
                <MudTablePager />
            </PagerContent>
        </MudTable>
    </div>
</div>

@code {
    private CancellationTokenSource? _cts;
    private List<DAL.Models.Size> _lstSize = [];
    private readonly DialogOptions _maxWidth = new() { MaxWidth = MaxWidth.Large, FullWidth = true };

    private string _searchValue = string.Empty;
    private bool _loading = true;

    private List<BreadcrumbItem> _items =
    [
        new("Trang Chủ", href: RouterConst.Admin.Home),
        new("Kích Thước", href: "#", disabled: true),
    ];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await LoadData();
        } catch (Exception e)
        {
            _loading = false;
        } finally
        {
            _loading = false;
        }
    }

    async Task LoadData()
    {
        var res = await _sizeService.GetAll();
        var data = res.Data;
        if(res.IsSuccess && data != null)
        {
            _lstSize = data;
        }
        StateHasChanged();
    }

    private async Task onChangeSearch(string value)
    {
        _searchValue = value;

        if (string.IsNullOrEmpty(value))
        {
            // await LoadData();
            return;
        }

        _cts?.Cancel();
        _cts = new CancellationTokenSource();

        try
        {
            await Task.Delay(700, _cts.Token);

            _snackbar.Add($"Đang tìm kiếm: {value}", Severity.Info);
        }
        catch (TaskCanceledException)
        {
        }
    }

    async Task OpenDialogDelete(int id)
    {
        var deleteParaeters = new DialogParameters<Admin.Size.ConfirmDeleteDialog>
        {
            {x => x.id, id}
        };

        var dialog = await _dialogService.ShowAsync<Admin.Size.ConfirmDeleteDialog>("Options Dialog", deleteParaeters, _maxWidth);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            await LoadData();
            StateHasChanged();
        }
    }

    private async Task OnReset()
    {
        _searchValue = string.Empty;
    }
}