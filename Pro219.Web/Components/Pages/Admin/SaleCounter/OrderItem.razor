<div>
    <div>
        <MudButton Class="!items-center !bg-admin-default !px-5 !text-white" OnClick="OpenDialogProduct"><MudIcon Icon="@Icons.Material.Filled.Add" Class="mr-2" /> Chọn sản phẩm</MudButton>
    </div>
    @if(_orderItems.Any())
    {
        <div class="mt-8 max-h-[700px] w-full overflow-y-auto">
            @foreach(var item in _orderItems)
            {
                <div class="flex w-full flex-col items-start gap-4 py-5 lg:flex-row lg:items-center">
                    <div class="max-h-full max-w-full flex-shrink-0 lg:max-h-[7.5rem] lg:max-w-[7.5rem]">
                        <a>
                            <img src="@Constant.DefaultImages" alt="product" />
                        </a>
                    </div>
                    <div class="flex max-w-none flex-shrink-0 flex-col lg:max-w-[calc(100%-26.5rem)]">
                        <a>@item.ProductName</a>
                        <button class="w-fit p-2 text-xs text-slate-500 hover:text-red-500" @onclick="@(() => DeleteProductInItems(item.ProductVariantId))">Xóa</button>
                    </div>
                    <div class="flex w-28">
                        <div class="flex h-[1.875rem] w-[1.875rem] cursor-pointer items-center justify-center border-y border-l">
                            <MudIcon Class="!h-4 !w-4" Icon="@Icons.Material.Filled.Remove" Size="Size.Small" @onclick="@(() => UpdateQuantity(item, false))" />
                        </div>

                        <span class="flex h-[1.875rem] w-10 items-baseline justify-center border bg-gray-50 p-1">@item.Quantity</span>

                        <div class="flex h-[1.875rem] w-[1.875rem] cursor-pointer items-center justify-center border-y border-r">
                            <MudIcon Class="!h-4 !w-4" Icon="@Icons.Material.Filled.Add" Size="Size.Small" @onclick="@(() => UpdateQuantity(item, true))" />
                        </div>
                    </div>

                    <span class="w-40 flex-shrink-0 whitespace-pre-wrap">@item.UnitPrice.ToString("C", vietnameseCulture)</span>
                </div>
            }
        </div>
    }else
    {
        <div class="flex flex-col items-center justify-center py-20">
            <img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcSjSsgl_3i4kM0HTfpCFvNz90eAGcTAqApLMw&s" width="400" alt="no product"/>
            <p class="text-center">Không có sản phẩm nào</p>
        </div>
    }

    <MudDivider Class="my-8" />

    <div>
        <div class="item flex justify-between gap-6">
            <h2 class="text-2xl font-bold">Tài khoản</h2>
            <div class="flex items-center gap-4">
                <MudButton Variant="Variant.Filled" hidden="@(Order.CustomerId == -1)" OnClick="SetToGuest" Class="!items-center !px-5 !text-white" Color="Color.Error"><MudIcon Icon="@Icons.Material.Filled.Remove" Class="mr-2" />Khách vãng lai</MudButton>
                <MudButton OnClick="OpenDialogCustomer" Class="!items-center !bg-admin-default !px-5 !text-white"><MudIcon Icon="@Icons.Material.Filled.Add" Class="mr-2" /> Chọn tài khoản</MudButton>
            </div>
        </div>

        <div class="mt-4 pl-4">
            <div class="flex items-center gap-1.5 sm:flex-col sm:items-start lg:gap-4">
                <span class="w-full max-w-[200px] flex-shrink-0 text-base font-medium">Họ tên</span>
                <span class="text-base font-normal">: @(_customer != null && Order.CustomerId != -1 ? _customer.FullName : "Khách vãng lai")</span>
            </div>
            @if (Order.CustomerId != -1 && _customer != null)
            {

                <div class="flex items-center gap-1.5 sm:flex-col sm:items-start lg:gap-4">
                    <span class="w-full max-w-[200px] flex-shrink-0 text-base font-medium">Số điện thoại</span>
                    <span class="text-base font-normal">: @_customer.PhoneNumber</span>
                </div>
                <div class="flex items-center gap-1.5 sm:flex-col sm:items-start lg:gap-4">
                    <span class="w-full max-w-[200px] flex-shrink-0 text-base font-medium">Email</span>
                    <span class="text-base font-normal">: @_customer.Email</span>
                </div>
            }
        </div>
    </div>

    <MudDivider Class="my-8" />

    <div>
        <h2 class="text-2xl font-bold">Khách hàng</h2>

        <div class="mt-4 flex justify-between gap-20">
            <div class="max-w-[calc(100%-40rem)] w-full">
                @if (_isShipping)
                {
                    <h3 class="text-lg font-bold">Thông tin giao hàng</h3>
                    <MudDivider Class="my-5" />

                    <div class="flex w-full flex-col gap-4">
                        @if (Order.CustomerId != -1) 
                        {
                            <MudRadioGroup Disabled="_isDisabledAddressUse" T="int" Value="_isUseCurrentAddress" ValueChanged="ChangeAddressUse">
                                <div class="flex items-center justify-end gap-4">
                                    <MudRadio Value="1">
                                        Sử dụng địa chỉ hiện tại
                                    </MudRadio>
                                    <MudRadio Value="0">
                                        Sử dụng địa chỉ khác
                                    </MudRadio>
                                </div>
                            </MudRadioGroup>
                        }
                        <MudTextField @bind-Value="@_defaultAddress.FullName" For="@(() => _defaultAddress.FullName)" Variant="Variant.Outlined" Placeholder="Họ và tên" FullWidth="true" />
                        <MudTextField @bind-Value="@_defaultAddress.Phone" For="@(() => _defaultAddress.Phone)" Variant="Variant.Outlined" Placeholder="Số điện thoại" FullWidth="true" />

                        <div class="grid w-full grid-cols-3 gap-4">
                            <MudSelect T="int" Value="@_selectedProvince" ValueChanged="OnProvinceChanged" Label="Tỉnh/Thành phố" Variant="Variant.Outlined">
                                <MudSelectItem Value="0">Vui lòng chọn</MudSelectItem>
                                @if (_provinces.Any())
                                {

                                    @foreach (var city in _provinces)
                                    {
                                        <MudSelectItem Value="@city.ProvinceID">@city.ProvinceName</MudSelectItem>
                                    }
                                }
                            </MudSelect>

                            <MudSelect T="int" Value="@_selectedDistrict" ValueChanged="OnDistrictChanged" Label="Quận/Huyện" Variant="Variant.Outlined" Disabled="@(!_districts.Any())">
                                <MudSelectItem Value="0">Vui lòng chọn</MudSelectItem>
                                @if (_districts.Any())
                                {
                                    @foreach (var city in _districts)
                                    {
                                        <MudSelectItem Value="@city.DistrictID">@city.DistrictName</MudSelectItem>
                                    }
                                }
                            </MudSelect>

                            <MudSelect T="string" Value="@_selectedWard" ValueChanged="OnWardChanged" Label="Phường/Xã" Variant="Variant.Outlined" Disabled="@(!_wards.Any())">
                                <MudSelectItem T="string" Value="0.ToString()">Vui lòng chọn</MudSelectItem>
                                @if (_wards.Any())
                                {
                                    foreach (var city in _wards)
                                    {
                                        <MudSelectItem T="string" Value="@(city.WardCode.ToString())">@city.WardName</MudSelectItem>
                                    }
                                }
                            </MudSelect>
                        </div>

                        <MudTextField @bind-Value="@_defaultAddress.OtherInfo" For="@(() => _defaultAddress.OtherInfo)" Variant="Variant.Outlined" Placeholder="Địa chỉ chi tiết" FullWidth="true" />

                        <MudTextField @bind-Value="@_note" For="@(() => _note)" Variant="Variant.Outlined" Placeholder="Ghi chú" FullWidth="true" />
                    </div>
                }
            </div>
            <div class="flex w-[35rem] flex-col gap-5">
                <h3 class="text-lg font-bold">Thông tin thanh toán</h3>
                <MudDivider />
                <div class="flex items-center justify-between gap-4">
                    <span class="w-full max-w-[200px] flex-shrink-0 text-base font-medium">Phương thức thanh toán:</span>
                    <MudRadioGroup T="int" @bind-Value="_paymentMethod">
                        <div class="flex items-center justify-end gap-4">
                            <MudRadio Value="Constant.PaymentMethod.CashBack">
                                Tiền mặt
                            </MudRadio>
                            <MudRadio Value="Constant.PaymentMethod.CashBack">
                                Chuyển khoản
                            </MudRadio>
                        </div>
                    </MudRadioGroup>
                </div>
                <div class="flex items-center justify-between gap-4">
                    <span class="w-full max-w-[200px] flex-shrink-0 text-base font-medium">Mã giảm giá:</span>
                    <div class="max-w-[calc(100%-186px)] flex w-full items-center gap-2">
                        <MudTextField T="string" Disabled Variant="Variant.Outlined" Value="@_discountCode" />
                        <MudIcon Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Class="cursor-pointer" hidden="@(string.IsNullOrEmpty(_discountCode))" @onclick="RemoveDiscount" />
                        <MudButton OnClick="OpenDialogDiscountCode" Disabled="@(_totalProductAmount == 0)" Variant="Variant.Outlined">Chọn mã</MudButton>
                    </div>
                </div>
                <div class="flex w-full items-center gap-4">
                    <span class="w-full max-w-[170px] flex-shrink-0 text-base font-medium">Giao hàng:</span>
                    <div class="max-w-[calc(100%-186px)] flex w-full justify-end"><MudSwitch Color="Color.Primary" T="bool" ValueChanged="OnShipping" Value="_isShipping" /></div>
                </div>
                <div class="flex w-full items-center gap-4">
                    <span class="w-full max-w-[170px] flex-shrink-0 text-base font-medium">Tổng tiền sản phẩm:</span>
                    <span class="max-w-[calc(100%-186px)] w-full whitespace-pre-wrap text-right text-base">@_totalProductAmount.ToString("C", vietnameseCulture)</span>
                </div>
                @if (_isShipping)
                {
                    <div class="flex w-full items-center gap-4">
                        <span class="w-full max-w-[170px] flex-shrink-0 text-base font-medium">Phí giao hàng:</span>
                        <div class="max-w-[calc(100%-186px)] w-full whitespace-pre-wrap text-right text-base">
                            <MudTextField T="decimal" @bind-Value="_shippingAmount" InputType="InputType.Number" Variant="Variant.Outlined" />
                        </div>
                    </div>
                }
                <div class="flex w-full items-center gap-4">
                    <span class="w-full max-w-[170px] flex-shrink-0 text-base font-medium">Giảm giá:</span>
                    <span class="max-w-[calc(100%-186px)] w-full whitespace-pre-wrap text-right text-base">@_discountAmount.ToString("C", vietnameseCulture)</span>
                </div>
                <div class="flex w-full items-center gap-4">
                    <span class="w-full max-w-[170px] flex-shrink-0 text-base font-medium">Tổng tiền thanh toán:</span>
                    <span class="max-w-[calc(100%-186px)] w-full whitespace-pre-wrap text-right text-base">@(TotalPaymentAmount.ToString("C", vietnameseCulture))</span>
                </div>
            </div>
        </div>
    </div>
</div>
@code {
    [Parameter]
    public DAL.Models.Order Order { get; set; } = new DAL.Models.Order();

    [Parameter]
    public string Token { get; set; } = string.Empty;

    private DAL.Models.Address _defaultAddress = new DAL.Models.Address();
    private List<CheckoutListItem >_orderItems = new List<CheckoutListItem>();
    private DAL.Models.Customer _customer = new DAL.Models.Customer();
    List<DAL.Models.Order> _orders = [];
    List<ProvinceDTO> _provinces = [];
    List<DistrictDTO> _districts = [];
    List<WardDTO> _wards = [];

    private int _selectedProvince = 0;
    private int _selectedDistrict = 0;
    private string _selectedWard = string.Empty;
    private string _note = string.Empty;
    private bool _isShipping = false;
    private int _isUseCurrentAddress = 1;
    private bool _isDisabledAddressUse = false;
    private decimal _shippingAmount = 0;
    private decimal _totalProductAmount = 0;
    private decimal _discountAmount = 0;
    private string _discountCode = string.Empty;
    private int _paymentMethod = Constant.PaymentMethod.CashBack;

    private readonly DialogOptions _maxWidth = new() { MaxWidth = MaxWidth.Large, FullWidth = true };
    CultureInfo vietnameseCulture = new CultureInfo("vi-VN");

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if(firstRender)
        {
            await LoadData();
            await LoadOrderItems();
            StateHasChanged();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var resProvince = await _addressService.GetAllProvince();
        if (resProvince.IsSuccess) _provinces = resProvince.Data ?? new();
    }

    private async Task LoadData()
    {
        if(Order.CustomerId != -1)
        {
            var resCustomer = await _customerService.GetById(Order.CustomerId ?? 1);

            if(resCustomer.IsSuccess && resCustomer.Data != null)
            {
                _customer = resCustomer.Data;
            }
        }
    }

    private async Task LoadOrderItems()
    {
        var orderItems = await localStorage.GetItemAsStringAsync(Constant.OrderPOSTemp);
        if (!string.IsNullOrEmpty(orderItems))
        {
            var deserializedData = JsonSerializer.Deserialize<List<OrderTempPOS>>(orderItems);

            if (deserializedData != null && deserializedData.Any())
            {
                var objOrder = deserializedData.FirstOrDefault(x => x.OrderId == Order.OrderId);

                if (objOrder != null)
                {
                    if(objOrder.ListItem.Any()) {
                        _orderItems = objOrder.ListItem;
                        _totalProductAmount = objOrder.ListItem.Sum(x => x.Subtotal) ?? 0;
                    }

                    if (objOrder.discountObj != null)
                    {
                        _discountCode = objOrder.discountObj.DiscountCode;
                        _discountAmount = _totalProductAmount > objOrder.discountObj.DiscountAmount ? objOrder.discountObj.DiscountAmount : _totalProductAmount;
                    }
                }
            }
        }
    }

    async Task LoadAddress()
    {
        if (Order.CustomerId != -1)
        {
            var resAddress = await _addressService.GetAllByCustomerId(Order.CustomerId ?? -1);
            if (resAddress.IsSuccess && resAddress.Data.Any())
            {
                var obj = resAddress.Data.FirstOrDefault(x => x.IsDefault) ?? resAddress.Data.First();

                if (obj != null)
                {
                    _defaultAddress = obj;
                    _isDisabledAddressUse = false;

                    var province = _provinces.FirstOrDefault(x => x.ProvinceID.ToString() == obj.City);
                    if (province != null)
                    {
                        _selectedProvince = province.ProvinceID;
                        await LoadDistricts(_selectedProvince);

                        var district = _districts.FirstOrDefault(x => x.DistrictID.ToString() == obj.District);
                        if (district != null)
                        {
                            _selectedDistrict = district.DistrictID;
                            await LoadWards(_selectedDistrict);

                            var ward = _wards.FirstOrDefault(x => x.WardCode == obj.Street);
                            if (ward != null)
                            {
                                _selectedWard = ward.WardCode;
                            }
                        }
                    }
                }
            }
        }
        await GetShippingFeeAsync();
        StateHasChanged();
    }

    private async Task OnProvinceChanged(int provinceId)
    {
        _selectedProvince = provinceId;
        _defaultAddress.City = provinceId.ToString();
        _defaultAddress.CityName = _provinces.FirstOrDefault(x => x.ProvinceID == provinceId)?.ProvinceName ?? "";

        _selectedDistrict = 0;
        _defaultAddress.District = string.Empty;
        _selectedWard = string.Empty;
        _defaultAddress.Street = string.Empty;
        _wards = new();

        await LoadDistricts(provinceId);
    }

    private async Task OnDistrictChanged(int districtId)
    {
        _selectedDistrict = districtId;
        _defaultAddress.District = districtId.ToString();
        _defaultAddress.DistrictName = _districts.FirstOrDefault(x => x.DistrictID == districtId)?.DistrictName ?? "";
        _selectedWard = string.Empty;
        _defaultAddress.Street = string.Empty;
        await LoadWards(districtId);
    }

    private async Task OnWardChanged(string wardId)
    {
        _selectedWard = wardId;
        _defaultAddress.Street = wardId;
        _defaultAddress.StreetName = _wards.FirstOrDefault(x => x.WardCode == wardId)?.WardName ?? "";
        await GetShippingFeeAsync();
        StateHasChanged();
    }

    async Task OnShipping(bool isShipping)
    {
        _isShipping = isShipping;
        if (!isShipping)
        {
            _shippingAmount = 0;
        }

        await LoadAddress();
    }


    async Task OpenDialogProduct()
    {
        var paraeters = new DialogParameters<Admin.SaleCounter.ProductChoiceDialog>
        {
            {x => x.OrderId, Order.OrderId},
        };
        var dialog = await _dialogService.ShowAsync<Admin.SaleCounter.ProductChoiceDialog>("Options Dialog", paraeters, _maxWidth);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            await LoadOrderItems();
            await GetShippingFeeAsync();
            StateHasChanged();
        }
    }

    async Task OpenDialogCustomer()
    {
        var paraeters = new DialogParameters<Admin.SaleCounter.CustomerChoiceDialog>
        {
            {x => x.Order, Order},
            {x => x.Token, Token}
        };

        var dialog = await _dialogService.ShowAsync<Admin.SaleCounter.CustomerChoiceDialog>("Options Dialog", paraeters, _maxWidth);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            await LoadData();
            await LoadAddress();
            StateHasChanged();
        }
    }

    async Task OpenDialogDiscountCode()
    {
        var paraeters = new DialogParameters<Admin.SaleCounter.DiscountCodeChoiceDialog>
        {
            {x => x.TotalProductAmount, _totalProductAmount},
            {x => x.OrderId, Order.OrderId},
        };

        var dialog = await _dialogService.ShowAsync<Admin.SaleCounter.DiscountCodeChoiceDialog>("Options Dialog", paraeters, _maxWidth);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            await LoadOrderItems();
            StateHasChanged();
        }
    }

    async Task RemoveDiscount()
    {
        var orderItemInlocals = await localStorage.GetItemAsStringAsync(Constant.OrderPOSTemp);
        if (!string.IsNullOrEmpty(orderItemInlocals))
        {
            var deserializedData = JsonSerializer.Deserialize<List<OrderTempPOS>>(orderItemInlocals);

            if (deserializedData != null && deserializedData.Any())
            {
                var objOrder = deserializedData.FirstOrDefault(x => x.OrderId == Order.OrderId);

                if (objOrder != null)
                {
                    objOrder.discountObj = null;
                    _discountAmount = 0;
                    _discountCode = string.Empty;
                    await localStorage.SetItemAsStringAsync(Constant.OrderPOSTemp, JsonSerializer.Serialize(deserializedData));
                }
            }
        }
        await LoadOrderItems();
        StateHasChanged();
    }

    private async Task SetToGuest()
    {
        Order.CustomerId = -1;
        _customer = new DAL.Models.Customer();

        _defaultAddress = new DAL.Models.Address();

        _selectedProvince = 0;
        _selectedDistrict = 0;
        _selectedWard = string.Empty;

        _districts = new();
        _wards = new();

        _isUseCurrentAddress = 1;
        _isDisabledAddressUse = false;
        _note = string.Empty;

        Order.CustomerId = -1;
        _shippingAmount = 0;
        var result = await _orderService.Update(Order, Token);

        StateHasChanged();
    }

    async Task DeleteProductInItems(int variantId)
    {
        var objOrderTemp = await localStorage.GetItemAsStringAsync(Constant.OrderPOSTemp);

        if (!string.IsNullOrEmpty(objOrderTemp))
        {
            var deserializedData = JsonSerializer.Deserialize<List<OrderTempPOS>>(objOrderTemp);
            if (deserializedData != null && deserializedData.Any())
            {
                var order = deserializedData.FirstOrDefault(x => x.OrderId == Order.OrderId);

                if (order != null)
                {
                    if(order.ListItem.Any())
                    {
                        var hasProductVariant = order.ListItem.FirstOrDefault(x => x.ProductVariantId == variantId);

                        if(hasProductVariant != null)
                        {
                            var currentItems = order.ListItem;
                            currentItems.Remove(hasProductVariant);
                            order.ListItem = currentItems;

                            await localStorage.SetItemAsStringAsync(Constant.OrderPOSTemp, JsonSerializer.Serialize(deserializedData));
                        }
                    }
                }
            }
            await LoadOrderItems();
            await GetShippingFeeAsync();
            StateHasChanged();
        }
    }

    async Task UpdateQuantity(CheckoutListItem checkoutListItem, bool isIncrease)
    {
        if (checkoutListItem.Quantity == 1 && !isIncrease) return;

        var objOrderTemp = await localStorage.GetItemAsStringAsync(Constant.OrderPOSTemp);

        if (!string.IsNullOrEmpty(objOrderTemp))
        {
            var deserializedData = JsonSerializer.Deserialize<List<OrderTempPOS>>(objOrderTemp);
            if (deserializedData != null && deserializedData.Any())
            {
                var order = deserializedData.FirstOrDefault(x => x.OrderId == Order.OrderId);

                if (order != null)
                {
                    if (order.ListItem.Any())
                    {
                        var hasProductVariant = order.ListItem.FirstOrDefault(x => x.ProductVariantId == checkoutListItem.ProductVariantId);

                        if (hasProductVariant != null)
                        {
                            var currentQuantity = hasProductVariant.Quantity;
                            var totalQuantity = isIncrease ? currentQuantity + 1: currentQuantity - 1;
                            var subTotal = hasProductVariant.UnitPrice * totalQuantity;
                            hasProductVariant.Quantity = totalQuantity;
                            hasProductVariant.Subtotal = subTotal;

                            if (order.discountObj != null)
                            {
                                decimal amount = 0;
                                var totalAmount = order.ListItem.Sum(x => x.Subtotal) ?? 0;
                                if (order.discountObj.DiscountType == Constant.DiscountTypePercent)
                                {
                                    amount = totalAmount * (order.discountObj.Value / 100);
                                    if (order.discountObj.maxValueUse.HasValue && amount > order.discountObj.maxValueUse.Value)
                                    {
                                        amount = order.discountObj.maxValueUse.Value;
                                    }
                                }
                                else
                                {
                                    if (order.discountObj.Value > totalAmount)
                                    {
                                        amount = totalAmount;
                                    }
                                    else
                                    {
                                        amount = order.discountObj.Value;
                                    }
                                }
                                order.discountObj.DiscountAmount = amount;
                            }


                            await localStorage.SetItemAsStringAsync(Constant.OrderPOSTemp, JsonSerializer.Serialize(deserializedData));
                        }
                    }
                }
            }
        }

        await LoadOrderItems();
        await GetShippingFeeAsync();
        StateHasChanged();
    }

    async Task ChangeAddressUse(int value)
    {
        _isUseCurrentAddress = value;
        if (value == 0)
        {
            _defaultAddress = new DAL.Models.Address();
            _selectedProvince = 0;
            _selectedDistrict = 0;
            _shippingAmount = 0;
            _selectedWard = string.Empty;
            _districts = new();
            _wards = new();
        }
        else
        {
            await LoadAddress();
        }        
    }

    private async Task GetShippingFeeAsync()
    {
        if (!_orderItems.Any())
        {
            _shippingAmount = 0;
            return;
        }

        if (_defaultAddress == null ||
            string.IsNullOrEmpty(_defaultAddress.District) ||
            string.IsNullOrEmpty(_defaultAddress.Street))
        {
            _shippingAmount = 0;
            return;
        }

        if (!int.TryParse(_defaultAddress.District, out int districtId))
        {
            _shippingAmount = 0;
            return;
        }

        var requestData = new CalculateFeeRequestModel
            {
                ToDistrictId = districtId,
                ToWardCode = _defaultAddress.Street,
                Items = _orderItems.Select(item => new FeeItemModel
                {
                    Quantity = item.Quantity,
                    Name = item.ProductName ?? string.Empty,
                    Length = 35,
                    Weight = 500,
                    Width = 35,
                    Height = 5,
                }).ToList()
            };

        var resCalculate = await _addressService.CaculateFee(requestData);

        if (resCalculate.IsSuccess && resCalculate.Data?.Data != null)
        {
            _shippingAmount = resCalculate.Data.Data.Total;
        }
        else
        {
            _shippingAmount = 0;
        }
    }

    private async Task LoadDistricts(int provinceId)
    {
        var res = await _addressService.GetAllDistrictByProvinceId(provinceId);
        if (res.IsSuccess) _districts = res.Data ?? new();
    }

    private async Task LoadWards(int districtId)
    {
        var res = await _addressService.GetAllWardByDistrictCode(districtId);
        if (res.IsSuccess) _wards = res.Data ?? new();
    }

    private decimal TotalPaymentAmount
    {
        get
        {
            decimal amountAfterDiscount = Math.Max(0, _totalProductAmount - _discountAmount);

            return amountAfterDiscount + _shippingAmount;
        }
    }
}