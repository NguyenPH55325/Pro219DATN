@page "/admin/products/{id:int}/edit"
@layout AdminLayout

<div class="p-6">
    <MudBreadcrumbs Class="!p-0 !text-sm" Items="_items" Separator=">"></MudBreadcrumbs>

    <h1 class="leading-[3rem] h-12 text-3xl font-bold text-admin-default">Sửa sản phẩm</h1>

    <div class="mx-auto mt-6 w-full rounded-lg bg-white p-8 shadow-sm">
        <EditForm Model="_model" OnValidSubmit="OnSubmit" class="mx-auto flex w-full flex-col gap-4">
            <DataAnnotationsValidator />

            <div class="mx-auto flex w-full max-w-[64.5rem] gap-6 rounded-lg bg-slate-100 px-6 py-4">
                <span Class="w-44 flex-shrink-0 pt-4 text-base font-medium text-gray-900">Tên</span>
                <MudTextField @bind-Value="@_model.Name" For="@(() => _model.Name)" Placeholder="Áo polo" Variant="Variant.Outlined" FullWidth Style="background-color: white" />
            </div>

            <div class="mx-auto flex w-full max-w-[64.5rem] gap-6 rounded-lg bg-slate-100 px-6 py-4">
                <span Class="w-44 flex-shrink-0 pt-4 text-base font-medium text-gray-900">Giá mặc định</span>
                <MudNumericField @bind-Value="@_model.BasePrice" For="@(() => _model.BasePrice)" Format="F0" Step="1000" Placeholder="179000" Adornment="Adornment.End"
                                 AdornmentText="₫" HideSpinButtons="true" Variant="Variant.Outlined" Style="background-color: white" FullWidth />
            </div>

            <div class="mx-auto flex w-full max-w-[64.5rem] gap-6 rounded-lg bg-slate-100 px-6 py-4">
                <span Class="w-44 flex-shrink-0 pt-4 text-base font-medium text-gray-900">Danh mục</span>
                <MudSelect T="int" @bind-Value="@_model.CategoryId" For="@(() => _model.CategoryId)" Placeholder="Áo polo" Variant="Variant.Outlined" Style="background-color: white" FullWidth>
                    <MudSelectItem Value="0">Vui lòng chọn</MudSelectItem>
                    @if (_categories.Any())
                    {
                        @foreach (var item in _categories)
                        {
                            <MudSelectItem Value="@item.Id">@item.Name</MudSelectItem>
                        }
                    }
                </MudSelect>
            </div>

            <div class="mx-auto flex w-full max-w-[64.5rem] gap-6 rounded-lg bg-slate-100 px-6 py-4">
                <span Class="w-44 flex-shrink-0 pt-4 text-base font-medium text-gray-900">Thương hiệu</span>
                <MudSelect T="int" @bind-Value="@_model.BrandId" For="@(() => _model.BrandId)" Placeholder="Nike" Variant="Variant.Outlined" Style="background-color: white" FullWidth>
                    <MudSelectItem Value="0">Vui lòng chọn</MudSelectItem>
                    @if (_brands.Any())
                    {
                        @foreach (var item in _brands)
                        {
                            <MudSelectItem Value="@item.Id">@item.Name</MudSelectItem>
                        }
                    }
                </MudSelect>
            </div>

            <div class="mx-auto flex w-full max-w-[64.5rem] gap-6 rounded-lg bg-slate-100 px-6 py-4">
                <span Class="w-44 flex-shrink-0 pt-4 text-base font-medium text-gray-900">Mô tả</span>
                <MudTextField @bind-Value="@_model.Description" For="@(() => _model.Description)" Placeholder="mô tả sản phẩm" Variant="Variant.Outlined" Style="background-color: white" FullWidth Lines="3" />
            </div>

            <div class="mx-auto flex w-full max-w-[64.5rem] gap-6 rounded-lg bg-slate-100 px-6 py-4">
                <span Class="w-44 flex-shrink-0 pt-2 text-base font-medium text-gray-900">Ảnh</span>
                <div class="flex flex-col gap-4">
                    <MudFileUpload T="IBrowserFile" FilesChanged="UploadFiles">
                        <ActivatorContent>
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       ButtonType="ButtonType.Button"
                                       StartIcon="@Icons.Material.Filled.CloudUpload"
                                       Disabled="@((_images.Count + _newImages.Count) >= 2)">
                                Thêm Ảnh (@(_images.Count + _newImages.Count)/2)
                            </MudButton>
                        </ActivatorContent>
                    </MudFileUpload>

                    @if (_images.Any() || _newImages.Any())
                    {
                        <div class="flex gap-4">
                            @foreach (var item in _images)
                            {
                                <div class="center; relative flex h-fit max-w-40 items-center justify-center overflow-hidden rounded-lg border-2 border-gray-300">
                                    <MudImage Src="@item.ImageUrl" Alt="Ảnh đã lưu" ObjectFit="ObjectFit.Cover" Class="!aspect-[1/1.5] !h-full !w-[150px] !max-w-[150px]" />
                                    <MudIconButton Icon="@Icons.Material.Filled.Close" Color="Color.Error" Size="Size.Small" OnClick="@(() => HandleRemoveExistingImage(item))"
                                                   Class="absolute top-1 right-1 text-white !p-0" />
                                </div>
                            }
                            @foreach (var item in _newImages)
                            {
                                <div class="center; relative flex h-fit max-w-40 items-center justify-center overflow-hidden rounded-lg border-2 border-gray-300">
                                    <MudImage Src="@item.Url" Alt="@item.File.Name" ObjectFit="ObjectFit.Cover" Class="!aspect-[1/1.5] !h-full !w-[150px] !max-w-[150px]" />
                                    <MudIconButton Icon="@Icons.Material.Filled.Close" Color="Color.Error" Size="Size.Small" OnClick="@(() => HandleRemoveNewImage(item.File))"
                                                   Class="absolute top-1 right-1 text-white !p-0" />
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>

            <div class="mx-auto flex w-full max-w-[64.5rem] gap-6 rounded-lg bg-slate-100 px-6 py-4">
                <span Class="w-44 flex-shrink-0 pt-4 text-base font-medium text-gray-900">Trạng thái</span>

                <MudRadioGroup Disabled="@_isDisabledStatus"  @bind-Value="@_isActive" For="@(() => _isActive)">
                    <MudRadio Value="1" Color="Color.Primary">Hoạt động</MudRadio>
                    <MudRadio Value="0" Color="Color.Primary">Ngừng Hoạt động</MudRadio>
                </MudRadioGroup>
            </div>

            <div class="flex items-center justify-center gap-4">
                <MudButton OnClick="@(() => navigation.NavigateTo(RouterConst.Admin.Product))" Color="Color.Surface" Variant="Variant.Filled" ButtonType="ButtonType.Button" Class="w-fit px-10">Quay lại</MudButton>
                <MudButton Color="Color.Primary" Variant="Variant.Filled" ButtonType="ButtonType.Submit" Disabled="@_isSubmitting" Class="w-fit px-10">Sửa</MudButton>
            </div>
        </EditForm>
    </div>
</div>

@code {
    [Parameter]
    public int id { get; set; }

    [Inject]
    public IWebHostEnvironment WebHostEnvironment { get; set; }

    ProductModel _model = new ProductModel();
    List<DAL.Models.Category> _categories = new List<DAL.Models.Category>();
    List<DAL.Models.Brand> _brands = new List<DAL.Models.Brand>();

    List<DAL.Models.ProductImage> _images = new List<DAL.Models.ProductImage>();
    IList<ImageFileDTO> _newImages = new List<ImageFileDTO>();
    List<DAL.Models.ProductImage> _imagesToDelete = new List<DAL.Models.ProductImage>();

    private string _token = "";
    private bool _isLoading = true;
    private int _isActive = 1;
    private int MaxAllowedSize = 1024 * 1024 * 5;
    private bool _isSubmitting = false;
    private bool _isDisabledStatus = false;

    private List<BreadcrumbItem> _items =>
    [
        new("Trang Chủ", href: RouterConst.Admin.Home),
    new("Sản Phẩm", href: RouterConst.Admin.Product),
    new("Chỉnh Sửa Sản Phẩm", href: "#", disabled: true),
    ];

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _token = await localStorage.GetItemAsStringAsync(Constant.TokenNameLocalStorage);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        _isSubmitting = true;

        // 1. Tải dữ liệu chính (Sản phẩm, Danh mục, Thương hiệu)
        var resProduct = await _productService.GetById(id);
        var resCategory = await _categoryService.GetAll(null);
        var resBrand = await _brandService.GetAll(null);

        if (resProduct.IsSuccess && resProduct.Data != null)
        {
            var data = resProduct.Data;

            _model.Id = data.Id;
            _model.Name = data.Name;
            _model.BasePrice = data.BasePrice;
            _model.BrandId = data.BrandId;
            _model.CategoryId = data.CategoryId;
            _model.Status = data.Status;
            _model.Description = data.Description;
            _isActive = data.Status != null ? (int)data.Status : -1;

            var resImages = await _productImageService.GetAllOnlyPoductByProductId(id);
            if (resImages.IsSuccess && resImages.Data != null)
            {
                _images = resImages.Data;
            }


            var resProductVariants = await _productVariantService.GetAllByProduct(data.Id, _token);
            if(resProductVariants.IsSuccess && !resProductVariants.Data.Any())
            {
                _isDisabledStatus = true;
            }
        }
        else
        {
            _snackbar.Add("Không tìm thấy sản phẩm này", Severity.Error);
            navigation.NavigateTo(RouterConst.Admin.Product);
            return;
        }

        if (resCategory.IsSuccess && resCategory.Data != null)
        {
            _categories = resCategory.Data.Where(c => c.ParentCategoryId != null).ToList();
        }
        if (resBrand.IsSuccess && resBrand.Data != null)
        {
            _brands = resBrand.Data;
        }

        _isSubmitting = false;
        StateHasChanged();
    }

    private async Task UploadFiles(IBrowserFile file)
    {
        if (_images.Count + _newImages.Count >= 2)
        {
            _snackbar.Add("Chỉ được phép thêm tối đa 2 ảnh", Severity.Warning);
            return;
        }

        if (file.Size > MaxAllowedSize)
        {
            _snackbar.Add("Ảnh không được quá 5mb", Severity.Warning);
            return;
        }

        var url = await Task.Run(async () =>
        {
            using var stream = file.OpenReadStream(MaxAllowedSize);
            using var memoryStream = new MemoryStream();
            await stream.CopyToAsync(memoryStream);

            var base64String = Convert.ToBase64String(memoryStream.ToArray());
            return $"data:{file.ContentType};base64,{base64String}";
        });

        _newImages.Add(new ImageFileDTO { File = file, Url = url });
        StateHasChanged();
    }

    private void HandleRemoveExistingImage(DAL.Models.ProductImage image)
    {
        _images.Remove(image);
        _imagesToDelete.Add(image);
        StateHasChanged();
    }

    private void HandleRemoveNewImage(IBrowserFile file)
    {
        var itemToRemove = _newImages.FirstOrDefault(i => i.File == file);
        if (itemToRemove != null)
        {
            _newImages.Remove(itemToRemove);
            StateHasChanged();
            _snackbar.Add($"Đã xóa ảnh mới: {file.Name}", Severity.Info);
        }
    }

    async Task OnSubmit()
    {
        if (_isSubmitting) return;
        if (_images.Count + _newImages.Count <= 0)
        {
            _snackbar.Add("Vui lòng thêm ít nhất 1 ảnh", Severity.Warning);
            return;
        }

        try
        {
            _isSubmitting = true;
            _model.Status = (byte)_isActive;
            _model.Name = _model.Name.Trim();
            _model.Description = _model.Description?.Trim();
            var result = await _productService.Update(_model, _token);

            if (result.IsSuccess)
            {
                try
                {
                    var productId = _model.Id;
                    var contentRootPath = WebHostEnvironment.WebRootPath;
                    var productImagesPath = Path.Combine(contentRootPath, "Uploads", "Images", "Products", productId.ToString());

                    // 2. Xử lý xóa ảnh cũ khỏi DB và hệ thống file
                    if (_imagesToDelete.Any())
                    {
                        var resultDelete = await _productImageService.DeleteAny(_imagesToDelete.Select(i => i.Id).ToList(), _token);

                        foreach (var image in _imagesToDelete)
                        {
                            var fullPath = Path.Combine(contentRootPath, image.ImageUrl.TrimStart('/'));
                            if (File.Exists(fullPath))
                            {
                                File.Delete(fullPath);
                            }
                        }
                        _imagesToDelete.Clear();
                    }

                    // 3. Xử lý lưu ảnh mới vào hệ thống file và DB
                    if (_newImages.Any())
                    {
                        if (!Directory.Exists(productImagesPath))
                        {
                            Directory.CreateDirectory(productImagesPath);
                        }

                        List<DAL.Models.ProductImage> imagesToCreate = new List<DAL.Models.ProductImage>();

                        foreach (var image in _newImages)
                        {
                            var fileName = Path.GetFileName(image.File.Name);
                            var filePath = Path.Combine(productImagesPath, fileName);

                            // Lưu file vào thư mục
                            await using Stream fileStream = image.File.OpenReadStream(MaxAllowedSize);
                            await using FileStream fs = File.Create(filePath);
                            await fileStream.CopyToAsync(fs);

                            // Tạo record trong DB
                            DAL.Models.ProductImage productImage = new DAL.Models.ProductImage
                                {
                                    ProductId = productId,
                                    ImageUrl = "/Uploads/Images/Products/" + productId.ToString() + "/" + fileName,
                                    IsMain = true,
                                    Status = 1,
                                };
                            imagesToCreate.Add(productImage);
                        }

                        if (imagesToCreate.Any())
                        {
                            await _productImageService.CreateAny(imagesToCreate);
                        }

                        _newImages.Clear();
                    }

                    // Cập nhật lại danh sách ảnh hiển thị (bao gồm cả ảnh cũ còn lại và ảnh mới vừa thêm)
                    var resImagesAfterUpdate = await _productImageService.GetAllByProductId(id);
                    if (resImagesAfterUpdate.IsSuccess && resImagesAfterUpdate.Data != null)
                    {
                        _images = resImagesAfterUpdate.Data;
                    }

                    _snackbar.Add("Cập nhật sản phẩm thành công", Severity.Success);
                    navigation.NavigateTo(RouterConst.Admin.Product);
                }
                catch (Exception ex)
                {
                    _snackbar.Add($"Cập nhật sản phẩm thành công, nhưng lỗi xử lý ảnh: {ex.Message}", Severity.Warning);
                }
            }
        }
        catch(Exception ex) {}
        finally
        {
            _isSubmitting = false;
        }
    }
}