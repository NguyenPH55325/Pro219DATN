@page "/admin/products"
@layout AdminLayout

<div class="p-6">
    <MudBreadcrumbs Class="!p-0 !text-sm" Items="_items" Separator=">"></MudBreadcrumbs>

    <div class="flex items-center justify-between">
        <h1 class="leading-[3rem] h-12 text-3xl font-bold text-admin-default">Danh sản phẩm</h1>
        <a href="@RouterConst.Admin.CreateProduct" class="leading-[1.5rem] h-10 rounded-lg bg-admin-default px-6 py-2 text-white">Tạo mới</a>
    </div>

    <div class="my-6 rounded-xl border border-slate-200 bg-white p-8 shadow-sm">
        <div class="grid w-full grid-cols-3 gap-x-6 gap-y-4">
            <div>
                <MudTextField T="string" Placeholder="Tìm kiếm" Adornment="Adornment.Start" Value="@_searchValue"
                              AdornmentIcon="@Icons.Material.Filled.Search" Variant="Variant.Outlined" IconSize="Size.Medium" Class="mt-0" ValueChanged="onChangeSearch" Immediate=true></MudTextField>
            </div>
            <div>
                <MudSelect T="int" Variant="Variant.Outlined" Placeholder="Danh mục" Value="@_searchCategory" ValueChanged="OnChangeCategory">
                    <MudSelectItem Value="0">Tất cả</MudSelectItem>
                    @if (_categories.Any())
                    {
                        @foreach (var item in _categories)
                        {
                            <MudSelectItem Value="item.Id">@item.Name</MudSelectItem>
                        }
                    }
                </MudSelect>
            </div>
            <div>
                <MudSelect T="int" Variant="Variant.Outlined" Placeholder="Thương hiệu" Value="@_searchBrand" ValueChanged="OnChangeBrand">
                    <MudSelectItem Value="0">Tất cả</MudSelectItem>
                    @if (_brands.Any())
                    {
                        @foreach (var item in _brands)
                        {
                            <MudSelectItem Value="item.Id">@item.Name</MudSelectItem>
                        }
                    }
                </MudSelect>
            </div>
            <div class="flex items-center gap-2">
                <MudButton Variant="Variant.Outlined" OnClick="OnSearch" Class="flex h-14 w-full items-center gap-2"><MudIcon Icon="@Icons.Material.Filled.Search" Class="mr-2" /> Tìm kiếm</MudButton>
                <MudButton Variant="Variant.Outlined" OnClick="OnReset" Class="flex h-14 w-full items-center gap-2"><MudIcon Icon="@Icons.Material.Filled.Filter" Class="mr-2" /> Đặt lại</MudButton>
            </div>
        </div>
    </div>
    <div class="mt-6 w-full overscroll-x-auto rounded-xl border border-slate-200 bg-white p-8 shadow-sm">
        <MudTable Bordered Items="@_products" CellClass="min-w-60" Loading="@_loading" Class="w-full" Dense="true" Hover="true" Virtualize="true" FixedHeader="true" HorizontalScrollbar="true">
            <HeaderContent>
                <MudTh hidden><MudTableSortLabel SortLabel="Id" T="string" hidden>STT</MudTableSortLabel></MudTh>
                <MudTh Class="whitespace-nowrap"><MudTableSortLabel SortLabel="Ảnh" T="string">Ảnh</MudTableSortLabel></MudTh>
                <MudTh Class="whitespace-nowrap"><MudTableSortLabel SortLabel="Tên" T="string">Tên</MudTableSortLabel></MudTh>
                <MudTh Class="whitespace-nowrap"><MudTableSortLabel SortLabel="Giá mặc định" T="string">Giá mặc định</MudTableSortLabel></MudTh>
                <MudTh Class="whitespace-nowrap"><MudTableSortLabel SortLabel="Danh mục" T="string">Danh mục</MudTableSortLabel></MudTh>
                <MudTh Class="whitespace-nowrap"><MudTableSortLabel SortLabel="Thương hiệu" T="string">Thương hiệu</MudTableSortLabel></MudTh>
                <MudTh Class="whitespace-nowrap"><MudTableSortLabel SortLabel="Mô tả" T="string">Mô tả</MudTableSortLabel></MudTh>
                <MudTh Class="whitespace-nowrap"><MudTableSortLabel SortLabel="Trạng thái" T="string">Trạng thái</MudTableSortLabel></MudTh>
                <MudTh Class="whitespace-nowrap"><MudTableSortLabel SortLabel="Thao tác" T="string">Thao tác</MudTableSortLabel></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Id" hidden>@context.Id</MudTd>
                <MudTd DataLabel="Ảnh"><MudImage Src="@_productImages.FirstOrDefault(pi => pi.ProductId == context.Id && pi.ProductVariantId == null)?.ImageUrl" Width="100" /></MudTd>
                <MudTd DataLabel="Ảnh">@context.Name</MudTd>
                <MudTd DataLabel="Giá mặc định">@context.BasePrice.ToString("C0", vietnameseCulture)</MudTd>
                <MudTd DataLabel="Danh mục">@(context.Category?.Name ?? "")</MudTd>
                <MudTd DataLabel="Thương hiệu">@(context.Brand?.Name ?? "")</MudTd>
                <MudTd DataLabel="Mô tả">@context.Description</MudTd>
                <MudTd DataLabel="Trạng thái">@((context.Status == Constant.StatusDefault.Active) ? "Hoạt Động" : "Không Hoạt Động")</MudTd>
                <MudTd DataLabel="Thao tác">
                    <MudTooltip Text="Thêm sản phẩm con"><MudIconButton OnClick="@(() => HandleRedirect(context.Id, true))" Icon="@Icons.Material.Filled.Add" /></MudTooltip>
                    <MudTooltip Text="Chi tiết sản phẩm"><MudIconButton OnClick="@(() => navigation.NavigateTo(RouterConst.Admin.ProductDetail.Replace(":id", context.Id.ToString())))" Icon="@Icons.Material.Filled.Menu" /></MudTooltip>
                    <MudIconButton Icon="@Icons.Material.Filled.BorderColor" aria-label="update" OnClick="@(() => HandleRedirect(context.Id, false))"></MudIconButton>
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" aria-label="delete" OnClick="@(() => OpenDialogDelete(context.Id))"></MudIconButton>
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText>Không có dữ liệu.</MudText>
            </NoRecordsContent>
            <LoadingContent>
                <div class="flex w-full flex-col gap-3">
                    @{
                        for (var i = 0; i < Constant.DefaultSkeletons; i++)
                        {
                            <div class="flex items-center justify-between gap-2">
                                <MudSkeleton Width="100%" Height="3rem" />
                                <MudSkeleton Width="100%" Height="3rem" />
                                <MudSkeleton Width="100%" Height="3rem" />
                                <MudSkeleton Width="100%" Height="3rem" />
                                <MudSkeleton Width="100%" Height="3rem" />
                                <MudSkeleton Width="100%" Height="3rem" />
                            </div>
                        }
                    }
                </div>
            </LoadingContent>
            <PagerContent>
                <MudTablePager />
            </PagerContent>
        </MudTable>
    </div>
</div>

@code {
    private CancellationTokenSource? _cts;
    private List<DAL.Models.Product> _products = [];
    private List<DAL.Models.ProductImage> _productImages = [];
    private List<DAL.Models.Category> _categories = [];
    private List<DAL.Models.Brand> _brands = [];

    CultureInfo vietnameseCulture = new CultureInfo("vi-VN");

    private readonly DialogOptions _maxWidth = new() { MaxWidth = MaxWidth.Large, FullWidth = true };

    private string _token = string.Empty;
    private string _searchValue = string.Empty;
    private int _searchCategory = 0;
    private int _searchBrand = 0;
    private bool _loading = true;

    private List<BreadcrumbItem> _items =
    [
        new("Trang Chủ", href: RouterConst.Admin.Home),
    new("Sản Phẩm", href: "#", disabled: true),
    ];

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if(firstRender)
        {
            try
            {
                _token = await localStorage.GetItemAsStringAsync(Constant.TokenNameLocalStorage);
                await LoadData();
            }
            catch (Exception e)
            {
                _loading = false;
            }
            finally
            {
                _loading = false;
                StateHasChanged();
            }
        }
    }

    async Task LoadData()
    {
        var resProduct = await _productService.GetAll(_searchValue, _searchCategory, _searchBrand, _token);
        var dataProduct = resProduct.Data;
        if (resProduct.IsSuccess && dataProduct != null)
        {
            _products = dataProduct;
        }

        var resCatgegory = await _categoryService.GetAll(null);
        var dataCatgegory = resCatgegory.Data;
        if (resCatgegory.IsSuccess && dataCatgegory != null)
        {
            _categories = dataCatgegory;
        }

        var resBrand = await _brandService.GetAll(null);
        var dataBrand = resBrand.Data;
        if (resBrand.IsSuccess && dataBrand != null)
        {
            _brands = dataBrand;
        }

        var resProductImage = await _productImageService.GetAll();
        var dataProductImage = resProductImage.Data;
        if (resProductImage.IsSuccess && dataProductImage != null)
        {
            _productImages = dataProductImage;
        }
    }

    private void onChangeSearch(string value)
    {
        _searchValue = value;
    }

    private void OnChangeCategory(int value)
    {
        _searchCategory = value;
    }

    private void OnChangeBrand(int value)
    {
        _searchBrand = value;
    }

    private async Task OnSearch()
    {
        await LoadData();
    }

    private async Task OnReset()
    {
        _searchValue = string.Empty;
        _searchCategory = 0;
        _searchBrand = 0;

        await LoadData();
    }

    void HandleRedirect(int id, bool isProductVariant)
    {
        if (isProductVariant)
        {
            navigation.NavigateTo(RouterConst.Admin.CreateProductVariant.Replace(":productId", id.ToString()));
        }
        else
        {
            navigation.NavigateTo(RouterConst.Admin.EditProduct.Replace(":id", id.ToString()));
        }
    }

    async Task OpenDialogDelete(int id)
    {
        var deleteParaeters = new DialogParameters<Admin.Product.ConfirmDeleteDialog>
        {
            {x => x.id, id}
        };

        var dialog = await _dialogService.ShowAsync<Admin.Product.ConfirmDeleteDialog>("Options Dialog", deleteParaeters, _maxWidth);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            await LoadData();
            StateHasChanged();
        }
    }
}