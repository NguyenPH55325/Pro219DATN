@page "/admin/login"
@layout PublicLayout

<PageTitle>@Constant.PageTitleAdmin Login</PageTitle>

@if(_isLoading)
{
    <LoadingAdmin />
} else
{  
    <section class="flex h-full w-full flex-col items-center justify-center gap-10 bg-[#7e6fff]">
        <div class="flex w-full max-w-[35rem] flex-col items-center justify-center rounded-lg bg-white p-12 shadow-2xl">
            <div class="flex w-64 items-center justify-center">
                <img src="/Assets/Icons/logo-admin.svg" alt="logo" />
            </div>

            <h2 class="mb-6 mt-2 text-2xl font-bold text-[#252a2b]">Welcome to Adams Store Management</h2>

            <EditForm class="w-full" Model="_model" OnValidSubmit="OnLogin">
                <DataAnnotationsValidator />

                <MudTextField @bind-Value="_model.Username" For="@(() => _model.Username)" Variant="Variant.Outlined" Placeholder="Username" FullWidth="true" />

                <MudTextField @bind-Value="_model.PasswordHash" For="@(() => _model.PasswordHash)" Class="mt-4 w-full" Variant="Variant.Outlined" Placeholder="Password" InputType="@PasswordInput" Adornment="Adornment.End" AdornmentIcon="@PasswordInputIcon" OnAdornmentClick="ShowHidePassword" AdornmentAriaLabel="Show Password" FullWidth="true" />

                <MudButton Class="mt-6 !h-12 !w-full rounded-lg !bg-[#7e6fff] !text-white" ButtonType="ButtonType.Submit">Đăng Nhập</MudButton>
            </EditForm>
        </div>
    </section>
}

@code {
    LoginAdminModel _model = new LoginAdminModel();
    private bool _isPasswordVisible = false;
    private bool _isLoading = true;

    InputType PasswordInput => _isPasswordVisible ? InputType.Text : InputType.Password;
    string PasswordInputIcon => _isPasswordVisible ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var token = await localStorage.GetItemAsStringAsync(Constant.TokenNameLocalStorage);
            var expired = await localStorage.GetItemAsStringAsync(Constant.TokenExpiredLocalStorage);

            if(string.IsNullOrEmpty(token))
            {
                await localStorage.RemoveItemAsync(Constant.TokenNameLocalStorage);
                await localStorage.RemoveItemAsync(Constant.TokenExpiredLocalStorage);
                await localStorage.RemoveItemAsync(Constant.UserInfoLocalStorage);

                _isLoading = false;
                StateHasChanged();
                return;
            }

            if(!string.IsNullOrEmpty(expired))
            {
                if (DateTime.TryParse(expired.Trim('"'), out DateTime expirationTime))
                {
                    if (expirationTime <= DateTime.Now)
                    {
                        await localStorage.RemoveItemAsync(Constant.TokenNameLocalStorage);
                        await localStorage.RemoveItemAsync(Constant.TokenExpiredLocalStorage);
                        await localStorage.RemoveItemAsync(Constant.UserInfoLocalStorage);

                        _isLoading = false;
                        StateHasChanged();
                        return;
                    }
                }
            }

            var getMe = await localStorage.GetItemAsStringAsync(Constant.UserInfoLocalStorage);

            if (string.IsNullOrEmpty(getMe))
            {
                await localStorage.RemoveItemAsync(Constant.TokenNameLocalStorage);
                await localStorage.RemoveItemAsync(Constant.TokenExpiredLocalStorage);
                await localStorage.RemoveItemAsync(Constant.UserInfoLocalStorage);

                _isLoading = false;
                StateHasChanged();
                return;
                
            }

            GetMeResponseDTO userInfo = null;

            try
            {
                userInfo = JsonSerializer.Deserialize<GetMeResponseDTO>(getMe);
            }
            catch (JsonException)
            {
                await localStorage.RemoveItemAsync(Constant.TokenNameLocalStorage);
                await localStorage.RemoveItemAsync(Constant.TokenExpiredLocalStorage);
                await localStorage.RemoveItemAsync(Constant.UserInfoLocalStorage);

                _isLoading = false;
                StateHasChanged();
                return;
            }
            if (userInfo != null && userInfo.Role != null)
            {
                if (userInfo.Role == Constant.Role.Customer)
                {
                    navigation.NavigateTo(RouterConst.User.Home);
                    _isLoading = false;
                    return;
                }
                else
                {
                    navigation.NavigateTo(RouterConst.Admin.Home);
                    _isLoading = false;
                    return;
                }
            }

            await localStorage.RemoveItemAsync(Constant.TokenNameLocalStorage);
            await localStorage.RemoveItemAsync(Constant.TokenExpiredLocalStorage);
            await localStorage.RemoveItemAsync(Constant.UserInfoLocalStorage);

            _isLoading = false;
            StateHasChanged();
        }
    }

    void ShowHidePassword()
    {
        _isPasswordVisible = !_isPasswordVisible;
        StateHasChanged();
    }

    async Task OnLogin()
    {
        var response = await _authService.LoginStaff(_model.Username.Trim(), _model.PasswordHash.Trim());
        if (response.LoginSuccess == true)
        {
            _snackbar.Add("Đăng nhập thành công!", Severity.Success);
            navigation.NavigateTo(RouterConst.Admin.Home, true);
            await localStorage.SetItemAsync(Constant.TokenNameLocalStorage, response.Token);
            await localStorage.SetItemAsync(Constant.TokenExpiredLocalStorage, response.Expiration);

        }
        else
        {
            _snackbar.Add("Đăng nhập không thành công. Vui lòng kiểm tra lại tên người dùng và mật khẩu.", Severity.Warning);
        }

    }
}
