@code {
    [CascadingParameter(Name = Constant.CascadingNameParams.UserInfo)]
    public GetMeResponseDTO UserInfo { get; set; } = new GetMeResponseDTO();

    readonly DialogOptions _maxWidth = new() { MaxWidth = MaxWidth.Medium, FullWidth = true };

    List<DAL.Repository.ProductRepository.ProductDetailDto> _productNews = [];
    List<DAL.Repository.ProductRepository.ProductDetailDto> _productFavourites = [];
    List<DAL.Models.Wishlist> _wishlists = [];

    private string _token = string.Empty;
    private bool _isShowButtonWishlist = true;
    CultureInfo vietnameseCulture = new CultureInfo("vi-VN");

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _token = await localStorage.GetItemAsStringAsync(Constant.TokenNameLocalStorage);
            if (string.IsNullOrEmpty(_token)) _isShowButtonWishlist = false;
            StateHasChanged();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
        StateHasChanged();
    }

    private async Task LoadData()
    {
        var _resProductNew = await _productService.GetNewProducts();
        var _resProductFavourites = await _productService.GetFavouriteProducts();

        if (_resProductNew.IsSuccess && _resProductNew.Data.Count() > 0)
        {
            _productNews = _resProductNew.Data;
        }

        if (_resProductFavourites.IsSuccess && _resProductFavourites.Data.Count() > 0)
        {
            _productFavourites = _resProductFavourites.Data;
        }

        if (UserInfo != null && UserInfo.Id > 0)
        {
            var resWishlist = await _wishlistService.GetAllByCustomer(UserInfo.Id);

            if (resWishlist.IsSuccess && resWishlist.Data.Count() > 0)
            {
                _wishlists = resWishlist.Data;
            }
        }
    }

    private bool IsOutOfStock(DAL.Repository.ProductRepository.ProductDetailDto item)
    {
        if (item.Variants == null || item.Variants.Count() == 0) return true;
        var totalQuantity = item.Variants.Sum(pv => pv.StockQuantity);

        if (totalQuantity == 0) return true;
        return false;
    }

    private async Task OpenDialog(int productId)
    {
        var fastAddCartParaeters = new DialogParameters<Common.User.FastAddToCartDialog>
        {
            {x => x.productId, productId}
        };

        var dialog = await _dialogService.ShowAsync<Common.User.FastAddToCartDialog>("Options Dialog", fastAddCartParaeters, _maxWidth);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
        }
    }

    public async Task AddWishlist(int productId)
    {
        if (string.IsNullOrEmpty(_token))
        {
            _snackbar.Add("Vui lòng đăng nhập để sử dụng tính năng yêu thích", Severity.Info);
            return;
        }

        if (UserInfo == null || UserInfo.Id <= 0)
        {
            _snackbar.Add("Có lỗi xảy ra. Vui lòng thử lại", Severity.Error);
            return;
        }

        if (productId <= 0)
        {
            _snackbar.Add("Có lỗi xảy ra. Vui lòng thử lại", Severity.Error);
            return;
        }

        var result = await _wishlistService.ToggleWishlist(UserInfo.Id, productId, _token);

        if (result.IsSuccess)
        {
            await LoadData();
            StateHasChanged();
        }
    }
}