@page "/"
@layout MainLayout

<PageTitle>@Constant.PageTitleUser Home</PageTitle>

<section class="mx-auto w-full max-w-[120rem]">
    <img src="/Assets/Images/user-home-banner-1.png" alt="banner" />
</section>

<section class="my-8 px-0 pt-8 lg:px-8">
    <h2 class="text-center text-xl font-bold uppercase md:text-2xl lg:text-3xl">Sản phẩm mới</h2>
    <div class="mb-4 grid gap-x-2 gap-y-14 px-4 xs:grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 sm:px-2">
        @if (_productNews.Any())
        {
            @foreach (var item in _productNews)
            {
                <div accesskey="@item.Id" class="relative w-full">
                    @if (IsOutOfStock(item))
                    {
                        <div class="absolute bottom-0 left-0 right-0 top-0 z-20 flex items-center justify-center bg-black opacity-70"><span class="rotate-45 px-4 py-2 text-4xl font-bold text-red-600 opacity-100">Hết hàng</span></div>
                    }
                    <div data-animation="1" class="group flex h-full flex-col justify-between lg:p-2.5">
                        <div class="group relative min-h-[200px] overflow-hidden px-2.5 text-center">
                            <a href="@(RouterConst.User.ProductDetail + $"/{item.Id}")" class="block transition">
                                @if (item.ImageUrls.Any())
                                {
                                    if (item.ImageUrls.Count > 1)
                                    {
                                        <picture class="flex h-full items-center justify-center transition duration-700 ease-in-out group-hover:invisible group-hover:opacity-0">
                                            <img class="overflow-clip" src="@item.ImageUrls[0]" />
                                        </picture>
                                        <picture accesskey="@item.Id" class="invisible absolute bottom-0 left-0 right-0 top-0 flex items-center justify-center opacity-0 transition duration-700 ease-in-out group-hover:visible group-hover:opacity-100">
                                            <img class="overflow-clip" src="@item?.ImageUrls[1]" />
                                        </picture>
                                    }
                                    else
                                    {
                                        <picture class="flex h-full items-center justify-center transition duration-700 ease-in-out">
                                            <img class="overflow-clip" src="@item.ImageUrls[0]" />
                                        </picture>
                                    }
                                }
                                else
                                {
                                    <picture class="flex h-full items-center justify-center transition duration-700 ease-in-out">
                                        <img class="overflow-clip" src="/Assets/Images/default-image.png" />
                                    </picture>
                                }
                            </a>

                            @{
                                if (_isShowButtonWishlist)
                                {
                                    var isWishlist = _wishlists.FirstOrDefault(x => x.ProductId == item.Id);
                                    if (isWishlist != null)
                                    {
                                        <MudIcon Icon="@Icons.Material.Filled.Favorite" Class="absolute bottom-2 right-2 cursor-pointer text-red-500" @onclick="@(() => AddWishlist(item.Id))" />
                                    }
                                    else
                                    {
                                        <MudIcon Icon="@Icons.Material.Filled.FavoriteBorder" Class="absolute bottom-2 right-2 cursor-pointer" @onclick="@(() => AddWishlist(item.Id))" />
                                    }
                                }
                            }
                        </div>

                        <div class="mb-10 w-full">
                            @if (item?.AvailableColors != null && item.AvailableColors.Any())
                            {
                                <div class="my-2.5 flex w-full flex-nowrap justify-center gap-1 overflow-x-auto">
                                    @foreach (var c in item.AvailableColors)
                                    {
                                        <MudTooltip Text="@c.Name" Arrow="true" Placement="Placement.Top">
                                            <div class="h-6 w-6 flex-shrink-0 cursor-pointer rounded-full border border-gray-300 shadow-sm"
                                                 style="background-color: @c.HexCode">
                                            </div>
                                        </MudTooltip>
                                    }
                                </div>
                            }

                            <div class="w-full">
                                <p class="line-clamp-1 text-center text-sm">@item?.Name</p>
                            </div>

                            <div class="w-full">
                                <p class="line-clamp-1 text-center text-sm font-bold">@item?.BasePrice.ToString("C0", vietnameseCulture)</p>
                            </div>

                            <div class="invisible absolute bottom-0 left-0 z-10 flex w-full items-center justify-between gap-4 bg-black py-2.5 opacity-0 group-hover:visible group-hover:opacity-100">
                                <button class="flex w-[49%] justify-center text-white" @onclick="@(() => OpenDialog(item.Id))"><MudIcon Icon="@Icons.Material.Filled.ShoppingCart" Size="Size.Small" Class="!mr-1" /> Thêm giỏ hàng</button>
                                <div class="h-5 w-[2%] border-r border-white" />
                                <button @onclick="@(() => navigation.NavigateTo(RouterConst.User.ProductDetail + $"/{item.Id}"))" class="flex w-[49%] justify-center text-white"><MudIcon Icon="@Icons.Material.Filled.RemoveRedEye" Size="Size.Small" Class="!mr-1" /> Xem chi tiết</button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            for (var i = 0; i < 8; i++)
            {
                <div accesskey="" class="mb-10 lg:p-2.5">
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="100%" Height="300px" Class="p-2.5" />
                    <div class="my-2.5 flex w-full justify-center gap-1">
                        <MudSkeleton SkeletonType="SkeletonType.Circle" Width="24px" Height="24px" />
                        <MudSkeleton SkeletonType="SkeletonType.Circle" Width="24px" Height="24px" />
                        <MudSkeleton SkeletonType="SkeletonType.Circle" Width="24px" Height="24px" />
                    </div>
                    <div class="w-full">
                        <MudSkeleton SkeletonType="SkeletonType.Text" Width="80%" Class="mx-auto text-center" />
                    </div>
                    <div class="w-full">
                        <MudSkeleton SkeletonType="SkeletonType.Text" Width="40%" Class="mx-auto text-center" />
                    </div>
                </div>
            }
        }
    </div>
</section>

