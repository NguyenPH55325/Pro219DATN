@page "/checkout/customer"
@layout MainLayout
@implements IAsyncDisposable

<PageTitle>@Constant.PageTitleUser Thanh toán</PageTitle>

<section class="mx-auto w-full max-w-[1032px] pb-10 pt-4">
    @if (_isCheckoutSuccess)
    {
        <div class="flex w-full flex-col items-center justify-center gap-4 p-6 text-center">
            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Class="!text-[100px]" />
            <h2 class="text-2xl font-bold text-green-600">Đặt hàng thành công!</h2>
            <p>Mã số đơn hàng: @_orderCodeSuccess</p>
            <div class="flex gap-3">
                <MudButton Variant="Variant.Filled" Color="Color.Dark" OnClick="@(() => navigation.NavigateTo(RouterConst.User.Home))">Tiếp tục mua sắm</MudButton>
                <MudButton Variant="Variant.Outlined" OnClick="@(() => navigation.NavigateTo(RouterConst.User.OrderDetail.Replace(":id", _orderIdSuccess.ToString())))">Xem đơn hàng</MudButton>
            </div>
        </div>
    }
    else
    {
    <div class="flex w-full flex-col flex-wrap justify-between gap-4 lg:flex-row lg:gap-8">
        <div class="w-full lg:w-[calc(100%-26rem)]">
            <div class="w-full">
                <MudExpansionPanel Class="!mt-2 !rounded-lg !border !border-solid !border-slate-200 !shadow">
                    <TitleContent>
                        <h3 class="text-lg font-bold">Địa chỉ giao hàng</h3>

                        <div class="mt-3 flex items-center gap-2">
                            <MudIcon Icon="@Icons.Material.Filled.Place"></MudIcon>
                            @if (_addressDefault == null)
                            {
                                <p class="text-sm font-medium">Không có địa chỉ</p>
                            }
                            else
                            {
                                <div>
                                    <p class="text-sm font-medium">
                                        @_addressDefault.FullName 
                                        @if (!string.IsNullOrEmpty(_addressDefault.Phone))
                                        {
                                            <span class="text-slate-500"> - @_addressDefault.Phone</span>
                                        }
                                    </p>
                                    <p class="text-sm font-medium">@FormatAddress(_addressDefault)</p>
                                </div>
                            }
                        </div>
                    </TitleContent>
                    <ChildContent>
                        <MudDivider />

                        <MudButton Disabled="@_isSubmitting" Class="my-6 w-full" Variant="Variant.Outlined" OnClick="OpenDialogCreateAddress">
                            <MudIcon Icon="@Icons.Material.Filled.AddLocation" /> Thêm địa chỉ mới
                        </MudButton>

                        <div class="max-h-[30rem] w-full">
                            <MudRadioGroup T="int" Value="@_selectedAddress" Class="max-h-[24rem] overflow-y-auto" ValueChanged="OnChangeAddress">
                                @if (_address.Any())
                                {
                                    @foreach (var item in _address)
                                    {
                                        <MudRadio Value="@item.Id" Class="my-1 !w-full !space-y-2">
                                            <p class="text-sm font-medium">
                                                @item.FullName 
                                                @if (!string.IsNullOrEmpty(item.Phone))
                                                {
                                                    <span class="text-slate-500"> - @item.Phone</span>
                                                }
                                                @if (item.IsDefault)
                                                {
                                                    <span class="text-xs text-red-400"> - Mặc Định</span>
                                                }
                                            </p>
                                            <p class="text-sm font-medium">@FormatAddress(item)</p>
                                        </MudRadio>
                                    }
                                }
                            </MudRadioGroup>
                        </div>
                    </ChildContent>
                </MudExpansionPanel>

                <div class="mt-6 rounded-lg border border-solid border-slate-200 p-3 shadow">
                    <h3 class="text-lg font-bold">Phương thức thanh toán</h3>

                    <MudRadioGroup T="int" @bind-Value="_selectPaymentMethod">
                        <MudRadio Value="@Constant.PaymentMethod.CashBack" Class="!w-full">
                            Tiền mặt
                        </MudRadio>
                        <MudRadio Value="@Constant.PaymentMethod.Transfer" Class="!w-full">
                            Chuyển khoản
                        </MudRadio>
                    </MudRadioGroup>
                </div>

                <div class="mt-6 rounded-lg border border-solid border-slate-200 p-3 shadow">
                    <h3 class="text-lg font-bold">Ghi chú</h3>

                    <MudTextField @bind-Value="@_note" placeholder="nội dung cho cửa hàng" Variant="Variant.Outlined" Style="height: 40px" />
                </div>
            </div>
        </div>

        <div class="flex w-full flex-shrink-0 flex-col gap-5 lg:w-[24rem]">
            <div class="flex max-h-[40rem] w-full flex-col gap-3 overflow-y-auto rounded-lg border border-solid border-slate-200 p-3 shadow">
                @if (_data.Any())
                {
                    @foreach (var item in _data)
                    {
                        <div class="flex items-center gap-2">
                            <div class="h-full w-full max-w-[5rem] flex-shrink-0">
                                <a>
                                    <img src="@item.ImageUrl" alt="product" />
                                </a>
                            </div>

                            <div class="flex flex-col">
                                <p class="whitespace-pre-wrap text-sm">@item.productName - @item.ColorName - @item.SizeName</p>
                                <span class="whitespace-pre-wrap text-sm font-medium">@FormatCurrency(item.UnitPrice ?? 0) x @item.Quantity</span>
                                <button disabled="@_isSubmitting" class="w-fit p-2 text-xs text-slate-500 hover:text-red-500" @onclick="@(() => Delete(item.Id))">Xóa</button>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <p class="text-center text-base">Sản phẩm trống</p>
                }
            </div>

            <div class="flex w-full flex-col gap-2 rounded-lg border border-solid border-slate-200 p-3 shadow">
                <h3 class="text-lg font-bold">Giảm giá</h3>

                <div class="flex w-full items-center gap-2">
                    <MudTextField @bind-Value="@_coupon" placeholder="nhập mã giảm giá" Variant="Variant.Outlined" Style="height: 40px" />
                    <MudIcon Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Class="cursor-pointer" hidden="@(_discountDetail == null)" @onclick="RemoveDiscount" />
                    <MudButton Class="!h-10 w-[8rem] flex-shrink-0" Color="Color.Dark" Variant="Variant.Filled" Disabled="@(!_data.Any() || _addressDefault == null || _isSubmitting)" OnClick="ApplyDiscountCodeValue">
                        Áp Dụng
                    </MudButton>
                </div>
            </div>

            <div class="flex w-full flex-col gap-2 rounded-lg border border-solid border-slate-200 p-3 shadow">
                <h3 class="text-lg font-bold">Tóm tắt đơn hàng</h3>
                <div class="flex justify-between gap-2">
                    <span class="flex-shrink-0 text-sm uppercase">Tiền sản phẩm:</span>
                    <span class="whitespace-pre-wrap text-sm font-medium">@FormatCurrency(CalculateSubtotal())</span>
                </div>
                <div class="flex justify-between gap-2">
                    <span class="flex-shrink-0 text-sm uppercase">Phí giao hàng:</span>
                    <span class="whitespace-pre-wrap text-sm font-medium">@FormatCurrency(_shippingPrice)</span>
                </div>
                <div class="flex justify-between gap-2">
                    <span class="flex-shrink-0 text-sm uppercase">Giảm giá:</span>
                    <span class="whitespace-pre-wrap text-sm font-medium">@FormatCurrency(_discountAmount)</span>
                </div>
                <div class="flex justify-between gap-2">
                    <span class="flex-shrink-0 text-sm uppercase">Trừ phí vận chuyển:</span>
                    <span class="whitespace-pre-wrap text-sm font-medium">@FormatCurrency(_discountShippingFee)</span>
                </div>
                <div class="flex justify-between gap-2">
                    <span class="flex-shrink-0 text-sm font-bold uppercase">Tổng tiền:</span>
                    <span class="whitespace-pre-wrap text-sm font-medium">@FormatCurrency(CalculateTotal())</span>
                </div>
                <MudButton Class="!h-10" Color="Color.Dark" Variant="Variant.Filled" Disabled="@(!_data.Any() || _addressDefault == null || _isSubmitting)" OnClick="OnCheckout">
                    Đặt Hàng
                </MudButton>
            </div>
        </div>
    </div>
    }
</section>

@code {
    private readonly DialogOptions _maxWidth = new() { MaxWidth = MaxWidth.Small, FullWidth = true };
    private readonly CancellationTokenSource _cts = new();
    private readonly CultureInfo _vietnameseCulture = new("vi-VN");

    private List<CartItemWithProductDTO> _data = [];
    private List<DAL.Models.Address> _address = [];
    private DAL.Models.Address? _addressDefault;
    private DAL.Models.DiscountCode? _discountDetail;
    private GetMeResponseDTO _me = new();
    private bool _isCheckoutSuccess = false;

    private string _coupon = string.Empty;
    private string _cartId = string.Empty;
    private string _token = string.Empty;
    private string _note = string.Empty;
    private int _parsedCartId = 0;
    private decimal _shippingPrice = 0;
    private decimal _discountAmount = 0;
    private decimal _discountShippingFee = 0;
    private int _selectedAddress = 0;
    private int _selectPaymentMethod = Constant.PaymentMethod.CashBack;
    private int _orderIdSuccess = -1;
    private string _orderCodeSuccess = string.Empty;
    private bool _isSubmitting = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                await InitializeAsync();
            }
            catch (Exception ex)
            {
                _snackbar.Add($"Lỗi khởi tạo: {ex.Message}", Severity.Error);
            }
        }
    }

    public async ValueTask DisposeAsync()
    {
        _cts?.Cancel();
        _cts?.Dispose();
    }

    private async Task InitializeAsync()
    {
        _token = await localStorage.GetItemAsStringAsync(Constant.TokenNameLocalStorage, _cts.Token) ?? string.Empty;
        _cartId = await localStorage.GetItemAsStringAsync(Constant.AuthCartIdLocalStorage, _cts.Token) ?? string.Empty;

        var resultMe = await localStorage.GetItemAsStringAsync(Constant.UserInfoLocalStorage);
        if (!string.IsNullOrEmpty(resultMe))
        {
            try
            {
                _me = JsonSerializer.Deserialize<GetMeResponseDTO>(resultMe) ?? new GetMeResponseDTO();
            }
            catch
            {
                _me = new GetMeResponseDTO();
            }
        }

        await LoadDataAsync();
        await LoadAddressAsync();
        await GetShippingFeeAsync();
        StateHasChanged();
    }

    private async Task LoadDataAsync()
    {
        if (string.IsNullOrEmpty(_cartId))
            return;

        if (!int.TryParse(_cartId, out _parsedCartId))
            return;

        var result = await _cartItemService.GetAllCartItemWithDetailByCartId(_parsedCartId, _token);

        if (result.IsSuccess && result.Data != null)
        {
            _data = result.Data;
        }
    }

    private async Task LoadAddressAsync()
    {
        if (_me?.Id <= 0)
            return;

        var resAddressMe = await _addressService.GetAllByCustomerId(_me.Id);

        if (resAddressMe.IsSuccess && resAddressMe.Data?.Count > 0)
        {
            _address = resAddressMe.Data;
            _addressDefault = _address.FirstOrDefault(a => a.IsDefault);
            if (_addressDefault != null)
            {
                _selectedAddress = _addressDefault.Id;
            }
        }
    }

    private async Task GetShippingFeeAsync()
    {
        if (!_data.Any())
        {
            _shippingPrice = 0;
            return;
        }

        if (_addressDefault == null || 
            string.IsNullOrEmpty(_addressDefault.District) || 
            string.IsNullOrEmpty(_addressDefault.Ward))
        {
            _shippingPrice = 0;
            return;
        }

        if (!int.TryParse(_addressDefault.District, out int districtId))
        {
            _shippingPrice = 0;
            return;
        }

        try
        {
            _isSubmitting = true;

            var requestData = new CalculateFeeRequestModel
            {
                ToDistrictId = districtId,
                ToWardCode = _addressDefault.Ward,
                Items = _data.Select(item => new FeeItemModel
                {
                    Quantity = item.Quantity,
                    Name = item.productName ?? string.Empty,
                    Length = 35,
                    Weight = 500,
                    Width = 35,
                    Height = 5,
                }).ToList()
            };

            var resCalculate = await _addressService.CaculateFee(requestData);

            if (resCalculate.IsSuccess && resCalculate.Data?.Data != null)
            {
                _shippingPrice = resCalculate.Data.Data.Total;
            }
            else
            {
                _shippingPrice = 0;
            }
        } 
        catch(Exception ex) {}
        finally
        {
            _isSubmitting = false;
        }
    }

    private async Task OnChangeAddress(int addressId)
    {
        if (_isSubmitting) return;
        try
        {
            _isSubmitting = true;
            _addressDefault = _address.FirstOrDefault(a => a.Id == addressId);
            _selectedAddress = addressId;

            await GetShippingFeeAsync();
            await ReapplyDiscountsAsync();
            StateHasChanged();
        }
        catch(Exception ex) {}
        finally
        {
            _isSubmitting = false;
        }
    }

    private async Task OpenDialogCreateAddress()
    {
        var dialog = await _dialogService.ShowAsync<Common.User.CreateAddressDialog>("Options Dialog", _maxWidth);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            await LoadAddressAsync();
            await GetShippingFeeAsync();
            await ReapplyDiscountsAsync();
            StateHasChanged();
        }
    }

    private async Task ApplyDiscountCodeValue()
    {
        if (string.IsNullOrWhiteSpace(_coupon))
        {
            _snackbar.Add("Vui lòng nhập mã giảm giá.", Severity.Warning);
            return;
        }

        if (!_data.Any())
        {
            _snackbar.Add("Giỏ hàng không có sản phẩm.", Severity.Warning);
            return;
        }

        try
        {
            _isSubmitting = true;
            decimal totalAmount = CalculateSubtotal();

            var result = await _couponService.ApplyDiscountCodeValue(_coupon.Trim(), totalAmount, _shippingPrice, _token);

            if (result.IsSuccess && result.Data != null)
            {
                var resApply = result.Data;
                _discountAmount = resApply.DiscountAmount;
                _snackbar.Add($"Áp dụng mã thành công! Giảm giá: {FormatCurrency(_discountAmount)}", Severity.Success);

                var resultDiscountDetail = await _couponService.GetByCode(_coupon.Trim());
                if (resultDiscountDetail.IsSuccess && resultDiscountDetail.Data != null)
                {
                    _discountDetail = resultDiscountDetail.Data;
                }
            }
            else
            {
                _snackbar.Add($"Áp dụng mã {_coupon.Trim()} thất bại: {result.ErrorMessage}", Severity.Warning);
                if(_discountDetail != null)
                {
                    _coupon = _discountDetail.Code;
                } else
                {
                    _coupon = string.Empty;
                    _discountDetail = null;
                    _discountAmount = 0;
                    CalculateTotal();
                }
            }
        } 
        catch(Exception ex) {}
        finally
        {
            _isSubmitting = false;
            StateHasChanged();
        }
    }

    private async Task OnCheckout()
    {
        if (_isSubmitting) return;
        // Validate giỏ hàng
        if (!_data.Any())
        {
            _snackbar.Add("Giỏ hàng của bạn đang trống. Vui lòng thêm sản phẩm vào giỏ hàng.", Severity.Warning);
            return;
        }

        // Validate địa chỉ giao hàng
        if (_addressDefault == null)
        {
            _snackbar.Add("Vui lòng chọn địa chỉ giao hàng.", Severity.Warning);
            return;
        }

        if (_addressDefault.Id <= 0)
        {
            _snackbar.Add("Địa chỉ giao hàng không hợp lệ.", Severity.Error);
            return;
        }

        // Validate sản phẩm trong giỏ hàng
        var invalidProducts = _data.Where(item => 
            item.Quantity <= 0 || 
            item.UnitPrice <= 0 || 
            item.VariantId <= 0 ||
            string.IsNullOrWhiteSpace(item.productName)
        ).ToList();

        if (invalidProducts.Any())
        {
            _snackbar.Add("Có sản phẩm không hợp lệ trong giỏ hàng. Vui lòng kiểm tra lại.", Severity.Error);
            return;
        }

        // Validate token
        if (string.IsNullOrWhiteSpace(_token))
        {
            _snackbar.Add("Phiên đăng nhập đã hết hạn. Vui lòng đăng nhập lại.", Severity.Warning);
            return;
        }

        // Validate tổng tiền
        var subtotal = CalculateSubtotal();
        if (subtotal <= 0)
        {
            _snackbar.Add("Tổng tiền sản phẩm phải lớn hơn 0.", Severity.Error);
            return;
        }

        var total = CalculateTotal();
        if (total < 0)
        {
            _snackbar.Add("Tổng tiền thanh toán không hợp lệ. Vui lòng kiểm tra lại mã giảm giá.", Severity.Error);
            return;
        }

        try
        {
            var listProductForCheckout = _data.Select(item => new CheckoutListItem
            {
                ProductName = $"{item.productName} - {item.ColorName} - {item.SizeName}",
                Quantity = item.Quantity,
                UnitPrice = item.UnitPrice ?? 0,
                ProductVariantId = item.VariantId
            }).ToList();

            if (!listProductForCheckout.Any())
            {
                _snackbar.Add("Không có sản phẩm để thanh toán.", Severity.Error);
                return;
            }


            int? discountId = _discountDetail?.DiscountId;

            var result = await _orderService.GetCheckoutUrl(
                _token,
                checkoutBody: new CheckoutModel
                {
                    ListItemCheckout = listProductForCheckout,
                    AddressDTO = null,
                },
                discountAmount: _discountAmount + _discountShippingFee,
                shippingFee: _shippingPrice,
                note: _note.Trim() ?? string.Empty,
                shippingAddressId: _addressDefault.Id,
                paymentMethodTypeId: _selectPaymentMethod,
                discountId: discountId
            );

            if (result.IsSuccess && result.Data != null)
            {
                var data = result.Data;

                // Validate response data
                if (!data.PaymentType.HasValue)
                {
                    _snackbar.Add("Không nhận được thông tin phương thức thanh toán từ server.", Severity.Error);
                    return;
                }

                if (data.PaymentType == Constant.PaymentMethod.Transfer)
                {
                    if (string.IsNullOrWhiteSpace(data.URLPayment))
                    {
                        _snackbar.Add("Không nhận được URL thanh toán. Vui lòng thử lại hoặc liên hệ hỗ trợ.", Severity.Error);
                        return;
                    }

                    if (!data.OrderId.HasValue || data.OrderId.Value <= 0)
                    {
                        _snackbar.Add("Không nhận được mã đơn hàng. Vui lòng thử lại.", Severity.Error);
                        return;
                    }

                    await ClearCartAfterCheckout();
                    await _cartStateService.LoadCartDetailsAsync();

                    _snackbar.Add("Chuyển hướng đến cổng thanh toán...", Severity.Info);
                    navigation.NavigateTo(data.URLPayment);
                }
                else if (data.PaymentType == Constant.PaymentMethod.CashBack)
                {
                    if (!data.OrderId.HasValue || data.OrderId.Value <= 0)
                    {
                        _snackbar.Add("Không nhận được mã đơn hàng. Vui lòng thử lại hoặc liên hệ hỗ trợ.", Severity.Error);
                        return;
                    }

                    if (string.IsNullOrWhiteSpace(data.OrderCode))
                    {
                        _snackbar.Add("Không nhận được mã số đơn hàng. Vui lòng thử lại hoặc liên hệ hỗ trợ.", Severity.Error);
                        return;
                    }

                    await ClearCartAfterCheckout();

                    _isCheckoutSuccess = true;
                    _orderIdSuccess = data.OrderId.Value;
                    _orderCodeSuccess = data.OrderCode;

                    _snackbar.Add("Đặt hàng thành công! Đơn hàng sẽ được xử lý.", Severity.Success);
                    await _cartStateService.LoadCartDetailsAsync();
                    StateHasChanged();
                }
                else
                {
                    _snackbar.Add($"Phương thức thanh toán không hợp lệ: {data.PaymentType}", Severity.Error);
                }
            }
            else
            {
                var errorMessage = result.ErrorMessage ?? "Đặt hàng thất bại. Vui lòng thử lại.";

                if (result.StatusCode == "400")
                {
                    errorMessage = result.ErrorMessage ?? "Dữ liệu không hợp lệ. Vui lòng kiểm tra lại thông tin đơn hàng.";
                }
                else if (result.StatusCode == "401" || result.StatusCode == "403")
                {
                    errorMessage = "Phiên đăng nhập đã hết hạn. Vui lòng đăng nhập lại.";
                }
                else if (result.StatusCode == "500")
                {
                    errorMessage = "Lỗi hệ thống. Vui lòng thử lại sau hoặc liên hệ hỗ trợ.";
                }

                _snackbar.Add(errorMessage, Severity.Error);
            }
        }
        catch (HttpRequestException ex)
        {
            _snackbar.Add("Không thể kết nối đến server. Vui lòng kiểm tra kết nối mạng và thử lại.", Severity.Error);
        }
        catch (TaskCanceledException ex)
        {
            _snackbar.Add("Yêu cầu đã hết thời gian chờ. Vui lòng thử lại.", Severity.Warning);
        }
        catch (Exception ex)
        {
            _snackbar.Add($"Lỗi đặt hàng: {ex.Message}. Vui lòng thử lại hoặc liên hệ hỗ trợ.", Severity.Error);
        }
    }

    private async Task Delete(int id)
    {
        if (_isSubmitting) return;
        try
        {
            _isSubmitting = true;

            var result = await _cartItemService.Delete(id, _token);

            if (result)
            {
                _snackbar.Add("Xóa thành công", Severity.Success);
                await _cartStateService.LoadCartDetailsAsync();
                await LoadDataAsync();
                await GetShippingFeeAsync();
                await ReapplyDiscountsAsync();
                StateHasChanged();
            }
            else
            {
                _snackbar.Add("Đã có lỗi xảy ra", Severity.Error);
            }
        }
        catch(Exception ex) {}
        finally
        {
            _isSubmitting = false;
        }
    }

    private string FormatAddress(DAL.Models.Address address)
    {
        if (address == null)
            return string.Empty;

        var parts = new List<string>();

        if (!string.IsNullOrEmpty(address.OtherInfo))
            parts.Add(address.OtherInfo);

        if (!string.IsNullOrEmpty(address.WardName))
            parts.Add(address.WardName);

        if (!string.IsNullOrEmpty(address.DistrictName))
            parts.Add(address.DistrictName);

        if (!string.IsNullOrEmpty(address.ProvinceName))
            parts.Add(address.ProvinceName);

        return string.Join(", ", parts);
    }

    private string FormatCurrency(decimal amount)
    {
        if (amount < 0) return 0.ToString("C", _vietnameseCulture);

        return amount.ToString("C", _vietnameseCulture);
    }

    private decimal CalculateSubtotal()
    {
        return _data.Sum(i => i.Quantity * (i.UnitPrice ?? 0));
    }

    private decimal CalculateTotal()
    {
        return CalculateSubtotal() + _shippingPrice - _discountAmount - _discountShippingFee;
    }

    private async Task ReapplyDiscountsAsync()
    {
        if (string.IsNullOrEmpty(_coupon) || _discountDetail == null || !_data.Any())
        {
            _discountAmount = 0;
            _coupon = string.Empty;
            _discountDetail = null;
            return;
        }

        decimal totalAmount = CalculateSubtotal();
        var discountsToRemove = new List<ItemAppliedTemp>();

        var result = await _couponService.ApplyDiscountCodeValue(
            _discountDetail.Code.Trim(),
            totalAmount, 
            _shippingPrice, 
            _token
        );

        if (result.IsSuccess && result.Data != null)
        {
            var resApply = result.Data;
            _discountAmount = resApply.DiscountAmount;    
        }
        else if (!result.IsSuccess)
        {
            _snackbar.Add($"Mã giảm giá {_coupon} không còn đủ điều kiện áp dụng nữa.", Severity.Warning);
            _discountAmount = 0;
        }
    }

    private async Task ClearCartAfterCheckout()
    {
        foreach (var item in _data)
        {
            await _cartItemService.Delete(item.Id, _token);
        }
    }

    async Task RemoveDiscount()
    {
        _coupon = string.Empty;
        _discountDetail = null;
        _discountAmount = 0;

        CalculateTotal();
        StateHasChanged();
    }
}
