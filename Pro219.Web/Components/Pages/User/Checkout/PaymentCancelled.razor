@page "/order/payment-cancelled"
@layout MainLayout

<section class="mx-auto w-full max-w-[1032px] pb-10 pt-4">
    <div class="flex w-full flex-col items-center justify-center gap-4 p-6 text-center">
        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Class="!text-4xl" />
        <h2 class="text-2xl font-bold text-red-600">Đơn hàng đã bị hủy!</h2>
        <div class="flex justify-center gap-3">
            <MudButton Variant="Variant.Filled" Color="Color.Dark" OnClick="@(() => navigation.NavigateTo(RouterConst.User.Home))">trang chủ</MudButton>
        </div>
    </div>
</section>

@code {
    [SupplyParameterFromQuery(Name = "order-id")]
    public int _orderId { get; set; } = 0;
    private int _parsedCartId = -1;
    private string _token = string.Empty;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if(firstRender)
        {
            _token = await localStorage.GetItemAsStringAsync(Constant.TokenNameLocalStorage);
            await LoadData();
        }
    }

    async Task LoadData()
    {
        var cartId = await localStorage.GetItemAsStringAsync(Constant.AuthCartIdLocalStorage) ?? string.Empty;
        var token = await localStorage.GetItemAsStringAsync(Constant.TokenNameLocalStorage) ?? string.Empty;
        if (_orderId > 0)
        {
            var result = await _orderService.PaymentCanceled(_orderId, false);

            if (int.TryParse(cartId, out _parsedCartId))
            {
                var result2 = await _cartItemService.GetAllCartItemWithDetailByCartId(_parsedCartId, _token);

                if (result2.IsSuccess && result2.Data.Count() > 0 && !string.IsNullOrEmpty(token))
                {
                    foreach (var item in result2.Data)
                    {
                        await _cartItemService.Delete(item.Id, token);
                    }
                    await _cartStateService.LoadCartDetailsAsync();
                    StateHasChanged();
                }
            }
        }
    }
}
