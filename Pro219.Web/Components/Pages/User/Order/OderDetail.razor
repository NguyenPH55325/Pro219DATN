@using System.Timers
@implements IDisposable

@page "/orders/{id:int}/detail"
@layout MainLayout


<section class="mx-auto max-w-[1440px] p-8">
    <h1 class="text-xl font-bold uppercase md:text-2xl lg:text-3xl">Chi tiết đơn hàng</h1>

    <div class="mt-6 px-6">
        <div>
            <div class="flex items-center gap-4">
                <span class="w-full max-w-[200px] flex-shrink-0 text-sm font-bold">Mã hóa đơn:</span>
                <span class="text-sm">@_orderDetail?.OrderCode</span>
            </div>
            <div class="flex items-center gap-4">
                <span class="w-full max-w-[200px] flex-shrink-0 text-sm font-bold">Ngày đặt hàng:</span>
                <span class="text-sm">@_orderDetail?.OrderDate.ToString("dd/MM/yyyy HH:mm:ss")</span>
            </div>
            <div class="flex items-center gap-4">
                <span class="w-full max-w-[200px] flex-shrink-0 text-sm font-bold">Địa chỉ nhận hàng:</span>
                <div class="text-sm">
                @{
                    @if (_orderDetail != null && _orderDetail.Address != null)
                    {   
                        <span class="text-sm font-medium">
                            @_orderDetail.Address.OtherInfo@((!string.IsNullOrEmpty(_orderDetail.Address.OtherInfo) && (!string.IsNullOrEmpty(_orderDetail.Address.Street) || !string.IsNullOrEmpty(_orderDetail.Address.District) || !string.IsNullOrEmpty(_orderDetail.Address.City)) ? ", " : ""))
                                @_orderDetail.Address.Street@((!string.IsNullOrEmpty(_orderDetail.Address.Street) && (!string.IsNullOrEmpty(_orderDetail.Address.District) || !string.IsNullOrEmpty(_orderDetail.Address.City)) ? ", " : ""))
                            @_orderDetail.Address.District@((!string.IsNullOrEmpty(_orderDetail.Address.District) && !string.IsNullOrEmpty(_orderDetail.Address.City) ? ", " : ""))
                            @_orderDetail.Address.City
                        </span>
                            <span class="text-sm font-medium">(@_orderDetail.Address?.Name <span class="text-slate-500">@((!string.IsNullOrEmpty(_orderDetail.Address?.Phone) ? " - " : ""))@_orderDetail.Address?.Phone</span>)</span>
                    }
                }
                </div>
            </div>
            <div class="flex items-center gap-4">
                <span class="w-full max-w-[200px] flex-shrink-0 text-sm font-bold">Phương thức thanh toán:</span>
                <span class="text-sm">@(_orderDetail?.PaymentMethodId == Constant.PaymentMethod.CashBack ? "Tiền mặt" : "Chuyển khoản")</span>
            </div>
            <div class="flex items-center gap-4">
                <span class="w-full max-w-[200px] flex-shrink-0 text-sm font-bold">Trạng thái thanh toán:</span>
                <span class="text-sm">@_orderDetail?.PaymentStatus</span>
            </div>
            <div class="flex items-center gap-4">
                <span class="w-full max-w-[200px] flex-shrink-0 text-sm font-bold">Trạng thái hóa đơn:</span>
                <span class="text-sm">@_orderDetail?.OrderStatus</span>
            </div>
            <div class="flex items-center gap-4">
                <span class="w-full max-w-[200px] flex-shrink-0 text-sm font-bold">Chi tiết:</span>
                <span class="text-sm">@_orderDetail?.Note</span>
            </div>
            <div class="flex items-center gap-4">
                <span class="w-full max-w-[200px] flex-shrink-0 text-sm font-bold">Tổng tiền sản phẩm:</span>
                <span class="text-sm">@_orderDetail?.TotalAmount.ToString("C", vietnameseCulture)</span>
            </div>
            <div class="flex items-center gap-4">
                <span class="w-full max-w-[200px] flex-shrink-0 text-sm font-bold">Phí giao hàng:</span>
                <span class="text-sm">@_orderDetail?.ShippingFee.ToString("C", vietnameseCulture)</span>
            </div>
            <div class="flex items-center gap-4">
                <span class="w-full max-w-[200px] flex-shrink-0 text-sm font-bold">Giảm giá:</span>
                <span class="text-sm">@_orderDetail?.DiscountAmount.ToString("C", vietnameseCulture)</span>
            </div>
            <div class="flex items-center gap-4">
                <span class="w-full max-w-[200px] flex-shrink-0 text-sm font-bold">Tổng tiền thanh toán:</span>
                <span class="text-sm">@_orderDetail?.FinalAmount.ToString("C", vietnameseCulture)</span>
            </div
            <div class="flex gap-4">
                <span class="w-full max-w-[200px] flex-shrink-0 text-sm font-bold">Lịch sử đơn hàng:</span>
                <span class="whitespace-pre-wrap text-sm">@GetHistoryOrder(_orderDetail?.StatusHistory)</span>
            </div>
        </div>
        <MudButton Class="mt-6" Variant="Variant.Filled" Color="Color.Error" OnClick="CancelOrder" hidden="@(_orderDetail?.Status != Constant.OrderStatus.StatusPending)">Hủy đơn hàng</MudButton>
    </div>

        <div class="mt-6 px-6">
        @if (_orderDetail != null && _orderDetail.Items.Any())
        {
            <div>
                <MudTable Bordered Items="@_orderDetail.Items" Loading="@_loading" Class="w-full" Dense="true" Hover="true" Virtualize="true" FixedHeader="true" HorizontalScrollbar="true">
                    <HeaderContent>
                        <MudTh hidden><MudTableSortLabel SortLabel="OrderItemId" T="string" hidden>OrderItemId</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel SortLabel="Ảnh" T="string">Ảnh</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel SortLabel="Sản phẩm" T="string">Sản phẩm</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel SortLabel="Số lượng" T="string">Số lượng</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel SortLabel="Đơn giá" T="string">Đơn giá</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel SortLabel="Thành tiền" T="string">Thành tiền</MudTableSortLabel></MudTh>
                        <MudTh>Đánh giá</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="OrderItemId" hidden>@context.OrderItemId</MudTd>
                        <MudTd DataLabel="Ảnh">
                            @{
                                var productImage = _productImages.FirstOrDefault(i => i.ProductVariantId == context.ProductVariantId);
                                if (productImage != null)
                                {
                                    <MudImage Src="@productImage.ImageUrl" Width="100" />
                                }
                                else
                                {
                                    <MudImage Src="/Assets/Images/default-image.png" Width="100" />
                                }
                            }
                        </MudTd>
                        <MudTd DataLabel="Sản phẩm">
                            <button @onclick="@(() => navigation.NavigateTo(RouterConst.User.ProductDetail + $"/{context.ProductId}"))">@context.ProductName @(context.Color != null ? $"- {context.Color}" : "") @(context.Size != null ? $"- {context.Size}" : "")</button>
                        </MudTd>
                        <MudTd DataLabel="Số lượng">@context.Quantity</MudTd>
                        <MudTd DataLabel="Đơn giá">@context.UnitPrice.ToString("C", vietnameseCulture)</MudTd>
                        <MudTd DataLabel="Thành tiền">@((context.Quantity * context.UnitPrice).ToString("C", vietnameseCulture))</MudTd>
                        <MudTd DataLabel="Đánh giá">
                            @if((_orderDetail?.Status == Constant.OrderStatus.StatusDone) && !context.IsReviewed)
                            {
                                <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled=@(_isDialogOpen) OnClick="@(() => HandleOpenReviewDialog(context.OrderItemId, context.ProductId, context.CustomerId))">Đánh giá</MudButton>
                            } else
                            {
                                if(_orderDetail?.Status != Constant.OrderStatus.StatusDone) {
                                    <span class="font-bold text-yellow-300">Đơn hàng chưa hoàn thành</span>
                                } else
                                {
                                    <span class="font-bold text-green-600">Đã đánh giá</span>
                                }
                            }
                        </MudTd>
                    </RowTemplate>
                    <NoRecordsContent>
                        <MudText>Không có dữ liệu.</MudText>
                    </NoRecordsContent>
                    <LoadingContent>
                        <div class="flex w-full flex-col gap-3">
                            @{
                                for (var i = 0; i < Constant.DefaultSkeletons; i++)
                                {
                                    <div class="flex items-center justify-between gap-2">
                                        <MudSkeleton Width="100%" Height="3rem" />
                                        <MudSkeleton Width="100%" Height="3rem" />
                                        <MudSkeleton Width="100%" Height="3rem" />
                                        <MudSkeleton Width="100%" Height="3rem" />
                                        <MudSkeleton Width="100%" Height="3rem" />
                                        <MudSkeleton Width="100%" Height="3rem" />
                                    </div>
                                }
                            }
                        </div>
                    </LoadingContent>
                    <PagerContent>
                        <MudTablePager hidden HidePageNumber HidePagination HideRowsPerPage  />
                    </PagerContent>
                </MudTable>
            </div>
        } else
        {
            <p>Không có đơn hàng nào.</p>
        }
    </div>
</section>

@code {
    [Parameter]
    public int id { get; set; }

    readonly DialogOptions _maxWidth = new() { MaxWidth = MaxWidth.Medium, FullWidth = true };
    private Timer? _timer;

    private Pro219.Web.DTOs.OrderDetailDTO _orderDetail = null;
    private List<DAL.Models.ProductVariant> _productVariants = [];
    private List<DAL.Models.ProductImage> _productImages = [];
    private List<DAL.Models.Product> _products = [];
    private bool _loading = true;
    private bool _isDialogOpen = false;
    CultureInfo vietnameseCulture = new CultureInfo("vi-VN");

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
        _loading = false;

        _timer = new Timer(4000);
        _timer.Elapsed += async (sender, e) => await RefreshData();
        _timer.AutoReset = true;
        _timer.Enabled = true;

        StateHasChanged();
    }

    async Task LoadData()
    {
        var resOrderDetail = await _orderService.GetById(id);
        if (resOrderDetail.IsSuccess && resOrderDetail.Data != null)
        {
            var resOrderDetailWithAny = await _orderService.GetOrderDetailByUserId(resOrderDetail.Data.OrderCode);

            if (resOrderDetailWithAny.IsSuccess && resOrderDetailWithAny.Data != null)
            {
                _orderDetail = resOrderDetailWithAny.Data;
            }
        }
    }

    async Task CancelOrder()
    {
        if (_orderDetail == null)
        {
            _snackbar.Add("Đơn hàng không tồn tại", Severity.Error);
            return;
        }
        var token = await localStorage.GetItemAsStringAsync(Constant.TokenNameLocalStorage);

        var newOrderUpdate = new OrderUpdateSatusModel();
        newOrderUpdate.OrderId = _orderDetail.OrderId;
        newOrderUpdate.Status = Constant.OrderStatus.StatusCanceledByUser;
        newOrderUpdate.PaymentStatus = "Đã hủy";
        var orderMess = Constant.OrderStatusArray.FirstOrDefault(o => o.id == Constant.OrderStatus.StatusCanceledByUser);
        newOrderUpdate.OrderStatus = orderMess != null ? orderMess.label : "Không xác định";

        var result = await _orderService.UpdateStatus(newOrderUpdate, token ?? "");

        if (result.IsSuccess)
        {
            _snackbar.Add("Đã hủy đơn hàng", Severity.Warning);
            await LoadData();
            StateHasChanged();
        }
        else
        {
            if (!string.IsNullOrEmpty(result.ErrorMessage))
            {
                _snackbar.Add(result.ErrorMessage, Severity.Warning);
            } else
            {
                _snackbar.Add(result.ErrorMessage ?? "Có lỗi xảy ra khi cập nhật trạng thái", Severity.Error);
            }
        }
    }

    async Task HandleOpenReviewDialog(int orderItemId, int? productId, int customerId)
    {
        try
        {
            _isDialogOpen = true;

           var createReviewParameter = new DialogParameters();
            createReviewParameter.Add("productId", productId);
            createReviewParameter.Add("orderItemId", orderItemId);
            createReviewParameter.Add("customerId", customerId);

            var dialog = await _dialogService.ShowAsync<Common.User.ReviewDialog>("Options Dialog", createReviewParameter, _maxWidth);
            var result = await dialog.Result;

            if (!result.Canceled)
            {
                await LoadData();
                StateHasChanged();
            }
        }catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
        finally 
        {
            _isDialogOpen = false;
            StateHasChanged();
        }
    }

    string GetHistoryOrder(List<StatusHistoryEntry> histories)
    {
        if (histories == null || histories.Count == 0) return "";

        var result = "";

        foreach(var i in histories)
        {
            result += i.OrderStatus.ToString() + " vào lúc: " + i.DateTime.ToString();
            result += "\n";
        }
        return result;
    }

    private async Task RefreshData()
    {
        if (_loading || _isDialogOpen) return;

        await InvokeAsync(async () =>
        {
            await LoadData();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        _timer?.Stop();
        _timer?.Dispose();
    }
}