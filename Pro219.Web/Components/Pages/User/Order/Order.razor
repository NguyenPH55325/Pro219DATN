@page "/orders"
@layout MainLayout

<PageTitle>@Constant.PageTitleUser Đơn Mua</PageTitle>

<section class="mx-auto max-w-[1440px] p-8">
    <h1 class="text-xl font-bold uppercase md:text-2xl lg:text-3xl">Đơn hàng của bạn</h1>

    <div class="my-6 grid w-full grid-cols-3 gap-x-6 gap-y-4">
        <div>
            <MudTextField T="string" Placeholder="Tìm kiếm" Adornment="Adornment.Start" Value="@_searchValue"
                            AdornmentIcon="@Icons.Material.Filled.Search" Variant="Variant.Outlined" IconSize="Size.Medium" Class="mt-0" ValueChanged="onChangeSearch" Immediate=true></MudTextField>
        </div>
        <div>
            <MudSelect T="int" Variant="Variant.Outlined" Placeholder="Danh mục" Value="@_searchPaymentMethod" ValueChanged="OnChangePaymentMethod">
                <MudSelectItem Value="0">Tất cả</MudSelectItem>
                <MudSelectItem Value="1">Tiền mặt</MudSelectItem>
                <MudSelectItem Value="2">Chuyển khoản</MudSelectItem>
            </MudSelect>
        </div>
        <div class="flex items-center gap-2">
            <MudButton Variant="Variant.Outlined" OnClick="OnSearch" Class="h-14 w-full"><MudIcon Icon="@Icons.Material.Filled.Search" Class="mr-2" /> Tìm kiếm</MudButton>
            <MudButton Variant="Variant.Outlined" OnClick="OnReset" Class="h-14 w-full"><MudIcon Icon="@Icons.Material.Filled.Filter" Class="mr-2" /> Đặt lại</MudButton>
        </div>
    </div>

    <div class="mt-6">
        @if (_orders.Any())
        {
            <div>
                <MudTable Bordered Items="@_orders" Loading="@_loading" Class="w-full" Dense="true" Hover="true" Virtualize="true" FixedHeader="true" HorizontalScrollbar="true">
                    <HeaderContent>
                        <MudTh hidden><MudTableSortLabel SortLabel="OrderId" T="string" hidden>OrderId</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel SortLabel="Mã hóa đơn" T="string">Mã hóa đơn</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel SortLabel="Ngày đặt hàng" T="string">Ngày đặt hàng</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel SortLabel="Địa chỉ nhận hàng" T="string">Địa chỉ nhận hàng</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel SortLabel="Phương thức thanh toán" T="string">Phương thức thanh toán</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel SortLabel="Trạng thái thanh toán" T="string">Trạng thái thanh toán</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel SortLabel="Trạng thái hóa đơn" T="string">Trạng thái hóa đơn</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel SortLabel="Chi tiết" T="string">Thao tác</MudTableSortLabel></MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="OrderId" hidden>@context.OrderId</MudTd>
                        <MudTd DataLabel="Mã hóa đơn">@context.OrderCode</MudTd>
                        <MudTd DataLabel="Địa chỉ nhận hàng">@context.OrderDate.ToString("dd/MM/yyyy HH:mm:ss")</MudTd>
                        <MudTd DataLabel="Ngày đặt hàng">
                            <div>
                                <p class="text-sm font-medium">@context.CustomerName <span class="text-slate-500">@((!string.IsNullOrEmpty(context.Phone) ? " - " : ""))@context.Phone</span></p>
                                <p class="text-sm font-medium">
                                    @context?.Address@((!string.IsNullOrEmpty(context?.Address) && (!string.IsNullOrEmpty(context?.WardName) || !string.IsNullOrEmpty(context?.DistrictName) || !string.IsNullOrEmpty(context?.ProvinceName)) ? ", " : ""))
                                    @context?.WardName@((!string.IsNullOrEmpty(context?.WardName) && (!string.IsNullOrEmpty(context?.DistrictName) || !string.IsNullOrEmpty(context?.ProvinceName)) ? ", " : ""))
                                    @context?.DistrictName@((!string.IsNullOrEmpty(context?.DistrictName) && !string.IsNullOrEmpty(context?.ProvinceName) ? ", " : ""))
                                    @context?.ProvinceName
                                </p>
                            </div>
                        </MudTd>
                        <MudTd DataLabel="Phương thức thanh toán">@(context.PaymentMethodId == Constant.PaymentMethod.CashBack ? "Tiền mặt" : "Chuyển khoản")</MudTd>
                        <MudTd DataLabel="Trạng thái thanh toán">@context.PaymentStatus</MudTd>
                        <MudTd DataLabel="Trạng thái hóa đơn">
                            <span class="@GetOrderStatusClass(context.Status) rounded-full px-3 py-1 text-xs font-medium text-white">
                                @GetOrderStatusMessage(context.Status)
                            </span>
                        </MudTd>
                        <MudTd DataLabel="Chi tiết">
                            <MudIconButton OnClick=@(() => navigation.NavigateTo(RouterConst.User.OrderDetail.Replace(":id", context.OrderId.ToString()))) Icon="@Icons.Material.Filled.Menu" />
                            <MudIconButton OnClick=@(() => DowloadPDF(context.OrderId)) Icon="@Icons.Material.Filled.Download" Disabled="@(context.Status != Constant.OrderStatus.StatusDone)" />
                        </MudTd>
                    </RowTemplate>
                    <NoRecordsContent>
                        <MudText>Không có dữ liệu.</MudText>
                    </NoRecordsContent>
                    <LoadingContent>
                        <div class="flex w-full flex-col gap-3">
                            @{
                                for (var i = 0; i < Constant.DefaultSkeletons; i++)
                                {
                                    <div class="flex items-center justify-between gap-2">
                                        <MudSkeleton Width="100%" Height="3rem" />
                                        <MudSkeleton Width="100%" Height="3rem" />
                                        <MudSkeleton Width="100%" Height="3rem" />
                                        <MudSkeleton Width="100%" Height="3rem" />
                                        <MudSkeleton Width="100%" Height="3rem" />
                                        <MudSkeleton Width="100%" Height="3rem" />
                                    </div>
                                }
                            }
                        </div>
                    </LoadingContent>
                    <PagerContent>
                        <MudTablePager />
                    </PagerContent>
                </MudTable>
            </div>
        } else
        {
            <p>Không có đơn hàng nào.</p>
        }
    </div>
</section>

@code {
    private List<DAL.Models.Order> _orders = [];
    private GetMeResponseDTO _me = new GetMeResponseDTO();

    private string _searchValue = string.Empty;
    private int _searchPaymentMethod = 0;
    private bool _loading = true;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if(firstRender)
        {
            var resultMe = await localStorage.GetItemAsStringAsync(Constant.UserInfoLocalStorage);

            if (!string.IsNullOrEmpty(resultMe))
            {
                _me = JsonSerializer.Deserialize<GetMeResponseDTO>(resultMe);
            }

            await LoadData();
            _loading = false;
            StateHasChanged();
        }
    }

    private async Task LoadData()
    {
        var resOrder = await _orderService.GetAllByCustomerId(_me.Id, _searchValue, _searchPaymentMethod);
        var resAsddress = await _addressService.GetAll();
        if (resOrder.IsSuccess && resOrder.Data.Count() > 0)
        {
            _orders = resOrder.Data;
        }
        else if (resOrder.IsSuccess && resOrder.Data.Count() == 0)
        {
            _orders = [];
        } else
        {
            
        }
    }

    private void onChangeSearch(string value)
    {
        _searchValue = value;
    }

    private void OnChangePaymentMethod(int value)
    {
        _searchPaymentMethod = value;
    }

    private async Task OnSearch()
    {
        await LoadData();
    }

    private async Task OnReset()
    {
        _searchValue = string.Empty;
        _searchPaymentMethod = 0;
        await LoadData();
    }

    private async Task DowloadPDF(int id)
    {
        // Hiển thị loading nếu cần (tùy chọn)
        _loading = true;

        var result = await _orderService.GetInvoicePdf(id);

        if (result.IsSuccess)
        {
            var base64 = Convert.ToBase64String(result.Data);
            // Lấy mã đơn hàng để đặt tên file cho chuyên nghiệp
            var orderCode = _orders.FirstOrDefault(o => o.OrderId == id)?.OrderCode ?? id.ToString();

            await JS.InvokeVoidAsync("downloadFile", "application/pdf", base64, $"hoadon_{orderCode}.pdf");

            _snackbar.Add("Tải hóa đơn thành công!", Severity.Success);
        }
        else
        {
            _snackbar.Add($"Lỗi: {result.ErrorMessage}", Severity.Error);
        }

        _loading = false;
        StateHasChanged();
    }

    private string GetOrderStatusMessage(byte? status)
    {
        if (!status.HasValue)
            return "Không xác định";

        var statusItem = Constant.OrderStatusArray.FirstOrDefault(s => s.id == status.Value);
        return statusItem?.label ?? "Không xác định";
    }

    private string GetOrderStatusClass(byte? status) =>
        status switch
        {
            Constant.OrderStatus.StatusNoCheckout => "bg-gray-200",
            Constant.OrderStatus.StatusPending => "bg-gray-400",
            Constant.OrderStatus.StatusConfirm => "bg-blue-500",
            Constant.OrderStatus.StatusCanceledByUser => "bg-red-500",
            Constant.OrderStatus.StatusShipping => "bg-gray-700",
            Constant.OrderStatus.StatusShippingDone => "bg-green-500",
            Constant.OrderStatus.StatusShippingFailed => "bg-red-500",
            Constant.OrderStatus.StatusDone => "bg-green-500",
            _ => "bg-gray-400"
        };
}