@page "/sign-up"
@layout MainLayout

<PageTitle>@Constant.PageTitleUser Sign Up</PageTitle>

<section class="mx-auto my-6 w-full max-w-[30rem] rounded-lg border border-gray-200 px-4 py-6">
    <h1 class="text-xl font-bold uppercase">Đăng Ký Tài Khoản</h1>

    <p class="mt-1 text-sm font-medium text-[#666666]">Nhập thông tin đăng ký:</p>

    <MudDivider Class="!my-4" />
    <EditForm Model="_model" OnValidSubmit="OnRegister" class="flex w-full flex-col gap-4">
        <DataAnnotationsValidator />

        <MudTextField @bind-Value="@_model.FullName" For="@(() => _model.FullName)" Placeholder="Họ và tên" Variant="Variant.Outlined" FullWidth />
        <MudDatePicker @bind-Date="@_model.DateOfBirth" For="@(() => _model.DateOfBirth)" Editable="true" Mask="@(new DateMask("dd/MM/yyyy"))" DateFormat="dd/MM/yyyy" Placeholder="01/01/2000" Variant="Variant.Outlined" ShowToolbar="false" />
        <MudTextField @bind-Value="@_model.Email" For="@(() => _model.Email)" Placeholder="Email" Variant="Variant.Outlined" FullWidth />
        <MudTextField @bind-Value="@_model.PhoneNumber" For="@(() => _model.PhoneNumber)" Placeholder="Số điện thoại" Variant="Variant.Outlined" FullWidth />
        <MudTextField @bind-Value="@_model.PasswordHash" For="@(() => _model.PasswordHash)" Placeholder="Mật khẩu" Variant="Variant.Outlined" InputType="@PasswordInput" Adornment="Adornment.End" AdornmentIcon="@PasswordInputIcon" OnAdornmentClick="ShowHidePassword" AdornmentAriaLabel="Show Password" FullWidth />
        
        <MudButton Class="!h-12 w-full rounded-lg !bg-black !text-white" ButtonType="ButtonType.Submit">Đăng Ký</MudButton>
    </EditForm>

    <div class="mt-4 flex items-center gap-2">
        <span class="text-sm text-[#666666]">Đã có tài khoản?</span>
        <a href="@RouterConst.User.Login" class="text-sm font-medium text-[#252a2b]">Đăng nhập</a>
    </div>
</section>

@code {
    RegisterModel _model = new RegisterModel();
    private bool _isPasswordVisible = false;

    InputType PasswordInput => _isPasswordVisible ? InputType.Text : InputType.Password;
    string PasswordInputIcon => _isPasswordVisible ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff;

    void ShowHidePassword()
    {
        _isPasswordVisible = !_isPasswordVisible;
        StateHasChanged();
    }

    async Task OnRegister()
    {
        var response = await _authService.RegisterCustomer(_model);
        if (response.isSuccess == true)
        {
            navigation.NavigateTo(RouterConst.User.Login);
            _snackbar.Add("Đăng ký thành công!", Severity.Success);

        }
        else
        {
            var errorMess = Constant.Errors[response.Code];
            _snackbar.Add(errorMess != null ? errorMess : "Đăng ký không thành công!", Severity.Warning);
        }
    }
}