@page "/product/detail/{id:int}"
@layout MainLayout
@using Pro219.Web.DTOs
@using MudBlazor

<PageTitle>@Constant.PageTitleUser @(_product?.Name ?? "Chi tiết sản phẩm")</PageTitle>

@if (_product == null)
{
    <div class="d-flex mt-10 justify-center">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
    </div>
}
else
{
    <section class="mx-auto mb-10 mt-4 w-full max-w-screen-xl">
        <div class="mt-2 flex h-full w-full flex-col gap-4 md:flex-row lg:flex-row">
            <div class="w-full md:w-[calc(100%-27rem)] lg:w-[calc(100%-27rem)]">
                <MudCarousel Class="mud-width-full !aspect-square" ShowBullets="true" AutoCycle="false" TData="string">
                    @if (_images.Any()) {
                        @foreach (var item in _images)
                        { 
                            <MudCarouselItem Class="items-center">
                                    <img src="@item" alt="image" class="aspect-square w-full object-cover" />
                            </MudCarouselItem>
                        }
                    } else
                    {
                        <MudCarouselItem Class="items-center">
                                <img src="@Constant.DefaultImages" alt="image" class="aspect-square w-full object-cover" />
                        </MudCarouselItem>
                    }
                </MudCarousel>
            </div>
            <div class="h-fit w-full flex-shrink-0 p-3 shadow md:w-[26rem] lg:w-[26rem]">
                <h1 class="mb-2 text-base font-medium">@_product?.Name</h1>
                @if (IsOutOfStock())
                {
                    <span class="text-sm font-medium text-red-500">Hết hàng (@_quantityShow sản phẩm)</span>
                }
                else
                {
                    <span class="text-sm font-medium text-green-600">Còn hàng (@_quantityShow sản phẩm)</span>
                }

                <MudDivider Class="!my-2.5 !border-dotted" />

                <span class="text-xl font-bold">
                    @_currentPrice.ToString("C", vietnameseCulture)
                </span>

                <div class="mt-2">
                    <p class="mb-2 text-sm font-medium uppercase">Màu sắc:  <span class="font-bold">@_selectedColorName</span></p>
                    <div class="flex flex-wrap items-center gap-2">
                        @if(_product.AvailableColors != null && _product.AvailableColors.Any())
                        {
                            @foreach (var color in _product.AvailableColors)
                            {
                                <button @onclick="() => SelectColor(color)"
                                     class="h-9 w-9 rounded-full cursor-pointer !border border-solid border-slate-400"
                                     style="background-color: @color.HexCode;">
                                </button>
                            }
                        }
                    </div>
                </div>

                <div class="mt-2">
                    <p class="mb-2 text-sm font-medium uppercase">Kích thước</p>
                    <div class="flex flex-wrap items-center gap-2">
                        @if(_product.AvailableSizes != null && _product.AvailableSizes.Any())
                        {
                            @foreach (var size in _product.AvailableSizes)
                            {
                                var isAvaliable = IsSizeAvailableForColor(size.Id);
                                var className = isAvaliable ? "!border-black bg-black opacity-50 !cursor-default" : "";
                                <button @onclick="() => SelectSize(size.Id)"
                                        disabled="@isAvaliable"
                                        class="flex h-9 w-9 items-center justify-center border-solid border @(GetSizeClass(size.Id)) @(className)">
                                    @size.Name
                                </button>
                            }
                        }
                    </div>
                </div>

                <div class="my-4 flex">
                    <MudIconButton Class="!flex !h-[1.875rem] !w-[1.875rem] !cursor-pointer !items-center !justify-center" @onclick="DecreaseQuantity" Icon="@Icons.Material.Filled.Remove" Size="Size.Small" Disabled="@((_quantity == 1) || (_selectedColorId == 0 && _selectedSizeId == 0))" />
                    
                    <span class="flex h-[1.875rem] w-10 items-baseline justify-center border bg-gray-50 p-1">@_quantity</span>

                    <MudIconButton Class="!flex !h-[1.875rem] !w-[1.875rem] !cursor-pointer !items-center !justify-center" @onclick="IncreaseQuantity" Icon="@Icons.Material.Filled.Add" Size="Size.Small" Disabled="@(_selectedColorId == 0 && _selectedSizeId == 0)" />
                </div>

                <div class="flex justify-between">
                    <button class="w-[49%] bg-black py-3 uppercase text-white" @onclick="AddToCart">Thêm Giỏ Hàng</button>
                    <button class="w-[49%] bg-black py-3 uppercase text-white" @onclick="ToCheckout">Mua Ngay</button>
                </div>

                @if (_isShowButton)
                {
                    <div class="mt-2">
                        @if(_isInWishlist)
                        {
                            <button class="w-full border border-solid border-red-500 py-3 text-red-500" @onclick="AddWishlist">
                                <MudIcon Icon="@Icons.Material.Filled.Favorite" /> <span class="ml-2">Yêu Thích</span>
                            </button>   
                        }
                        else
                        {
                            <button class="w-full border border-solid border-slate-200 py-3" @onclick="AddWishlist">
                                <MudIcon Icon="@Icons.Material.Filled.FavoriteBorder" /> <span class="ml-2">Yêu Thích</span>
                            </button>
                        }
                    </div>
                }
            </div>
        </div>
    </section>

    
}

<section class="mx-auto my-10 w-full max-w-screen-xl">
    <h2 class="w-fit border-b-4 border-solid border-black text-2xl font-bold uppercase">Đánh giá sản phẩm</h2>

    <div class="relative mt-4 flex items-center gap-10 sm:flex-col sm:gap-4">
        <div class="absolute bottom-0 left-0 right-0 top-0 z-10"></div>
        <div class="flex w-fit flex-col items-center">
            <span class="text-xl"><span class="text-4xl">@_averageRating</span> Trên 5</span>
            <MudRating SelectedValue="@((int)_averageRating)" MaxValue="5" Size="Size.Large" />
        </div>
        <div class="flex flex-wrap gap-6 sm:gap-2">
            <div class="rounded-lg border border-solid border-yellow-500 px-4 py-2 text-base text-yellow-500">5 sao (@_reviews.Count(x => x.Overall == 5))</div>
            <div class="rounded-lg border border-solid border-yellow-500 px-4 py-2 text-base text-yellow-500">4 sao (@_reviews.Count(x => x.Overall == 4))</div>
            <div class="rounded-lg border border-solid border-yellow-500 px-4 py-2 text-base text-yellow-500">3 sao (@_reviews.Count(x => x.Overall == 3))</div>
            <div class="rounded-lg border border-solid border-yellow-500 px-4 py-2 text-base text-yellow-500">2 sao (@_reviews.Count(x => x.Overall == 2))</div>
            <div class="rounded-lg border border-solid border-yellow-500 px-4 py-2 text-base text-yellow-500">1 sao (@_reviews.Count(x => x.Overall == 1))</div>
        </div>
    </div>


    @if(_reviews.Any())
    {
        <MudDivider Class="my-6"/>

        <div class="mt-4 flex max-h-[1000px] w-full flex-col gap-6 overflow-y-auto">
           @foreach(var review in _reviews)
           {
                <div class="flex w-full gap-4">
                    <div>

                    </div>
                    <div class="flex-1">
                        @if(string.IsNullOrEmpty(review.CustomerName))
                        {
                            <p>Khách mua hàng</p>
                        } else
                        {
                            <p>@(review.Status == 1 ? review.CustomerName : MaskString(review.CustomerName))</p>
                        }
                        <MudRating SelectedValue="@review.Overall" MaxValue="5" Size="Size.Small" />
                        <h4 class="text-base font-medium">@review.Title</h4>
                        <p class="whitespace-pre-wrap text-sm">@review.Content</p>
                    </div>
                </div>
           }
        </div>
    } else {
        <div class="mt-4">

        </div>
        <p class="text-center text-base font-medium text-gray-500">Chưa có đánh giá nào!</p>
    }
</section>

<section class="mx-auto mb-6 max-w-screen-xl pt-10">
    <img src="/Assets/Images/user-home-banner-2.jpg" alt="banner" />
</section>

@code {
    [CascadingParameter(Name = Constant.CascadingNameParams.UserInfo)]
    public GetMeResponseDTO UserInfo { get; set; } = new GetMeResponseDTO();

    [Parameter] public int id { get; set; }

    private DAL.Repository.ProductRepository.ProductDetailDto? _product = new DAL.Repository.ProductRepository.ProductDetailDto();
    private DAL.Repository.ProductRepository.ProductVariantDto? _foundVariant;

    private List<string> _images = [];
    private List<DAL.Models.Review> _reviews = [];
    CultureInfo vietnameseCulture = new CultureInfo("vi-VN");

    private double _averageRating = 0;
    private string _token = "";
    private int _selectedColorId = 0;
    private string _selectedColorName = "";
    private int _selectedSizeId= 0;
    private int _quantity = 1;
    private decimal _currentPrice = 0;
    private string _quantityShow = "0";
    private bool _isInWishlist = false;
    private bool _isShowButton = true;

    private bool _disableAction => _foundVariant == null || _foundVariant.StockQuantity < 1;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if(firstRender)
        {
            _token = await localStorage.GetItemAsStringAsync(Constant.TokenNameLocalStorage);
            if (string.IsNullOrEmpty(_token)) _isShowButton = false;

            await LoadData();
            StateHasChanged();
        }
    }

    private async Task LoadData()
    {
        var res = await _productService.GetDetail(id);
        if (res.IsSuccess && res.Data != null)
        {
            _product = res.Data;
            _images = _product.ImageUrls;
            if (res.Data.Variants.Any())
            {
                foreach(var item in res.Data.Variants)
                {
                    _images.AddRange(item.VariantImageUrls.ToList());
                }

                _quantityShow = res.Data.Variants.Sum(pv => pv.StockQuantity).ToString();
            }
            _currentPrice = _product.BasePrice;
            var _resReview = await _reviewService.GetByProductId(_product.Id);
            if (_resReview.IsSuccess && _resReview.Data.Count > 0)
            {
                _reviews = _resReview.Data;
                var reviewCount = _reviews.Count();
                var sumOverall = _reviews.Sum(x => x.Overall);
                _averageRating = Math.Truncate((double)sumOverall / reviewCount * 100) / 100;
            }

            if (!string.IsNullOrEmpty(_token) && UserInfo != null && UserInfo.Id > 0)
            {
                await CheckWishlistStatus();
            }
        } else
        {
            _snackbar.Add(res.ErrorMessage, Severity.Error);
            navigation.NavigateTo(RouterConst.User.Home);
        }
    }

    private void SelectColor(DAL.Repository.ProductRepository.ColorDto color)
    {
        if (_selectedColorId != color.Id) _selectedSizeId = 0;
        _selectedColorName = color.Name;
        _selectedColorId = color.Id;
        _images.Clear();

        var obj = _product?.Variants.FirstOrDefault(v =>
                                v.ColorId == _selectedColorId);
        if (obj != null)
        {
            _quantityShow = obj.StockQuantity.ToString();
        }

        if(_product.Variants != null && _product.Variants.Any())                                                                                                                                    
        {
            var detail = _product.Variants.Where(pv => pv.ColorId == color.Id).FirstOrDefault();

            if(detail != null && detail.VariantImageUrls != null && detail.VariantImageUrls.Any())
            {
                _images.AddRange(detail.VariantImageUrls);
            } else
            {
                if(_product.ImageUrls != null && _product.ImageUrls.Any())
                {
                    _images.AddRange(_product.ImageUrls);
                } else
                {
                    _images.Add(Constant.DefaultImages);
                }
            }
        } else
        {
            if (_product.ImageUrls != null && _product.ImageUrls.Any())
            {
                _images.AddRange(_product.ImageUrls);
            }
            else
            {
                _images.Add(Constant.DefaultImages);
            }
        }

        StateHasChanged();
    }

    private void SelectSize(int sizeId)
    {
        _selectedSizeId = sizeId;
        FindVariant();
    }

    private void FindVariant()
    {
        if (_selectedColorId == 0 || _selectedSizeId == 0) return;

        _foundVariant = _product.Variants.FirstOrDefault(v => 
            v.ColorId == _selectedColorId &&
            v.SizeId == _selectedSizeId);

        if (_foundVariant != null)
        {
            if (_foundVariant?.Price != null)
            {
                _currentPrice = _foundVariant.Price;
            }

            if (_foundVariant?.StockQuantity < _quantity) _quantity = 1;

            _quantityShow = _foundVariant.StockQuantity.ToString();
        }
    }

    private bool IsSizeAvailableForColor(int sizeId)
    {
        if (sizeId == 0 || _selectedColorId == 0) return true;

        var result = _product.Variants.Any(v => 
            v.ColorId == _selectedColorId && 
            v.SizeId == sizeId &&
            v.StockQuantity > 0);

        return !result;
    }

    private string GetColorClass(string colorName)
    {
        return _selectedColorName == colorName ? "ring-2 ring-offset-2 ring-blue-500" : "border-gray-300";
    }

    private string GetSizeClass(int sizeId)
    {
        if (_selectedSizeId == sizeId) return "bg-black text-white border-black";
        return "";
    }

    private bool IsOutOfStock()
    {
        if (_product == null) return false;
        if (_foundVariant != null) return _foundVariant.StockQuantity <= 0;
        if (_product.Variants != null && _product.Variants.Any())
        {
            return !_product.Variants.Any(v => v.StockQuantity > 0);
        }
        return false;
    }

    private void IncreaseQuantity()
    {
        int maxStock = _foundVariant?.StockQuantity ?? 99;
        if (_quantity < maxStock) _quantity++;
        else _snackbar.Add($"Chỉ còn {maxStock} sản phẩm", Severity.Warning);
    }

    private void DecreaseQuantity()
    {
        if (_quantity <= 1) return;

        _quantity--;
    }

    private async Task AddToCart()
    {
        if (_foundVariant == null)
        {
            _snackbar.Add("Vui lòng chọn Màu sắc và Kích thước", Severity.Info);
            return;
        }

        var item = new AddCartModel()
        {
            VariantId = _foundVariant.Id,
            Quantity = _quantity
        };

        if (string.IsNullOrEmpty(_token))
        {
            var cartCurrent = await localStorage.GetItemAsStringAsync(Constant.CartItemKey);
            var items = new List<AddCartModel>();
            items.Add(item);
            if (string.IsNullOrEmpty(cartCurrent))
            {
                var cartStringJson = JsonSerializer.Serialize(items);
                await localStorage.SetItemAsStringAsync(Constant.CartItemKey, cartStringJson);
            } else
            {
                var cartCurrentJson = JsonSerializer.Deserialize<List<AddCartModel>>(cartCurrent);

                if (cartCurrentJson != null)
                {
                    var hasProductCurrent = cartCurrentJson.FirstOrDefault(x => x.VariantId == _foundVariant.Id);

                    if (hasProductCurrent != null) {
                        var currentQuantity = hasProductCurrent.Quantity;
                        if ((currentQuantity + _quantity) > _foundVariant.StockQuantity)
                        {
                            _snackbar.Add("Số lượng đạt tối đa", Severity.Error);
                            return;
                        }
                        var newQuantity = currentQuantity + _quantity;
                        hasProductCurrent.Quantity = newQuantity;
                        await localStorage.SetItemAsStringAsync(Constant.CartItemKey, JsonSerializer.Serialize(cartCurrentJson));
                    }
                    else
                    {
                        cartCurrentJson.Add(item);
                        await localStorage.SetItemAsStringAsync(Constant.CartItemKey, JsonSerializer.Serialize(cartCurrentJson));
                    }
                } 
                else 
                {
                    await localStorage.SetItemAsStringAsync(Constant.CartItemKey, JsonSerializer.Serialize(items));
                }
            }

            _snackbar.Add("Thêm vào giỏ hàng thành công", Severity.Success);
            await _cartStateService.LoadCartDetailsAsync();
        } else
        {
            var result = await _cartService.AddToCart(item, _token);

            if (result.IsSuccess)
            {
                _snackbar.Add("Thêm vào giỏ hàng thành công", Severity.Success);
                await _cartStateService.LoadCartDetailsAsync();
            } else
            {
                var mess = string.IsNullOrEmpty(result.ErrorMessage) ? "Có lỗi xảy ra. Vui lòng thử lại" : result.ErrorMessage;
                _snackbar.Add(mess, Severity.Error);
            }
        }
    }

    private async Task ToCheckout()
    {

        if (_foundVariant == null)
        {
            _snackbar.Add("Vui lòng chọn Màu sắc và Kích thước", Severity.Info);
            return;
        }
        var item = new AddCartModel()
            {
                VariantId = _foundVariant.Id,
                Quantity = _quantity
            };

        if (string.IsNullOrEmpty(_token))
        {
            var cartCurrent = await localStorage.GetItemAsStringAsync(Constant.CartItemKey);
            var items = new List<AddCartModel>();
            items.Add(item);
            if (string.IsNullOrEmpty(cartCurrent))
            {
                var cartStringJson = JsonSerializer.Serialize(items);
                await localStorage.SetItemAsStringAsync(Constant.CartItemKey, cartStringJson);
            }
            else
            {
                var cartCurrentJson = JsonSerializer.Deserialize<List<AddCartModel>>(cartCurrent);

                if (cartCurrentJson != null)
                {
                    var hasProductCurrent = cartCurrentJson.FirstOrDefault(x => x.VariantId == _foundVariant.Id);

                    if (hasProductCurrent != null)
                    {
                        if ((hasProductCurrent.Quantity += _quantity) > _foundVariant.StockQuantity)
                        {
                            _snackbar.Add("Số lượng đạt tối đa", Severity.Error);
                            return;
                        }
                        hasProductCurrent.Quantity += _quantity;
                        await localStorage.SetItemAsStringAsync(Constant.CartItemKey, JsonSerializer.Serialize(cartCurrentJson));
                    }
                    else
                    {
                        cartCurrentJson.Add(item);
                        await localStorage.SetItemAsStringAsync(Constant.CartItemKey, JsonSerializer.Serialize(cartCurrentJson));
                    }
                }
                else
                {
                    await localStorage.SetItemAsStringAsync(Constant.CartItemKey, JsonSerializer.Serialize(items));
                }
            }

            await _cartStateService.LoadCartDetailsAsync();
            navigation.NavigateTo(RouterConst.User.GusestCheckoutDetail);
        } else
        {


            var result = await _cartService.AddToCart(item, _token);

            if (result.IsSuccess)
            {
                await _cartStateService.LoadCartDetailsAsync();
                navigation.NavigateTo(RouterConst.User.CheckoutDetail);
            }
            else
            {
                var mess = string.IsNullOrEmpty(result.ErrorMessage) ? "Có lỗi xảy ra. Vui lòng thử lại" : result.ErrorMessage;
                _snackbar.Add(mess, Severity.Error);
            }
        }
    }

    public static string MaskString(string input)
    {
        if (string.IsNullOrEmpty(input) || input.Length <= 2)
        {
            return input;
        }

        char firstChar = input[0];
        char lastChar = input[input.Length - 1];

        string middleMask = new string('*', input.Length - 2);

        return $"{firstChar}{middleMask}{lastChar}";
    }

    private async Task CheckWishlistStatus()
    {
        if (string.IsNullOrEmpty(_token) || UserInfo == null || UserInfo.Id <= 0 || _product == null) return;

        var result = await _wishlistService.GetByCustomerAndProduct(UserInfo.Id, _product.Id);
        _isInWishlist = result.IsSuccess && result.Data != null;
        StateHasChanged();
    }

    public async Task AddWishlist()
    {
        if (string.IsNullOrEmpty(_token))
        {
            _snackbar.Add("Vui lòng đăng nhập để sử dụng tính năng yêu thích", Severity.Info);
            return;
        }

        if (UserInfo == null || UserInfo.Id <= 0)
        {
            _snackbar.Add("Có lỗi xảy ra. Vui lòng thử lại", Severity.Error);
            return;
        }

        if (_product == null || _product.Id <= 0)
        {
            _snackbar.Add("Có lỗi xảy ra. Vui lòng thử lại", Severity.Error);
            return;
        }

        var result = await _wishlistService.ToggleWishlist(UserInfo.Id, _product.Id, _token);

        if (result.IsSuccess)
        {
            _isInWishlist = result.Data;
            StateHasChanged();
        }
    }
}